; ============================================================================
; PyMethods.rgr — the methods of the built-in types: str, list, tuple, dict,
; set, file objects, int and float, and str.format.
;
; `attrOf` answers a bound method for a name the type has (so hasattr and
; getattr tell the truth); `callMethod` runs it.
; ============================================================================

Import "PyOps.rgr"
Import "PyValue.rgr"
Import "PyFormat.rgr"
Import "PyInterp.rgr"

class PyMethods {
    def ip:PyInterp
    def table:[string:boolean]

    Constructor (interp:PyInterp) {
        ip = interp
        this.addNames("str" "join split rsplit splitlines strip lstrip rstrip replace upper lower title capitalize swapcase casefold startswith endswith find rfind index rindex count format format_map zfill ljust rjust center isdigit isnumeric isdecimal isalpha isalnum isspace isupper islower istitle isidentifier isascii isprintable partition rpartition encode expandtabs removeprefix removesuffix translate __len__ __contains__ __getitem__ __add__ __mul__ __eq__ __lt__ __hash__ __iter__ __str__ __repr__")
        this.addNames("list" "__init__ append extend insert pop remove index count sort reverse copy clear __len__ __getitem__ __setitem__ __contains__ __iter__ __add__ __eq__ __repr__")
        this.addNames("deque" "append appendleft extend extendleft pop popleft remove index count reverse rotate copy clear __len__")
        this.addNames("tuple" "index count __len__ __getitem__ __contains__ __iter__ __add__ __eq__ __hash__ __repr__")
        this.addNames("dict" "__init__ move_to_end get keys values items pop popitem setdefault update copy clear __len__ __getitem__ __setitem__ __contains__ __iter__ __eq__ __repr__ most_common elements total subtract")
        this.addNames("set" "__init__ add remove discard pop clear copy update union intersection difference symmetric_difference issubset issuperset isdisjoint intersection_update difference_update symmetric_difference_update __len__ __contains__ __iter__")
        this.addNames("frozenset" "copy union intersection difference symmetric_difference issubset issuperset isdisjoint __len__ __contains__ __iter__ __hash__")
        this.addNames("file" "write writelines read readline readlines close flush seek tell __enter__ __exit__ __iter__ __next__ readable writable")
        this.addNames("int" "bit_length bit_count as_integer_ratio conjugate is_integer __index__ __int__ __float__ __abs__ __add__ __sub__ __mul__ __eq__ __lt__ __hash__ to_bytes __repr__ __str__ __format__ __bool__ __neg__")
        this.addNames("float" "is_integer conjugate hex __int__ __float__ __abs__ __add__ __sub__ __mul__ __eq__ __lt__ __hash__ as_integer_ratio __repr__ __str__ __format__")
        this.addNames("iter" "__next__ __iter__")
        this.addNames("complex" "conjugate __abs__ __add__ __sub__ __mul__ __truediv__ __pow__ __eq__ __hash__ __neg__ __pos__ __bool__ __complex__ __radd__ __rsub__ __rmul__ __rtruediv__ __rpow__ __repr__ __str__ __getnewargs__ __format__")
        this.addNames("generator" "__next__ __iter__ send throw close")
        this.addNames("range" "index count __len__ __iter__ __contains__")
    }

    fn addNames:void (kind:string names:string) {
        def ns:[string] (strsplit names " ")
        for ns n:string i {
            set table (kind + "." + n) true
        }
    }

    fn kindOf:string (v:PyVal) {
        switch v.t {
            case PyT.Str {
                return "str"
            }
            case PyT.List {
                if (v.mode == "deque") {
                    return "deque"
                }
                return "list"
            }
            case PyT.Tuple {
                return "tuple"
            }
            case PyT.Dict {
                return "dict"
            }
            case PyT.Set {
                if (v.mode == "frozen") {
                    return "frozenset"
                }
                return "set"
            }
            case PyT.File {
                return "file"
            }
            case PyT.Int {
                return "int"
            }
            case PyT.Bool {
                return "int"
            }
            case PyT.Float {
                return "float"
            }
            case PyT.Complex {
                return "complex"
            }
            case PyT.Iter {
                return "iter"
            }
            case PyT.Gen {
                return "generator"
            }
            case PyT.Range {
                return "range"
            }
        }
        return ""
    }

    fn attrOf@(optional):PyVal (obj:PyVal name:string) {
        def none@(optional):PyVal
        def kind:string (this.kindOf(obj))
        if ((strlen kind) == 0) {
            return none
        }
        if (has table (kind + "." + name)) {
            def optr95@(optional):PyVal (ip.mkBuiltinMethod(obj name))
            return optr95
        }
        ; data attributes
        if ((obj.t == PyT.Int) || (obj.t == PyT.Bool)) {
            if ((name == "real") || (name == "numerator")) {
                def optr100@(optional):PyVal (ip.mkInt(obj.i))
                return optr100
            }
            if (name == "imag") {
                def optr103@(optional):PyVal (ip.mkInt(0))
                return optr103
            }
            if (name == "denominator") {
                def optr106@(optional):PyVal (ip.mkInt(1))
                return optr106
            }
        }
        if (obj.t == PyT.Float) {
            if (name == "real") {
                def optr111@(optional):PyVal obj
                return optr111
            }
            if (name == "imag") {
                def optr114@(optional):PyVal (ip.mkFloat(0.0))
                return optr114
            }
        }
        if (obj.t == PyT.File) {
            if (name == "name") {
                def optr119@(optional):PyVal (ip.mkStr(obj.s))
                return optr119
            }
            if (name == "mode") {
                def optr122@(optional):PyVal (ip.mkStr(obj.mode))
                return optr122
            }
            if (name == "closed") {
                def optr125@(optional):PyVal (ip.mkBool(obj.closed))
                return optr125
            }
        }
        if (obj.t == PyT.Complex) {
            if (name == "real") {
                def optrc1@(optional):PyVal (ip.mkFloat(obj.d))
                return optrc1
            }
            if (name == "imag") {
                def optrc2@(optional):PyVal (ip.mkFloat(obj.d2))
                return optrc2
            }
        }
        if (obj.t == PyT.Gen) {
            def g:PyGen (unwrap obj.gen)
            if (name == "gi_running") {
                def optrg1@(optional):PyVal (ip.mkBool(g.running))
                return optrg1
            }
            if (name == "__name__") {
                def optrg2@(optional):PyVal (ip.mkStr(g.name))
                return optrg2
            }
            if (name == "__qualname__") {
                def optrg3@(optional):PyVal (ip.mkStr(g.name))
                return optrg3
            }
            if (name == "gi_frame") {
                if g.done {
                    def optrg4@(optional):PyVal ip.NONE
                    return optrg4
                }
                def fo (new PyVal(PyT.Inst))
                fo.putAttr("f_lineno" (ip.mkInt(g.line)))
                fo.putAttr("f_locals" ip.NONE)
                def optrg5@(optional):PyVal fo
                return optrg5
            }
            if (name == "gi_yieldfrom") {
                def optrg6@(optional):PyVal ip.NONE
                return optrg6
            }
        }
        if (obj.t == PyT.Range) {
            if (name == "start") {
                def optr130@(optional):PyVal (ip.mkInt(obj.i))
                return optr130
            }
            if (name == "stop") {
                def optr133@(optional):PyVal (ip.mkInt(obj.i2))
                return optr133
            }
            if (name == "step") {
                def optr136@(optional):PyVal (ip.mkInt(obj.i3))
                return optr136
            }
        }
        if (obj.t == PyT.Slice) {
            if (name == "start") {
                def optr141@(optional):PyVal (itemAt obj.items 0)
                return optr141
            }
            if (name == "stop") {
                def optr144@(optional):PyVal (itemAt obj.items 1)
                return optr144
            }
            if (name == "step") {
                def optr147@(optional):PyVal (itemAt obj.items 2)
                return optr147
            }
        }
        if ((obj.t == PyT.Dict) && (name == "default_factory")) {
            return (get obj.attrs "__missing__")
        }
        if ((obj.t == PyT.List) && (obj.mode == "deque") && (name == "maxlen")) {
            if (obj.i3 > 0) {
                def optr155@(optional):PyVal (ip.mkInt((obj.i3 - 1)))
                return optr155
            }
            def optr157@(optional):PyVal ip.NONE
            return optr157
        }
        return none
    }

    ; str.join and the like, read off the type
    fn typeAttr@(optional):PyVal (tv:PyVal name:string) {
        def none@(optional):PyVal
        def kind:string tv.s
        if ((name == "__new__") && ((kind == "int") || (kind == "float") || (kind == "str") || (kind == "tuple") || (kind == "frozenset") || (kind == "complex") || (kind == "list") || (kind == "dict") || (kind == "set"))) {
            def optrnw@(optional):PyVal (ip.mkBuiltinMethod(tv "type.__new__"))
            return optrnw
        }
        if ((name == "__new__") && (kind == "type")) {
            def optrtn@(optional):PyVal (ip.mkBuiltinMethod(tv "metatype.__new__"))
            return optrtn
        }
        if ((kind == "type") && ((name == "__setattr__") || (name == "__delattr__") || (name == "__getattribute__"))) {
            def optrts@(optional):PyVal (ip.mkBuiltinMethod((unwrap (get ip.builtins "object")) ("object." + name)))
            return optrts
        }
        if ((kind == "object") && ((name == "__setattr__") || (name == "__delattr__") || (name == "__getattribute__") || (name == "__repr__") || (name == "__str__") || (name == "__eq__") || (name == "__ne__") || (name == "__hash__") || (name == "__format__") || (name == "__dir__") || (name == "__reduce_ex__") || (name == "__reduce__") || (name == "__sizeof__") || (name == "__lt__") || (name == "__le__") || (name == "__gt__") || (name == "__ge__") || (name == "__getstate__"))) {
            def optrob@(optional):PyVal (ip.mkBuiltinMethod(tv ("object." + name)))
            return optrob
        }
        if ((name == "__new__") && (kind == "object")) {
            def optron@(optional):PyVal (ip.mkBuiltinMethod(tv "object.__new__"))
            return optron
        }
        if ((name == "__init__") && (kind == "object")) {
            return (get ip.builtins "__object_init__")
        }
        if ((name == "__init__") && ((kind == "list") || (kind == "dict") || (kind == "set"))) {
            def optrin@(optional):PyVal (ip.mkBuiltinMethod(tv "unbound:__init__"))
            return optrin
        }
        if ((kind == "dict") && (name == "fromkeys")) {
            def optr167@(optional):PyVal (ip.mkBuiltinMethod(tv "dict.fromkeys"))
            return optr167
        }
        if ((kind == "str") && (name == "maketrans")) {
            def optr170@(optional):PyVal (ip.mkBuiltinMethod(tv "str.maketrans"))
            return optr170
        }
        if ((kind == "int") && (name == "from_bytes")) {
            return none
        }
        if (has table (kind + "." + name)) {
            def optr176@(optional):PyVal (ip.mkBuiltinMethod(tv ("unbound:" + name)))
            return optr176
        }
        return none
    }

    fn arg:PyVal (args:[PyVal] i:int) {
        if (i < (array_length args)) {
            return (itemAt args i)
        }
        return ip.NONE
    }

    fn need:void (name:string args:[PyVal] lo:int hi:int) {
        ip.bi.need(name args lo hi)
    }

    fn strArg:string (v:PyVal what:string) {
        if (v.t != PyT.Str) {
            ip.raise("TypeError" (what + " must be str, not " + (ip.typeName(v))))
        }
        return v.s
    }

    fn callMethod:PyVal (self:PyVal name:string args:[PyVal] kn:[string] kv:[PyVal]) {
        if (ip.isDataSub(self)) {
            ; a subclass's value seen as the built-in type
            def saved@(optional):PyVal ip.rawSelf
            ip.rawSelf = self
            def r:PyVal ip.NONE
            def failed:boolean false
            def err:PyVal ip.NONE
            try {
                r = (this.callMethodPlain(self name args kn kv))
            } {
                failed = true
                err = (ip.takeException((error_msg)))
            }
            ip.rawSelf = saved
            if failed {
                ip.reraise(err)
            }
            return r
        }
        return (this.callMethodPlain(self name args kn kv))
    }

    fn callMethodPlain:PyVal (self:PyVal name:string args:[PyVal] kn:[string] kv:[PyVal]) {
        if (name == "__init__") {
            return (this.initMethod(self args kn kv))
        }
        if (name == "__noop__") {
            if ((array_length kn) > 0) {
                ip.raise("TypeError" ("object.__init_subclass__() takes no keyword arguments"))
            }
            return ip.NONE
        }
        if ((startsWith name "object.__") && (name != "object.__new__")) {
            ; object's own methods, as object.f(self, …) or super().f(…)
            def target:PyVal self
            def rest:[PyVal] args
            if ((self.t == PyT.Builtin) && (self.s == "object")) {
                if ((array_length args) == 0) {
                    ip.raise("TypeError" ("descriptor '" + (substring name 7 (strlen name)) + "' of 'object' object needs an argument"))
                }
                target = (itemAt args 0)
                def r2:[PyVal]
                def ri:int 1
                while (ri < (array_length args)) {
                    push r2 (itemAt args ri)
                    ri = ri + 1
                }
                rest = r2
            }
            def on:string (substring name 7 (strlen name))
            if (on == "__setattr__") {
                ip.objectSetAttr(target (ip.toStr((this.arg(rest 0)))) (this.arg(rest 1)))
                return ip.NONE
            }
            if (on == "__delattr__") {
                ip.objectDelAttr(target (ip.toStr((this.arg(rest 0)))))
                return ip.NONE
            }
            if (on == "__getattribute__") {
                def gn:string (ip.toStr((this.arg(rest 0))))
                def gv@(optional):PyVal (ip.getAttrNoHook(target gn))
                if (null? gv) {
                    ip.raise("AttributeError" ("'" + (ip.typeName(target)) + "' object has no attribute '" + gn + "'"))
                }
                return (unwrap gv)
            }
            if ((on == "__repr__") || (on == "__str__")) {
                if ((on == "__str__") && (target.t == PyT.Inst)) {
                    return (ip.mkStr((ip.toRepr(target))))
                }
                return (ip.mkStr((ip.defaultRepr(target))))
            }
            if (on == "__eq__") {
                if (ip.same(target (this.arg(rest 0)))) {
                    return ip.TRUE
                }
                return ip.NOTIMPL
            }
            if (on == "__ne__") {
                def eqr:PyVal (ip.binop("==" target (this.arg(rest 0))))
                return (ip.mkBool(((ip.truthy(eqr)) == false)))
            }
            if (on == "__hash__") {
                return (ip.mkInt((PyFormat.floorDivInt((ip.idOf(target)) 16))))
            }
            if (on == "__format__") {
                def fs:string (ip.toStr((this.arg(rest 0))))
                if ((strlen fs) > 0) {
                    ip.raise("TypeError" ("unsupported format string passed to " + (ip.typeName(target)) + ".__format__"))
                }
                return (ip.mkStr((ip.toStr(target))))
            }
            if (on == "__dir__") {
                def dkn:[string]
                def dkv:[PyVal]
                return (ip.bi.call("dir" ([] _:PyVal (target)) dkn dkv))
            }
            if (on == "__sizeof__") {
                return (ip.mkInt(16))
            }
            if (on == "__getstate__") {
                if ((target.t == PyT.Inst) && ((array_length (target.attrKeys())) > 0)) {
                    return (ip.getAttr(target "__dict__"))
                }
                return ip.NONE
            }
            if ((on == "__lt__") || (on == "__le__") || (on == "__gt__") || (on == "__ge__")) {
                return ip.NOTIMPL
            }
            ip.raise("TypeError" ("cannot pickle '" + (ip.typeName(target)) + "' object"))
        }
        if (name == "metatype.__new__") {
            ; type.__new__(meta, name, bases, ns, **kw)
            if ((array_length args) == 0) {
                ip.raise("TypeError" "type.__new__(): not enough arguments")
            }
            def mrest:[PyVal]
            def mi:int 1
            while (mi < (array_length args)) {
                push mrest (itemAt args mi)
                mi = mi + 1
            }
            return (ip.typeNew((itemAt args 0) mrest kn kv))
        }
        if (name == "type.__call__") {
            return (ip.instantiate(self args kn kv))
        }
        if (name == "object.__new__") {
            if ((array_length args) == 0) {
                ip.raise("TypeError" "object.__new__(): not enough arguments")
            }
            def ocls:PyVal (itemAt args 0)
            if (ocls.t != PyT.Class) {
                ip.raise("TypeError" ("object.__new__(X): X is not a type object (" + (ip.typeName(ocls)) + ")"))
            }
            if ((strlen ocls.bt) > 0) {
                def okn:[string]
                def okv:[PyVal]
                def onone:[PyVal]
                return (ip.makeDataSub(ocls onone okn okv))
            }
            def oobj (new PyVal(PyT.Inst))
            oobj.cls = ocls
            if ocls.isExc {
                def orest:[PyVal]
                def oi:int 1
                while (oi < (array_length args)) {
                    push orest (itemAt args oi)
                    oi = oi + 1
                }
                oobj.putAttr("args" (ip.mkTuple(orest)))
            }
            return oobj
        }
        if (name == "type.__new__") {
            ; int.__new__(cls, …): the built-in value made for a subclass
            if ((array_length args) == 0) {
                ip.raise("TypeError" (self.s + ".__new__(): not enough arguments"))
            }
            def ncls:PyVal (itemAt args 0)
            def rest0:[PyVal]
            def ni:int 1
            while (ni < (array_length args)) {
                push rest0 (itemAt args ni)
                ni = ni + 1
            }
            def made:PyVal (ip.bi.call(self.s rest0 kn kv))
            if ((ncls.t == PyT.Builtin) && (ncls.s == self.s)) {
                return made
            }
            if ((ncls.t != PyT.Class) || (ncls.bt != self.s)) {
                ip.raise("TypeError" (self.s + ".__new__(" + (ip.typeName(ncls)) + "): " + (ip.typeName(ncls)) + " is not a subtype of " + self.s))
            }
            def nv:PyVal (ip.cloneVal(made))
            nv.cls = ncls
            return nv
        }
        if (name == "__counter_key__") {
            def ck:PyVal (itemAt args 0)
            return (itemAt ck.items 1)
        }
        if (startsWith name "nt.") {
            return (ip.mods.ntMethod(self name args kn kv))
        }
        if (name == "lru.cache_clear") {
            self.putAttr("__cache__" (ip.mkDict()))
            return ip.NONE
        }
        if (startsWith name "unbound:") {
            def m:string (substring name 8 (strlen name))
            if ((array_length args) == 0) {
                ip.raise("TypeError" ("unbound method " + self.s + "." + m + "() needs an argument"))
            }
            def rest:[PyVal]
            def i:int 1
            while (i < (array_length args)) {
                push rest (itemAt args i)
                i = i + 1
            }
            def ut:PyVal (itemAt args 0)
            if ((startsWith m "__") && (ip.isDataSub(ut))) {
                ; int.__repr__(member) and the like: the built-in type's own method
                def saved@(optional):PyVal ip.rawSelf
                ip.rawSelf = ut
                def ur:PyVal (this.callMethod(ut m rest kn kv))
                ip.rawSelf = saved
                return ur
            }
            return (this.callMethod(ut m rest kn kv))
        }
        if (name == "dict.fromkeys") {
            def d:PyVal (ip.mkDict())
            def v:PyVal (this.arg(args 1))
            def ks:[PyVal] (ip.iterValues((this.arg(args 0))))
            for ks k:PyVal ki {
                ip.dictSet(d k v)
            }
            return d
        }
        if (name == "str.maketrans") {
            return (this.makeTrans(args))
        }
        if (name == "prop.__get__") {
            def nk:[string]
            def nv:[PyVal]
            def pin:PyVal (this.arg(args 0))
            if ((pin.t == PyT.None) || (null? self.wrapped)) {
                if (pin.t == PyT.None) {
                    return self
                }
                ip.raise("AttributeError" "property has no getter")
            }
            return (ip.callValue((unwrap self.wrapped) ([] _:PyVal (pin)) nk nv))
        }
        if (name == "prop.__set__") {
            def nk:[string]
            def nv:[PyVal]
            if (null? self.setter) {
                ip.raise("AttributeError" "property has no setter")
            }
            return (ip.callValue((unwrap self.setter) ([] _:PyVal ((this.arg(args 0)) (this.arg(args 1)))) nk nv))
        }
        if (name == "prop.__delete__") {
            def nk:[string]
            def nv:[PyVal]
            def pdel@(optional):PyVal (get self.attrs "__deleter__")
            if (null? pdel) {
                ip.raise("AttributeError" "property has no deleter")
            }
            return (ip.callValue((unwrap pdel) ([] _:PyVal ((this.arg(args 0)))) nk nv))
        }
        if (startsWith name "property.") {
            def p (new PyVal(PyT.Prop))
            p.wrapped = self.wrapped
            p.setter = self.setter
            for (self.attrKeys()) pk:string pki {
                p.putAttr(pk (unwrap (get self.attrs pk)))
            }
            if (name == "property.deleter") {
                p.putAttr("__deleter__" (this.arg(args 0)))
            }
            if (name == "property.setter") {
                p.setter = (this.arg(args 0))
            }
            if (name == "property.getter") {
                p.wrapped = (this.arg(args 0))
            }
            return p
        }
        if (name == "__str__") {
            return (ip.mkStr((ip.toStr(self))))
        }
        if (name == "__repr__") {
            return (ip.mkStr((ip.toRepr(self))))
        }
        if (name == "__len__") {
            return (ip.mkInt((ip.length(self))))
        }
        if (name == "__contains__") {
            return (ip.mkBool((ip.contains(self (this.arg(args 0))))))
        }
        if (name == "__getitem__") {
            return (ip.getItem(self (this.arg(args 0))))
        }
        if (name == "__setitem__") {
            ip.setItem(self (this.arg(args 0)) (this.arg(args 1)))
            return ip.NONE
        }
        if (name == "__iter__") {
            if ((self.t == PyT.Iter) || (self.t == PyT.File) || (self.t == PyT.Gen)) {
                return self
            }
            return (ip.mkIter((ip.iterValues(self))))
        }
        if (name == "__hash__") {
            return (ip.bi.call("hash" ([] _:PyVal (self)) kn kv))
        }
        if (name == "__eq__") {
            return (ip.mkBool((ip.eq(self (this.arg(args 0))))))
        }
        if (name == "__lt__") {
            return (ip.mkBool((ip.less(self (this.arg(args 0))))))
        }
        if (name == "__add__") {
            return (ip.binop("+" self (this.arg(args 0))))
        }
        if (name == "__sub__") {
            return (ip.binop("-" self (this.arg(args 0))))
        }
        if (name == "__mul__") {
            return (ip.binop("*" self (this.arg(args 0))))
        }
        switch self.t {
            case PyT.Str {
                return (this.strMethod(self name args kn kv))
            }
            case PyT.List {
                return (this.listMethod(self name args kn kv))
            }
            case PyT.Tuple {
                return (this.seqCommon(self name args))
            }
            case PyT.Dict {
                return (this.dictMethod(self name args kn kv))
            }
            case PyT.Set {
                return (this.setMethod(self name args))
            }
            case PyT.File {
                return (this.fileMethod(self name args kn kv))
            }
            case PyT.Gen {
                return (this.genMethod(self name args))
            }
            case PyT.Complex {
                return (this.complexMethod(self name args))
            }
            case PyT.Iter {
                if ((name == "__next__") && ((strlen self.mode) > 0)) {
                    def lnx@(optional):PyVal (ip.nextOpt(self))
