    fn gcd:int (a0:int b0:int) {
        def a:int a0
        def b:int b0
        while (b != 0) {
            def t:int (a % b)
            a = b
            b = t
        }
        return a
    }

    ; Shewchuk's exact summation, as math.fsum
    fn fsumD:double (xs:[double]) {
        def parts:[double]
        for xs x0:double i {
            def x:double x0
            def keep:[double]
            for parts y0:double j {
                def y:double y0
                def ax:double x
                if (ax < 0.0) {
                    ax = (0.0 - ax)
                }
                def ay:double y
                if (ay < 0.0) {
                    ay = (0.0 - ay)
                }
                if (ax < ay) {
                    def t:double x
                    x = y
                    y = t
                }
                def hi:double (x + y)
                def lo:double (y - (hi - x))
                if (lo != 0.0) {
                    push keep lo
                }
                x = hi
            }
            push keep x
            parts = keep
        }
        def n:int (array_length parts)
        if (n == 0) {
            return 0.0
        }
        n = n - 1
        def hi2:double (itemAt parts n)
        def lo2:double 0.0
        while (n > 0) {
            def x2:double hi2
            n = n - 1
            def y2:double (itemAt parts n)
            hi2 = (x2 + y2)
            def yr:double (hi2 - x2)
            lo2 = (y2 - yr)
            if (lo2 != 0.0) {
                break
            }
        }
        if (n > 0) {
            def pn:double (itemAt parts (n - 1))
            if (((lo2 < 0.0) && (pn < 0.0)) || ((lo2 > 0.0) && (pn > 0.0))) {
                def y3:double (lo2 * 2.0)
                def x3:double (hi2 + y3)
                def yr2:double (x3 - hi2)
                if (y3 == yr2) {
                    hi2 = x3
                }
            }
        }
        return hi2
    }

