; ============================================================================
; PyModules.rgr — the standard library modules the runtime ships with:
;   math, random, json, os, os.path, sys, string, time, collections,
;   itertools, functools, statistics, copy (typing is in lib/).
;
; A module is a PyVal(Module) whose functions are PyVal(Builtin) named
; "module.function"; PyBuiltins.call hands every such name to callBuiltin.
; random is CPython's Mersenne Twister, so a seeded script draws the same
; numbers here as under CPython.
; ============================================================================

Import "PyOps.rgr"
Import "PyValue.rgr"
Import "PyFormat.rgr"
Import "PyFs.rgr"
Import "PyInterp.rgr"

class PyModules {
    def ip:PyInterp
    def mt:[int]
    def mti:int 625
    def seeded:boolean false
    def gaussNext:double 0.0
    def hasGauss:boolean false
    def jcs:[int]
    def jpos:int 0
    def jdoc:string ""

    Constructor (interp:PyInterp) {
        ip = interp
    }

    ; ---- building modules

    fn fns:void (m:PyVal names:string) {
        def ns:[string] (strsplit names " ")
        for ns n:string i {
            def b (new PyVal(PyT.Builtin))
            b.s = (m.s + "." + n)
            m.putAttr(n b)
        }
    }

    fn floatInfo:PyVal () {
        def m:PyVal (this.newModule("sys.float_info"))
        m.putAttr("max" (ip.mkFloat((py_parse_float "1.7976931348623157e308"))))
        m.putAttr("min" (ip.mkFloat((py_parse_float "2.2250738585072014e-308"))))
        m.putAttr("epsilon" (ip.mkFloat((py_parse_float "2.220446049250313e-16"))))
        m.putAttr("dig" (ip.mkInt(15)))
        m.putAttr("mant_dig" (ip.mkInt(53)))
        m.putAttr("max_exp" (ip.mkInt(1024)))
        m.putAttr("min_exp" (ip.mkInt(-1021)))
        m.putAttr("max_10_exp" (ip.mkInt(308)))
        m.putAttr("min_10_exp" (ip.mkInt(-307)))
        m.putAttr("radix" (ip.mkInt(2)))
        return m
    }

    fn newModule:PyVal (name:string) {
        def m (new PyVal(PyT.Module))
        m.s = name
        return m
    }

    fn nativeClass:PyVal (name:string) {
        def c (new PyVal(PyT.Class))
        c.s = name
        c.mode = "native"
        ip.computeMro(c)
        return c
    }

    fn strList:PyVal (names:string) {
        def out:[PyVal]
        def ns:[string] (strsplit names " ")
        for ns n:string i {
            push out (ip.mkStr(n))
        }
        return (ip.mkList(out))
    }

    fn make@(optional):PyVal (name:string) {
        def none@(optional):PyVal
        if (name == "math") {
            def m:PyVal (this.newModule("math"))
            this.fns(m "sqrt sin cos tan asin acos atan atan2 sinh cosh tanh exp expm1 log log10 log2 log1p pow floor ceil trunc fabs hypot degrees radians isnan isinf isfinite isclose gcd lcm factorial comb perm prod fsum copysign fmod modf dist isqrt")
            m.putAttr("pi" (ip.mkFloat(3.141592653589793)))
            m.putAttr("e" (ip.mkFloat(2.718281828459045)))
            m.putAttr("tau" (ip.mkFloat(6.283185307179586)))
            m.putAttr("inf" (ip.mkFloat((py_inf))))
            m.putAttr("nan" (ip.mkFloat((py_nan))))
            def optr79@(optional):PyVal m
            return optr79
        }
        if (name == "random") {
            def m2:PyVal (this.newModule("random"))
            this.fns(m2 "seed random randint randrange choice choices shuffle uniform sample gauss normalvariate triangular expovariate getrandbits")
            def optr84@(optional):PyVal m2
            return optr84
        }
        if (name == "json") {
            def m3:PyVal (this.newModule("json"))
            this.fns(m3 "dumps loads dump load")
            def ve@(optional):PyVal (get ip.builtins "ValueError")
            def jc:PyVal (this.nativeClass("JSONDecodeError"))
            jc.mode = "builtin"
            jc.isExc = true
            push jc.bases (unwrap ve)
            ip.computeMro(jc)
            m3.putAttr("JSONDecodeError" jc)
            def optr96@(optional):PyVal m3
            return optr96
        }
        if (name == "os") {
            def m4:PyVal (this.newModule("os"))
            this.fns(m4 "getcwd chdir listdir mkdir makedirs remove unlink rmdir rename replace walk getenv")
            m4.putAttr("sep" (ip.mkStr("/")))
            m4.putAttr("linesep" (ip.mkStr("\n")))
            m4.putAttr("name" (ip.mkStr("posix")))
            m4.putAttr("curdir" (ip.mkStr(".")))
            m4.putAttr("environ" (ip.mkDict()))
            m4.putAttr("path" (unwrap (this.make("os.path"))))
            def optr107@(optional):PyVal m4
            return optr107
        }
        if (name == "os.path") {
            def m5:PyVal (this.newModule("os.path"))
            this.fns(m5 "join exists isfile isdir basename dirname split splitext abspath normpath getsize isabs expanduser")
            m5.putAttr("sep" (ip.mkStr("/")))
            def optr113@(optional):PyVal m5
            return optr113
        }
        if (name == "sys") {
            def m6:PyVal (this.newModule("sys"))
            this.fns(m6 "exit setrecursionlimit getrecursionlimit getsizeof intern _ranger_step_budget")
            def args:[PyVal]
            for ip.argv a:string i {
                push args (ip.mkStr(a))
            }
            if ((array_length args) == 0) {
                push args (ip.mkStr("main.py"))
            }
            m6.putAttr("argv" (ip.mkList(args)))
            def so (new PyVal(PyT.File))
            so.s = "<stdout>"
            so.mode = "w"
            m6.putAttr("stdout" so)
            def se (new PyVal(PyT.File))
            se.s = "<stderr>"
            se.mode = "w"
            m6.putAttr("stderr" se)
            m6.putAttr("maxsize" (ip.mkInt(9007199254740991)))
            m6.putAttr("version" (ip.mkStr("3.13.0 (Ranger Python runtime)")))
            m6.putAttr("platform" (ip.mkStr("ranger")))
            m6.putAttr("path" (ip.mkList(([] _:PyVal ()))))
            m6.putAttr("modules" ip.sysModules)
            m6.putAttr("byteorder" (ip.mkStr("little")))
            m6.putAttr("implementation" (this.newModule("ranger")))
            m6.putAttr("float_info" (this.floatInfo()))
            def ii:PyVal (this.newModule("sys.int_info"))
            ii.putAttr("bits_per_digit" (ip.mkInt(30)))
            ii.putAttr("sizeof_digit" (ip.mkInt(4)))
            ii.putAttr("default_max_str_digits" (ip.mkInt(4300)))
            ii.putAttr("str_digits_check_threshold" (ip.mkInt(640)))
            m6.putAttr("int_info" ii)
            m6.putAttr("maxunicode" (ip.mkInt(1114111)))
            m6.putAttr("executable" (ip.mkStr("")))
            m6.putAttr("prefix" (ip.mkStr("")))
            m6.putAttr("warnoptions" (ip.mkList(([] _:PyVal ()))))
            def fl:PyVal (this.newModule("sys.flags"))
            def fnames:[string] ([] _:string ("debug" "inspect" "interactive" "optimize" "dont_write_bytecode" "no_user_site" "no_site" "ignore_environment" "verbose" "bytes_warning" "quiet" "hash_randomization" "isolated" "dev_mode" "utf8_mode" "warn_default_encoding" "safe_path" "int_max_str_digits"))
            for fnames fln:string fli {
                fl.putAttr(fln (ip.mkInt(0)))
            }
            m6.putAttr("flags" fl)
            m6.putAttr("hexversion" (ip.mkInt(51183856)))
            m6.putAttr("version_info" (ip.mkTuple(([] _:PyVal ((ip.mkInt(3)) (ip.mkInt(13)) (ip.mkInt(0)) (ip.mkStr("final")) (ip.mkInt(0)))))))
            def optr139@(optional):PyVal m6
            return optr139
        }
        if (name == "_string") {
            def m7:PyVal (this.newModule("string"))
            m7.putAttr("ascii_lowercase" (ip.mkStr("abcdefghijklmnopqrstuvwxyz")))
            m7.putAttr("ascii_uppercase" (ip.mkStr("ABCDEFGHIJKLMNOPQRSTUVWXYZ")))
            m7.putAttr("ascii_letters" (ip.mkStr("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")))
            m7.putAttr("digits" (ip.mkStr("0123456789")))
            m7.putAttr("hexdigits" (ip.mkStr("0123456789abcdefABCDEF")))
            m7.putAttr("octdigits" (ip.mkStr("01234567")))
            def punct:string ("!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~")
            m7.putAttr("punctuation" (ip.mkStr(punct)))
            def ws:string (" \t\n\r" + (py_chr 11) + (py_chr 12))
            m7.putAttr("whitespace" (ip.mkStr(ws)))
            m7.putAttr("printable" (ip.mkStr(("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ" + punct + ws))))
            def optr154@(optional):PyVal m7
            return optr154
        }
        if (name == "time") {
            def m8:PyVal (this.newModule("time"))
            this.fns(m8 "time perf_counter monotonic sleep time_ns process_time")
            def optr159@(optional):PyVal m8
            return optr159
        }
        if (name == "builtins") {
            def mb:PyVal (this.newModule("builtins"))
            mb.attrs = ip.builtins
            def optrmb@(optional):PyVal mb
            return optrmb
        }
        if (name == "_collections") {
            ; the native half of collections (lib/collections adds the rest)
            def m9:PyVal (this.newModule("collections"))
            m9.putAttr("defaultdict" (this.nativeClass("defaultdict")))
            m9.putAttr("Counter" (this.nativeClass("Counter")))
            m9.putAttr("OrderedDict" (this.nativeClass("OrderedDict")))
            m9.putAttr("deque" (this.nativeClass("deque")))
            this.fns(m9 "namedtuple")
            def optr168@(optional):PyVal m9
            return optr168
        }
        if (name == "itertools") {
            def m10:PyVal (this.newModule("itertools"))
            this.fns(m10 "chain product permutations combinations combinations_with_replacement accumulate groupby islice zip_longest starmap takewhile dropwhile filterfalse pairwise compress repeat tee count cycle batched")
            def optr173@(optional):PyVal m10
            return optr173
        }
        if (name == "functools") {
            def m11:PyVal (this.newModule("functools"))
            this.fns(m11 "reduce partial lru_cache cache wraps total_ordering cmp_to_key")
            def optr178@(optional):PyVal m11
            return optr178
        }
        if (name == "statistics") {
            def m12:PyVal (this.newModule("statistics"))
            this.fns(m12 "mean fmean median median_low median_high mode stdev pstdev variance pvariance")
            def se2:PyVal (this.nativeClass("StatisticsError"))
            se2.mode = "builtin"
            se2.isExc = true
            push se2.bases (unwrap (get ip.builtins "ValueError"))
            ip.computeMro(se2)
            m12.putAttr("StatisticsError" se2)
            def optr189@(optional):PyVal m12
            return optr189
        }
        if (name == "copy") {
            def m13:PyVal (this.newModule("copy"))
            this.fns(m13 "copy deepcopy")
            def optr194@(optional):PyVal m13
            return optr194
        }
        return none
    }

    ; ---- argument helpers

    fn num:double (args:[PyVal] i:int fname:string) {
        if (i >= (array_length args)) {
            ip.raise("TypeError" (fname + "() missing required argument"))
        }
        return (ip.bi.toNum((itemAt args i)))
    }

    fn domain:void () {
        ip.raise("ValueError" "math domain error")
    }

    fn checkF:PyVal (x:double) {
        if ((py_isinf x) || (py_isnan x)) {
            ; a finite input that overflowed
            if (py_isinf x) {
                ip.raise("OverflowError" "math range error")
            }
        }
        return (ip.mkFloat(x))
    }

    fn intOf:PyVal (x:double) {
        return (ip.bi.toIntValue((ip.mkFloat(x))))
    }

    fn bitLength:int (n0:int) {
        def n:int n0
        if (n < 0) {
            n = (0 - n)
        }
        def k:int 0
        while (n > 0) {
            n = (idiv n 2)
            k = k + 1
        }
        return k
    }

    fn codesOf:[int] (s:string) {
        def v:PyVal (ip.mkStr(s))
        return (v.codes())
    }

    fn listOf:[PyVal] (v:PyVal) {
        return (ip.iterValues(v))
    }

    fn call1:PyVal (f:PyVal a:PyVal) {
        def kn:[string]
        def kv:[PyVal]
        return (ip.callValue(f ([] _:PyVal (a)) kn kv))
    }

    fn call2:PyVal (f:PyVal a:PyVal b:PyVal) {
        def kn:[string]
        def kv:[PyVal]
        return (ip.callValue(f ([] _:PyVal (a b)) kn kv))
    }

    ; ---- dispatch

    fn callBuiltin:PyVal (name:string args:[PyVal] kn:[string] kv:[PyVal]) {
        def dot:int (lastIndexOf name ".")
        if (dot < 0) {
            ip.raise("NameError" ("name '" + name + "' is not defined"))
        }
        def mod:string (substring name 0 dot)
        def f:string (substring name (dot + 1) (strlen name))
        if (mod == "math") {
            return (this.mathCall(f args kn kv))
        }
        if (mod == "random") {
            return (this.randomCall(f args kn kv))
        }
        if (mod == "json") {
            return (this.jsonCall(f args kn kv))
        }
        if ((mod == "os") || (mod == "os.path")) {
            return (this.osCall(mod f args kn kv))
        }
        if (mod == "sys") {
            if (f == "exit") {
                def code:PyVal ip.NONE
                if ((array_length args) > 0) {
                    code = (itemAt args 0)
                }
                ip.raiseVal((ip.makeExcArg("SystemExit" code)))
            }
            if (f == "setrecursionlimit") {
                def lim:int (ip.bi.toInt((itemAt args 0) "limit"))
                if (lim > 900) {
                    lim = 900
                }
                ip.maxDepth = lim
                return ip.NONE
            }
            if (f == "getrecursionlimit") {
                return (ip.mkInt(1000))
            }
            if (f == "intern") {
                return (itemAt args 0)
            }
            if (f == "getsizeof") {
                return (ip.mkInt(64))
            }
            if (f == "_ranger_step_budget") {
                ; the steps the code after this may take (the conformance runner
                ; gives each test its own budget)
                ip.maxSteps = (ip.steps + (ip.bi.toInt((itemAt args 0) "budget")))
                return ip.NONE
            }
        }
        if (mod == "time") {
            if (f == "sleep") {
                return ip.NONE
            }
            if (f == "time_ns") {
                return (ip.mkInt((py_trunc ((py_now_ms) * 1000000.0))))
            }
            return (ip.mkFloat(((py_now_ms) / 1000.0)))
        }
        if (mod == "collections") {
            return (this.namedTuple(args kn kv))
        }
        if (mod == "itertools") {
            return (this.iterCall(f args kn kv))
        }
        if (mod == "functools") {
            return (this.funcCall(f args kn kv))
        }
        if (mod == "statistics") {
            return (this.statCall(f args kn kv))
        }
        if (mod == "copy") {
            if (f == "copy") {
                return (this.shallowCopy((itemAt args 0)))
            }
            return (this.deepCopy((itemAt args 0)))
        }
        if (mod == "typing") {
            if (f == "cast") {
                return (itemAt args 1)
            }
            if (f == "TypeVar") {
                return (ip.mkStr((ip.toStr((itemAt args 0)))))
            }
            return ip.NONE
        }
        ip.raise("AttributeError" ("module '" + mod + "' has no attribute '" + f + "'"))
        return ip.NONE
    }

    ; ---- math

    fn mathCall:PyVal (f:string args:[PyVal] kn:[string] kv:[PyVal]) {
        def n:int (array_length args)
        if (f == "sqrt") {
            def x:double (this.num(args 0 f))
            if (x < 0.0) {
                this.domain()
            }
            return (ip.mkFloat((py_sqrt x)))
        }
        if (f == "sin") {
            return (ip.mkFloat((py_sin (this.num(args 0 f)))))
        }
        if (f == "cos") {
            return (ip.mkFloat((py_cos (this.num(args 0 f)))))
        }
        if (f == "tan") {
            return (ip.mkFloat((py_tan (this.num(args 0 f)))))
        }
        if ((f == "asin") || (f == "acos")) {
            def x2:double (this.num(args 0 f))
            if ((x2 > 1.0) || (x2 < -1.0)) {
                this.domain()
            }
            if (f == "asin") {
                return (ip.mkFloat((py_asin x2)))
            }
            return (ip.mkFloat((py_acos x2)))
        }
        if (f == "atan") {
            return (ip.mkFloat((py_atan (this.num(args 0 f)))))
        }
        if (f == "atan2") {
            return (ip.mkFloat((py_atan2 (this.num(args 0 f)) (this.num(args 1 f)))))
        }
        if ((f == "sinh") || (f == "cosh") || (f == "tanh")) {
            def x3:double (this.num(args 0 f))
            def ep:double (py_exp x3)
            def em:double (py_exp (0.0 - x3))
            if (f == "sinh") {
                return (this.checkF(((ep - em) / 2.0)))
            }
            if (f == "cosh") {
                return (this.checkF(((ep + em) / 2.0)))
            }
            if (x3 > 20.0) {
                return (ip.mkFloat(1.0))
            }
            if (x3 < -20.0) {
                return (ip.mkFloat(-1.0))
            }
            return (ip.mkFloat(((ep - em) / (ep + em))))
        }
        if (f == "exp") {
            return (this.checkF((py_exp (this.num(args 0 f)))))
        }
        if (f == "expm1") {
            def x4:double (this.num(args 0 f))
            if ((x4 < 0.00001) && (x4 > -0.00001)) {
                return (ip.mkFloat((x4 + ((x4 * x4) / 2.0) + ((x4 * x4 * x4) / 6.0))))
            }
            return (this.checkF(((py_exp x4) - 1.0)))
        }
        if (f == "log") {
            def x5:double (this.num(args 0 f))
            if (x5 <= 0.0) {
                this.domain()
            }
            if (n > 1) {
                def b:double (this.num(args 1 f))
                if (b <= 0.0) {
                    this.domain()
                }
                def lb:double (py_log b)
                if (lb == 0.0) {
                    ip.raise("ZeroDivisionError" "division by zero")
                }
                return (ip.mkFloat(((py_log x5) / lb)))
            }
            return (ip.mkFloat((py_log x5)))
        }
        if ((f == "log10") || (f == "log2")) {
            def x6:double (this.num(args 0 f))
            if (x6 <= 0.0) {
                this.domain()
            }
            if (f == "log10") {
                return (ip.mkFloat((py_log10 x6)))
            }
            return (ip.mkFloat((py_log2 x6)))
        }
        if (f == "log1p") {
            def x7:double (this.num(args 0 f))
            if (x7 <= -1.0) {
                this.domain()
            }
            def u:double (1.0 + x7)
            if (u == 1.0) {
                return (ip.mkFloat(x7))
            }
            return (ip.mkFloat(((py_log u) * (x7 / (u - 1.0)))))
        }
        if (f == "pow") {
            def a:double (this.num(args 0 f))
            def b2:double (this.num(args 1 f))
            if ((a == 0.0) && (b2 < 0.0)) {
                this.domain()
            }
            if ((a < 0.0) && ((py_floor b2) != b2) && ((py_isinf b2) == false)) {
                this.domain()
            }
            def r:double (py_pow a b2)
            if ((py_isinf r) && ((py_isinf a) == false) && ((py_isinf b2) == false)) {
                ip.raise("OverflowError" "math range error")
            }
            return (ip.mkFloat(r))
        }
        if ((f == "floor") || (f == "ceil") || (f == "trunc")) {
            def v:PyVal (itemAt args 0)
            if (ip.isIntLike(v)) {
                return (ip.mkInt(v.i))
            }
            def mname:string ("__" + f + "__")
            def dm@(optional):PyVal (ip.findMethod(v mname))
            if (!null? dm) {
                return (ip.callMethodVal((unwrap dm) v ([] _:PyVal ())))
            }
            def x8:double (this.num(args 0 f))
            if (f == "floor") {
                return (this.intOf((py_floor x8)))
            }
            if (f == "ceil") {
                return (this.intOf((py_ceil x8)))
            }
            return (this.intOf(x8))
        }
        if (f == "fabs") {
            def x9:double (this.num(args 0 f))
            if (x9 < 0.0) {
                return (ip.mkFloat((0.0 - x9)))
            }
            return (ip.mkFloat((x9 + 0.0)))
        }
        if ((f == "hypot") || (f == "dist")) {
            def xs:[double]
            if (f == "hypot") {
                for args av:PyVal ai {
                    push xs (ip.bi.toNum(av))
                }
            } {
                def p:[PyVal] (this.listOf((itemAt args 0)))
                def q:[PyVal] (this.listOf((itemAt args 1)))
                if ((array_length p) != (array_length q)) {
                    ip.raise("ValueError" "both points must have the same number of dimensions")
                }
                for p pv:PyVal pi {
                    push xs ((ip.bi.toNum(pv)) - (ip.bi.toNum((itemAt q pi))))
                }
            }
            def big:double 0.0
            for xs xv:double xi {
                def ax:double xv
                if (ax < 0.0) {
                    ax = (0.0 - ax)
                }
                if (py_isinf ax) {
                    return (ip.mkFloat((py_inf)))
                }
                if (ax > big) {
                    big = ax
                }
            }
            if (big == 0.0) {
                return (ip.mkFloat(0.0))
            }
            if ((array_length xs) == 2) {
                def h0:double (itemAt xs 0)
                def h1:double (itemAt xs 1)
                def hs:double ((h0 * h0) + (h1 * h1))
                if ((py_isinf hs) == false) {
                    if (hs > 0.0) {
                        return (ip.mkFloat((py_sqrt hs)))
                    }
                }
            }
            def sq:[double]
            for xs xv2:double xi2 {
                def t:double (xv2 / big)
                push sq (t * t)
            }
            return (ip.mkFloat((big * (py_sqrt (this.fsumD(sq))))))
        }
        if (f == "degrees") {
            return (ip.mkFloat(((this.num(args 0 f)) * (180.0 / 3.141592653589793))))
        }
        if (f == "radians") {
            return (ip.mkFloat(((this.num(args 0 f)) * (3.141592653589793 / 180.0))))
        }
        if (f == "isnan") {
            return (ip.mkBool((py_isnan (this.num(args 0 f)))))
        }
        if (f == "isinf") {
            return (ip.mkBool((py_isinf (this.num(args 0 f)))))
        }
        if (f == "isfinite") {
            def x10:double (this.num(args 0 f))
            return (ip.mkBool((((py_isinf x10) == false) && ((py_isnan x10) == false))))
        }
        if (f == "isclose") {
            def a2:double (this.num(args 0 f))
            def b3:double (this.num(args 1 f))
            def rel:double 0.000000001
            def abt:double 0.0
            def rk@(optional):PyVal (ip.bi.kw(kn kv "rel_tol"))
            if (!null? rk) {
                rel = (ip.bi.toNum((unwrap rk)))
            }
            def ak@(optional):PyVal (ip.bi.kw(kn kv "abs_tol"))
