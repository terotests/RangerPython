    ; ---- json

    fn jsonStr:string (s:string ascii:boolean) {
        def cs:[int] (this.codesOf(s))
        def out:[int]
        push out 34
        for cs c:int i {
            if (c == 34) {
                push out 92
                push out 34
                continue
            }
            if (c == 92) {
                push out 92
                push out 92
                continue
            }
            if (c == 10) {
                push out 92
                push out 110
                continue
            }
            if (c == 13) {
                push out 92
                push out 114
                continue
            }
            if (c == 9) {
                push out 92
                push out 116
                continue
            }
            if (c == 8) {
                push out 92
                push out 98
                continue
            }
            if (c == 12) {
                push out 92
                push out 102
                continue
            }
            if ((c < 32) || (ascii && (c > 126))) {
                if (c > 65535) {
                    def v:int (c - 65536)
                    this.pushU(out (55296 + (idiv v 1024)))
                    this.pushU(out (56320 + (v % 1024)))
                } {
                    this.pushU(out c)
                }
                continue
            }
            push out c
        }
        push out 34
        return (py_codes_to_str out 0 (array_length out))
    }

    fn pushU:void (out:[int] c:int) {
        push out 92
        push out 117
        def hx:string (ip.bi.hexPad(c 4))
        def hc:[int] (this.codesOf(hx))
