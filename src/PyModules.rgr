            deco.s = "functools.lru_cache"
            return deco
        }
        if ((f == "wraps") || (f == "total_ordering")) {
            if (f == "total_ordering") {
                return (itemAt args 0)
            }
            def idf (new PyVal(PyT.Builtin))
            idf.s = "functools._identity"
            return idf
        }
        if (f == "_identity") {
            return (itemAt args 0)
        }
        if (f == "cmp_to_key") {
            def kf (new PyVal(PyT.Builtin))
            kf.s = "functools._cmp_key"
            kf.wrapped = (itemAt args 0)
            return kf
        }
        if ((f == "_cmp_lt") || (f == "_cmp_gt") || (f == "_cmp_eq")) {
            def a:PyVal (itemAt args 0)
            def b:PyVal (itemAt args 1)
            def cmp:PyVal (unwrap (get a.attrs "cmp"))
            def r:PyVal (this.call2(cmp (unwrap (get a.attrs "obj")) (unwrap (get b.attrs "obj"))))
            def rv:double (ip.toDouble(r))
            if (f == "_cmp_lt") {
                return (ip.mkBool((rv < 0.0)))
            }
            if (f == "_cmp_gt") {
                return (ip.mkBool((rv > 0.0)))
            }
            return (ip.mkBool((rv == 0.0)))
        }
        ip.raise("AttributeError" ("module 'functools' has no attribute '" + f + "'"))
        return ip.NONE
    }

    ; a builtin that carries state: partial, lru_cache wrappers, cmp_to_key, _make
    fn callWrapped:PyVal (b:PyVal args:[PyVal] kn:[string] kv:[PyVal]) {
        def target:PyVal (unwrap b.wrapped)
        if (b.s == "functools.partial") {
            def all:[PyVal]
            for b.items a:PyVal i {
                push all a
            }
            for args a2:PyVal j {
                push all a2
            }
            def kn2:[string]
            def kv2:[PyVal]
            def ks:[string] (b.attrKeys())
            for ks k:string ki {
                if ((indexOf kn k) < 0) {
                    push kn2 k
                    push kv2 (unwrap (get b.attrs k))
                }
            }
            for kn k2:string ki2 {
                push kn2 k2
                push kv2 (itemAt kv ki2)
            }
            return (ip.callValue(target all kn2 kv2))
        }
        if (b.s == "functools._lru_wrapper") {
            def cache:PyVal (unwrap (get b.attrs "__cache__"))
            def keyItems:[PyVal]
            for args a3:PyVal i3 {
                push keyItems a3
            }
            for kn k3:string ki3 {
                push keyItems (ip.mkStr(k3))
                push keyItems (itemAt kv ki3)
            }
            def key:PyVal (ip.mkTuple(keyItems))
            def hit@(optional):PyVal (ip.dictGet(cache key))
            if (!null? hit) {
                return (unwrap hit)
            }
            def r:PyVal (ip.callValue(target args kn kv))
            ip.dictSet(cache key r)
            return r
        }
        if (b.s == "functools._cmp_key") {
            def kc:PyVal (this.cmpKeyClass())
            def o (new PyVal(PyT.Inst))
            o.cls = kc
            o.putAttr("cmp" target)
            o.putAttr("obj" (itemAt args 0))
            return o
        }
        if (b.s == "collections._make") {
            return (this.ntMake(target (this.listOf((itemAt args 0))) kn kv))
        }
        ip.raise("TypeError" ("'" + b.s + "' object is not callable"))
        return ip.NONE
    }

    fn cmpKeyClass:PyVal () {
        def kc@(optional):PyVal (get ip.builtins "__cmp_key_class__")
        if (!null? kc) {
            return (unwrap kc)
        }
        def c:PyVal (this.nativeClass("functools.KeyWrapper"))
        c.mode = "builtin"
        def lt (new PyVal(PyT.Builtin))
        lt.s = "functools._cmp_lt"
        c.putAttr("__lt__" lt)
        def gt (new PyVal(PyT.Builtin))
        gt.s = "functools._cmp_gt"
        c.putAttr("__gt__" gt)
        def eq (new PyVal(PyT.Builtin))
        eq.s = "functools._cmp_eq"
        c.putAttr("__eq__" eq)
        set ip.builtins "__cmp_key_class__" c
        return c
    }

    ; ---- statistics

    fn statErr:void (msg:string) {
        def sm:PyVal (unwrap (this.make("statistics")))
        ip.raiseVal((ip.makeExc((unwrap (get sm.attrs "StatisticsError")) msg)))
    }

    fn statCall:PyVal (f:string args:[PyVal] kn:[string] kv:[PyVal]) {
        def data:[PyVal] (this.listOf((itemAt args 0)))
        def n:int (array_length data)
        def allInt:boolean true
        for data v:PyVal i {
            if ((ip.isIntLike(v)) == false) {
                allInt = false
            }
        }
        if (f == "mode") {
            if (n == 0) {
                this.statErr("no mode for empty data")
            }
            def counts:PyVal (ip.mkDict())
            this.counterFeed(counts (ip.mkList(data)))
            def best:int 0
            def bestK:PyVal ip.NONE
            for counts.items k:PyVal ki {
                def c:int ((itemAt counts.vals ki).i)
                if (c > best) {
                    best = c
                    bestK = k
                }
            }
            return bestK
        }
        if ((f == "median") || (f == "median_low") || (f == "median_high")) {
            if (n == 0) {
                this.statErr("no median for empty data")
            }
            def s:[PyVal] (ip.bi.sortVals(data ip.NONE false))
            def mid:int (idiv n 2)
            if ((n % 2) == 1) {
                return (itemAt s mid)
            }
            if (f == "median_low") {
                return (itemAt s (mid - 1))
            }
            if (f == "median_high") {
                return (itemAt s mid)
            }
            return (ip.binop("/" (ip.binop("+" (itemAt s (mid - 1)) (itemAt s mid))) (ip.mkInt(2))))
        }
        if ((f == "mean") || (f == "fmean")) {
            if (n == 0) {
                if (f == "fmean") {
                    this.statErr("fmean requires at least one data point")
                }
                this.statErr("mean requires at least one data point")
            }
            if (allInt && (f == "mean")) {
                def tot:int 0
                for data v2:PyVal i2 {
                    tot = tot + v2.i
                }
                if ((PyFormat.floorModInt(tot n)) == 0) {
                    return (ip.mkInt((PyFormat.floorDivInt(tot n))))
                }
                return (ip.mkFloat(((py_i2d tot) / (py_i2d n))))
            }
            def ds:[double]
            for data v3:PyVal i3 {
                push ds (ip.bi.toNum(v3))
            }
            return (ip.mkFloat(((this.fsumD(ds)) / (py_i2d n))))
        }
        ; variance and standard deviation
        def sample:boolean ((f == "stdev") || (f == "variance"))
        def need:int 1
        if sample {
            need = 2
        }
        if (n < need) {
            if sample {
                this.statErr((f + " requires at least two data points"))
            }
            this.statErr((f + " requires at least one data point"))
        }
        def den:int n
        if sample {
            den = (n - 1)
        }
        if allInt {
            ; exact: (n*sum(x^2) - sum(x)^2) / (n*den)
            def sx:int 0
            def sxx:int 0
            for data v4:PyVal i4 {
                sx = sx + v4.i
                sxx = sxx + (v4.i * v4.i)
            }
            def num:int ((n * sxx) - (sx * sx))
            def dd:int (n * den)
            if ((f == "variance") || (f == "pvariance")) {
                if ((num % dd) == 0) {
                    return (ip.mkInt((idiv num dd)))
                }
                return (ip.mkFloat(((py_i2d num) / (py_i2d dd))))
            }
            return (ip.mkFloat((py_sqrt ((py_i2d num) / (py_i2d dd)))))
        }
        def xs:[double]
        for data v5:PyVal i5 {
            push xs (ip.bi.toNum(v5))
        }
        def m:double ((this.fsumD(xs)) / (py_i2d n))
        def sq:[double]
        for xs x:double i6 {
            push sq ((x - m) * (x - m))
        }
        def var:double ((this.fsumD(sq)) / (py_i2d den))
        if ((f == "variance") || (f == "pvariance")) {
            return (ip.mkFloat(var))
        }
        return (ip.mkFloat((py_sqrt var)))
    }

    ; ---- copy

    fn shallowCopy:PyVal (v:PyVal) {
        switch v.t {
            case PyT.List {
                def l:PyVal (ip.mkList((this.listOf(v))))
                l.mode = v.mode
                l.i3 = v.i3
                this.copyAttrs(v l)
                return l
            }
            case PyT.Dict {
                def d:PyVal (ip.copyDict(v))
                d.mode = v.mode
                this.copyAttrs(v d)
                return d
            }
            case PyT.Set {
                if (v.mode == "frozen") {
                    return v
                }
                return (ip.copySet(v))
            }
            case PyT.Inst {
                def o (new PyVal(PyT.Inst))
                o.cls = v.cls
                this.copyAttrs(v o)
                return o
            }
        }
        return v
    }

    fn copyAttrs:void (src:PyVal dst:PyVal) {
        def ks:[string] (src.attrKeys())
        for ks k:string i {
            dst.putAttr(k (unwrap (get src.attrs k)))
        }
    }

    fn deepCopy:PyVal (v:PyVal) {
        switch v.t {
            case PyT.List {
                def items:[PyVal]
                for v.items x:PyVal i {
                    push items (this.deepCopy(x))
                }
                def l:PyVal (ip.mkList(items))
                l.mode = v.mode
                l.i3 = v.i3
                this.copyAttrs(v l)
                return l
            }
            case PyT.Tuple {
                def items2:[PyVal]
                for v.items x2:PyVal i2 {
                    push items2 (this.deepCopy(x2))
                }
                def t:PyVal (ip.mkTuple(items2))
                this.copyAttrs(v t)
                return t
            }
            case PyT.Dict {
                def d:PyVal (ip.mkDict())
                d.mode = v.mode
                this.copyAttrs(v d)
                for v.items k:PyVal ki {
                    ip.dictSet(d k (this.deepCopy((itemAt v.vals ki))))
                }
                return d
            }
            case PyT.Set {
                if (v.mode == "frozen") {
                    return v
                }
                return (ip.copySet(v))
            }
            case PyT.Inst {
                if (ip.isExcInst(v)) {
                    return v
                }
                def o (new PyVal(PyT.Inst))
                o.cls = v.cls
                def ks:[string] (v.attrKeys())
                for ks k2:string i3 {
                    o.putAttr(k2 (this.deepCopy((unwrap (get v.attrs k2)))))
                }
                return o
            }
        }
        return v
    }
}
