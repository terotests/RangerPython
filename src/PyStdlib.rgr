        if (name == "shutil") {
            def s25@(optional):string "# SPDX-License-Identifier: MIT\n# shutil for the Ranger Python runtime, on its file system\nimport os\n\n\nclass Error(OSError):\n    pass\n\n\ndef copyfile(src, dst, *, follow_symlinks=True):\n    with open(src) as f:\n        data = f.read()\n    with open(dst, \"w\") as f:\n        f.write(data)\n    return dst\n\n\ndef copy(src, dst, *, follow_symlinks=True):\n    if os.path.isdir(dst):\n        dst = os.path.join(dst, os.path.basename(src))\n    return copyfile(src, dst)\n\n\ncopy2 = copy\n\n\ndef copymode(src, dst, *, follow_symlinks=True):\n    pass\n\n\ncopystat = copymode\n\n\ndef rmtree(path, ignore_errors=False, onerror=None, *, onexc=None, dir_fd=None):\n    try:\n        for name in os.listdir(path):\n            full = os.path.join(path, name)\n            if os.path.isdir(full):\n                rmtree(full, ignore_errors)\n            else:\n                os.remove(full)\n        if hasattr(os, \"rmdir\"):\n            os.rmdir(path)\n    except OSError:\n        if not ignore_errors:\n            raise\n\n\ndef move(src, dst):\n    copyfile(src, dst)\n    os.remove(src)\n    return dst\n\n\ndef which(cmd, mode=None, path=None):\n    return None\n\n\ndef get_terminal_size(fallback=(80, 24)):\n    return os.terminal_size(fallback) if hasattr(os, \"terminal_size\") else fallback\n\n\ndef disk_usage(path):\n    return (0, 0, 0)\n"
