        if (name == "numbers") {
            def s19@(optional):string "# SPDX-License-Identifier: MIT\n# numbers for the Ranger Python runtime: the numeric tower as classes that\n# answer isinstance() for the built-in numbers and for registered classes\n\n\ndef _tower(cls, builtins):\n    cls._registry = []\n    cls._builtins = builtins\n\n    def instancecheck(c, obj):\n        return subclasscheck(c, type(obj))\n\n    def subclasscheck(c, sub):\n        if sub is bool:\n            sub = int\n        if sub in c._builtins:\n            return True\n        for base in getattr(sub, \"__mro__\", (sub,)):\n            if base is c:\n                return True\n            for t in _all:\n                if c in t.__mro__ and (base in t._registry):\n                    return True\n        return False\n\n    def register(c, sub):\n        c._registry.append(sub)\n        return sub\n    cls.__instancecheck__ = classmethod(instancecheck)\n    cls.__subclasscheck__ = classmethod(subclasscheck)\n    cls.register = classmethod(register)\n    _all.append(cls)\n    return cls\n\n\n_all = []\n\n\nclass Number:\n    __slots__ = ()\n    __hash__ = None\n\n\nclass Complex(Number):\n    __slots__ = ()\n\n    def __bool__(self):\n        return self != 0\n\n    @property\n    def real(self):\n        raise NotImplementedError\n\n    @property\n    def imag(self):\n        raise NotImplementedError\n\n\nclass Real(Complex):\n    __slots__ = ()\n\n    def __complex__(self):\n        return complex(float(self))\n\n    @property\n    def real(self):\n        return +self\n\n    @property\n    def imag(self):\n        return 0\n\n    def conjugate(self):\n        return +self\n\n    def __divmod__(self, other):\n        return (self // other, self % other)\n\n    def __rdivmod__(self, other):\n        return (other // self, other % self)\n\n\nclass Rational(Real):\n    __slots__ = ()\n\n    def __float__(self):\n        return int(self.numerator) / int(self.denominator)\n\n\nclass Integral(Rational):\n    __slots__ = ()\n\n    def __float__(self):\n        return float(int(self))\n\n    def __index__(self):\n        return int(self)\n\n    @property\n    def numerator(self):\n        return +self\n\n    @property\n    def denominator(self):\n        return 1\n\n\n_tower(Number, (int, float, complex))\n_tower(Complex, (int, float, complex))\n_tower(Real, (int, float))\n_tower(Rational, (int,))\n_tower(Integral, (int,))\n"
            return s19
        }
        if (name == "operator") {
            def s20@(optional):string "# SPDX-License-Identifier: MIT\n# operator for the Ranger Python runtime.\n\ndef lt(a, b): return a < b\ndef le(a, b): return a <= b\ndef eq(a, b): return a == b\ndef ne(a, b): return a != b\ndef ge(a, b): return a >= b\ndef gt(a, b): return a > b\ndef not_(a): return not a\ndef truth(a): return bool(a)\ndef is_(a, b): return a is b\ndef is_not(a, b): return a is not b\ndef is_none(a): return a is None\ndef is_not_none(a): return a is not None\ndef abs(a): return __builtins_abs(a)\ndef add(a, b): return a + b\ndef and_(a, b): return a & b\ndef floordiv(a, b): return a // b\ndef index(a): return a.__index__() if hasattr(a, \"__index__\") else int(a)\ndef inv(a): return ~a\ninvert = inv\ndef lshift(a, b): return a << b\ndef mod(a, b): return a % b\ndef mul(a, b): return a * b\ndef matmul(a, b): return a @ b\ndef neg(a): return -a\ndef or_(a, b): return a | b\ndef pos(a): return +a\ndef pow(a, b): return a ** b\ndef rshift(a, b): return a >> b\ndef sub(a, b): return a - b\ndef truediv(a, b): return a / b\ndef xor(a, b): return a ^ b\ndef concat(a, b): return a + b\ndef contains(a, b): return b in a\ndef countOf(a, b):\n    n = 0\n    for x in a:\n        if x is b or x == b:\n            n += 1\n    return n\ndef delitem(a, b): del a[b]\ndef getitem(a, b): return a[b]\ndef indexOf(a, b):\n    for i, x in enumerate(a):\n        if x is b or x == b:\n            return i\n    raise ValueError(\"sequence.index(x): x not in sequence\")\ndef setitem(a, b, c): a[b] = c\ndef length_hint(obj, default=0):\n    try:\n        return len(obj)\n    except TypeError:\n        return default\ndef iadd(a, b):\n    a += b\n    return a\ndef isub(a, b):\n    a -= b\n    return a\ndef imul(a, b):\n    a *= b\n    return a\ndef iconcat(a, b):\n    a += b\n    return a\n\ndef __builtins_abs(a):\n    return a if a >= 0 else -a\n\n\nclass attrgetter:\n    def __init__(self, attr, *attrs):\n        self._attrs = (attr,) + attrs\n\n    def __call__(self, obj):\n        out = []\n        for name in self._attrs:\n            v = obj\n            for part in name.split(\".\"):\n                v = getattr(v, part)\n            out.append(v)\n        if len(out) == 1:\n            return out[0]\n        return tuple(out)\n\n\nclass itemgetter:\n    def __init__(self, item, *items):\n        self._items = (item,) + items\n\n    def __call__(self, obj):\n        if len(self._items) == 1:\n            return obj[self._items[0]]\n        return tuple(obj[i] for i in self._items)\n\n\nclass methodcaller:\n    def __init__(self, name, *args, **kwargs):\n        self._name = name\n        self._args = args\n        self._kwargs = kwargs\n\n    def __call__(self, obj):\n        return getattr(obj, self._name)(*self._args, **self._kwargs)\n"
            return s20
        }
        if (name == "pickle") {
            def s21@(optional):string "# SPDX-License-Identifier: MIT\n# pickle for the Ranger Python runtime: dumps() keeps a deep copy of the\n# value behind a small bytes key, and loads() copies it back out.\nimport copy as _copy\n\nHIGHEST_PROTOCOL = 5\nDEFAULT_PROTOCOL = 5\n_store = {}\n\n\nclass PickleError(Exception):\n    pass\n\n\nclass PicklingError(PickleError):\n    pass\n\n\nclass UnpicklingError(PickleError):\n    pass\n\n\ndef dumps(obj, protocol=None, *, fix_imports=True, buffer_callback=None):\n    key = len(_store)\n    _store[key] = _copy.deepcopy(obj)\n    return (\"\\x80pickle:%d.\" % key).encode(\"latin-1\")\n\n\ndef loads(data, /, *, fix_imports=True, encoding=\"ASCII\", errors=\"strict\", buffers=()):\n    text = data if isinstance(data, str) else data.decode(\"latin-1\")\n    if not text.startswith(\"\\x80pickle:\"):\n        raise UnpicklingError(\"invalid load key\")\n    return _copy.deepcopy(_store[int(text[8:-1])])\n\n\ndef dump(obj, file, protocol=None, **kw):\n    file.write(dumps(obj, protocol))\n\n\ndef load(file, **kw):\n    return loads(file.read())\n"
            return s21
        }
