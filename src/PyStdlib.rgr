        if (name == "threading") {
            def s14@(optional):string "# SPDX-License-Identifier: MIT\n# threading for the Ranger Python runtime. There is one thread: start()\n# runs the target to the end, and locks never have to wait.\n\n_ident = [1]\n\n\nclass Lock:\n    def __init__(self):\n        self._locked = False\n\n    def acquire(self, blocking=True, timeout=-1):\n        if self._locked:\n            if not blocking:\n                return False\n            raise RuntimeError(\"deadlock: the lock is held and there is only one thread\")\n        self._locked = True\n        return True\n\n    def release(self):\n        if not self._locked:\n            raise RuntimeError(\"release unlocked lock\")\n        self._locked = False\n\n    def locked(self):\n        return self._locked\n\n    def __enter__(self):\n        return self.acquire()\n\n    def __exit__(self, *exc):\n        self.release()\n\n\nclass RLock:\n    def __init__(self):\n        self._count = 0\n\n    def acquire(self, blocking=True, timeout=-1):\n        self._count += 1\n        return True\n\n    def release(self):\n        if not self._count:\n            raise RuntimeError(\"cannot release un-acquired lock\")\n        self._count -= 1\n\n    def __enter__(self):\n        return self.acquire()\n\n    def __exit__(self, *exc):\n        self.release()\n\n\nclass Condition:\n    def __init__(self, lock=None):\n        self._lock = lock or RLock()\n\n    def __enter__(self):\n        return self._lock.__enter__()\n\n    def __exit__(self, *exc):\n        return self._lock.__exit__(*exc)\n\n    def wait(self, timeout=None):\n        return True\n\n    def wait_for(self, predicate, timeout=None):\n        return predicate()\n\n    def notify(self, n=1):\n        pass\n\n    def notify_all(self):\n        pass\n\n\nclass Semaphore:\n    def __init__(self, value=1):\n        self._value = value\n\n    def acquire(self, blocking=True, timeout=None):\n        if self._value <= 0:\n            return False\n        self._value -= 1\n        return True\n\n    def release(self, n=1):\n        self._value += n\n\n    __enter__ = acquire\n\n    def __exit__(self, *exc):\n        self.release()\n\n\nBoundedSemaphore = Semaphore\n\n\nclass Event:\n    def __init__(self):\n        self._flag = False\n\n    def is_set(self):\n        return self._flag\n\n    def set(self):\n        self._flag = True\n\n    def clear(self):\n        self._flag = False\n\n    def wait(self, timeout=None):\n        return self._flag\n\n\nclass local:\n    pass\n\n\nclass Thread:\n    def __init__(self, group=None, target=None, name=None, args=(), kwargs=None, *, daemon=None):\n        self._target = target\n        self._args = args\n        self._kwargs = kwargs or {}\n        _ident[0] += 1\n        self.name = name or \"Thread-%d\" % (_ident[0] - 1)\n        self.ident = None\n        self.daemon = bool(daemon)\n        self._started = False\n        self._done = False\n\n    def start(self):\n        if self._started:\n            raise RuntimeError(\"threads can only be started once\")\n        self._started = True\n        self.ident = _ident[0]\n        try:\n            self.run()\n        finally:\n            self._done = True\n\n    def run(self):\n        if self._target is not None:\n            self._target(*self._args, **self._kwargs)\n\n    def join(self, timeout=None):\n        pass\n\n    def is_alive(self):\n        return self._started and not self._done\n\n\nclass _MainThread(Thread):\n    def __init__(self):\n        Thread.__init__(self, name=\"MainThread\")\n        self.ident = 1\n        self._started = True\n\n\n_main = _MainThread()\n\n\ndef current_thread():\n    return _main\n\n\ndef main_thread():\n    return _main\n\n\ndef get_ident():\n    return 1\n\n\ndef active_count():\n    return 1\n\n\ndef enumerate():\n    return [_main]\n\n\nTIMEOUT_MAX = 2147483.0\n"
            return s14
        }
        if (name == "traceback") {
            def s15@(optional):string "# SPDX-License-Identifier: MIT\n# traceback for the Ranger Python runtime: the exception's type and message.\nimport sys\n\ndef format_exception_only(exc, value=None):\n    if value is None and isinstance(exc, BaseException):\n        value = exc\n    msg = str(value)\n    name = type(value).__name__\n    return [name + (\": \" + msg if msg else \"\") + \"\\n\"]\n\ndef format_exception(exc, value=None, tb=None, limit=None, chain=True):\n    return [\"Traceback (most recent call last):\\n\"] + format_exception_only(exc, value)\n\ndef format_exc(limit=None, chain=True):\n    return \"NoneType: None\\n\"\n\ndef print_exc(limit=None, file=None, chain=True):\n    print(format_exc(), end=\"\", file=file)\n\ndef print_exception(exc, value=None, tb=None, limit=None, file=None, chain=True):\n    print(\"\".join(format_exception(exc, value)), end=\"\", file=file)\n\ndef format_stack(f=None, limit=None):\n    return []\n\ndef extract_stack(f=None, limit=None):\n    return []\n"
            return s15
        }
        if (name == "types") {
            def s16@(optional):string "# SPDX-License-Identifier: MIT\n# types for the Ranger Python runtime.\n\ndef _f():\n    pass\n\nclass _C:\n    def _m(self):\n        pass\n\nFunctionType = type(_f)\nLambdaType = type(lambda: None)\nMethodType = type(_C()._m)\nBuiltinFunctionType = type(len)\nBuiltinMethodType = type([].append)\nModuleType = type(__import__(\"sys\"))\nNoneType = type(None)\nEllipsisType = type(...)\nNotImplementedType = type(NotImplemented)\nGeneratorType = type((x for x in ()))\n\n\nclass SimpleNamespace:\n    def __init__(self, mapping_or_iterable=(), /, **kwargs):\n        if isinstance(mapping_or_iterable, dict):\n            for k in mapping_or_iterable:\n                setattr(self, k, mapping_or_iterable[k])\n        else:\n            for k, v in mapping_or_iterable:\n                setattr(self, k, v)\n        for k in kwargs:\n            setattr(self, k, kwargs[k])\n\n    def __repr__(self):\n        items = [\"%s=%r\" % (k, v) for k, v in self.__dict__.items()]\n        return \"namespace(\" + \", \".join(items) + \")\"\n\n    def __eq__(self, other):\n        return isinstance(other, SimpleNamespace) and self.__dict__ == other.__dict__\n\n\nclass MappingProxyType:\n    def __init__(self, mapping):\n        self._m = mapping\n\n    def __getitem__(self, k):\n        return self._m[k]\n\n    def __len__(self):\n        return len(self._m)\n\n    def __iter__(self):\n        return iter(self._m)\n\n    def __contains__(self, k):\n        return k in self._m\n\n    def get(self, k, default=None):\n        return self._m.get(k, default)\n\n    def keys(self):\n        return self._m.keys()\n\n    def values(self):\n        return self._m.values()\n\n    def items(self):\n        return self._m.items()\n\n    def copy(self):\n        return dict(self._m)\n\n\ndef new_class(name, bases=(), kwds=None, exec_body=None):\n    ns = {}\n    if exec_body is not None:\n        exec_body(ns)\n    return type(name, bases, ns)\n\n\nclass GenericAlias:\n    def __init__(self, origin, args):\n        if not isinstance(args, tuple):\n            args = (args,)\n        self.__origin__ = origin\n        self.__args__ = args\n        self.__parameters__ = ()\n\n    def __call__(self, *args, **kwargs):\n        return self.__origin__(*args, **kwargs)\n\n    def __getitem__(self, params):\n        return GenericAlias(self.__origin__, params)\n\n    def __or__(self, other):\n        return UnionType((self, other))\n\n    def __ror__(self, other):\n        return UnionType((other, self))\n\n    def __eq__(self, other):\n        return isinstance(other, GenericAlias) and self.__origin__ == other.__origin__ and self.__args__ == other.__args__\n\n    def __hash__(self):\n        return hash((self.__origin__, self.__args__))\n\n    def __mro_entries__(self, bases):\n        return (self.__origin__,)\n\n    def __repr__(self):\n        return _repr(self.__origin__) + \"[\" + \", \".join(_repr(a) for a in self.__args__) + \"]\"\n\n\nclass UnionType:\n    def __init__(self, args):\n        self.__args__ = args\n\n    def __or__(self, other):\n        return UnionType(self.__args__ + (other,))\n\n    def __repr__(self):\n        return \" | \".join(_repr(a) for a in self.__args__)\n\n\ndef _repr(obj):\n    if obj is ...:\n        return \"...\"\n    if obj is None or obj is type(None):\n        return \"None\"\n    if isinstance(obj, type):\n        if obj.__module__ == \"builtins\":\n            return obj.__qualname__\n        return obj.__module__ + \".\" + obj.__qualname__\n    if isinstance(obj, tuple) and not obj:\n        return \"()\"\n    return repr(obj)\n"
            return s16
        }
        if (name == "typing") {
            def s17@(optional):string "# SPDX-License-Identifier: MIT\n# typing for the Ranger Python runtime: the names exist and subscripting\n# them works, so annotated code runs; nothing is checked.\n\nTYPE_CHECKING = False\n\n\nclass _Alias:\n    def __init__(self, name, args=(), origin=None):\n        self._name = name\n        self.__args__ = args\n        self.__origin__ = origin\n        self.__name__ = name\n\n    def __getitem__(self, params):\n        if not isinstance(params, tuple):\n            params = (params,)\n        return _Alias(self._name, params, self)\n\n    def __call__(self, *args, **kwargs):\n        if self.__origin__ is not None:\n            return self.__origin__(*args, **kwargs)\n        raise TypeError(\"Cannot instantiate typing.\" + self._name)\n\n    def __or__(self, other):\n        return Union[self, other]\n\n    def __ror__(self, other):\n        return Union[other, self]\n\n    def __repr__(self):\n        if self.__args__:\n            return \"typing.%s[%s]\" % (self._name, \", \".join(_type_repr(a) for a in self.__args__))\n        return \"typing.\" + self._name\n\n    def __eq__(self, other):\n        return isinstance(other, _Alias) and self._name == other._name and self.__args__ == other.__args__\n\n    def __hash__(self):\n        return hash((self._name, self.__args__))\n\n\ndef _type_repr(obj):\n    if isinstance(obj, type):\n        if obj.__module__ == \"builtins\":\n            return obj.__qualname__\n        return obj.__module__ + \".\" + obj.__qualname__\n    if obj is ...:\n        return \"...\"\n    return repr(obj)\n\n\nclass _Builtin(_Alias):\n    def __init__(self, name, origin):\n        _Alias.__init__(self, name)\n        self._real = origin\n\n    def __call__(self, *args, **kwargs):\n        return self._real(*args, **kwargs)\n\n    def __getitem__(self, params):\n        if not isinstance(params, tuple):\n            params = (params,)\n        a = _Alias(self._name, params, self._real)\n        return a\n\n\nAny = _Alias(\"Any\")\nNoReturn = _Alias(\"NoReturn\")\nNever = _Alias(\"Never\")\nSelf = _Alias(\"Self\")\nLiteralString = _Alias(\"LiteralString\")\nUnion = _Alias(\"Union\")\nOptional = _Alias(\"Optional\")\nLiteral = _Alias(\"Literal\")\nClassVar = _Alias(\"ClassVar\")\nFinal = _Alias(\"Final\")\nAnnotated = _Alias(\"Annotated\")\nConcatenate = _Alias(\"Concatenate\")\nTypeGuard = _Alias(\"TypeGuard\")\nTypeIs = _Alias(\"TypeIs\")\nUnpack = _Alias(\"Unpack\")\nRequired = _Alias(\"Required\")\nNotRequired = _Alias(\"NotRequired\")\nReadOnly = _Alias(\"ReadOnly\")\nList = _Builtin(\"List\", list)\nDict = _Builtin(\"Dict\", dict)\nSet = _Builtin(\"Set\", set)\nFrozenSet = _Builtin(\"FrozenSet\", frozenset)\nTuple = _Builtin(\"Tuple\", tuple)\nType = _Builtin(\"Type\", type)\nCallable = _Alias(\"Callable\")\nIterable = _Alias(\"Iterable\")\nIterator = _Alias(\"Iterator\")\nGenerator = _Alias(\"Generator\")\nAsyncIterator = _Alias(\"AsyncIterator\")\nAsyncGenerator = _Alias(\"AsyncGenerator\")\nAwaitable = _Alias(\"Awaitable\")\nCoroutine = _Alias(\"Coroutine\")\nSequence = _Alias(\"Sequence\")\nMutableSequence = _Alias(\"MutableSequence\")\nMapping = _Alias(\"Mapping\")\nMutableMapping = _Alias(\"MutableMapping\")\nAbstractSet = _Alias(\"AbstractSet\")\nMutableSet = _Alias(\"MutableSet\")\nCollection = _Alias(\"Collection\")\nContainer = _Alias(\"Container\")\nHashable = _Alias(\"Hashable\")\nSized = _Alias(\"Sized\")\nReversible = _Alias(\"Reversible\")\nKeysView = _Alias(\"KeysView\")\nValuesView = _Alias(\"ValuesView\")\nItemsView = _Alias(\"ItemsView\")\nIO = _Alias(\"IO\")\nTextIO = _Alias(\"TextIO\")\nBinaryIO = _Alias(\"BinaryIO\")\nPattern = _Alias(\"Pattern\")\nMatch = _Alias(\"Match\")\nSupportsInt = _Alias(\"SupportsInt\")\nSupportsFloat = _Alias(\"SupportsFloat\")\nSupportsIndex = _Alias(\"SupportsIndex\")\nSupportsAbs = _Alias(\"SupportsAbs\")\nSupportsRound = _Alias(\"SupportsRound\")\nSupportsComplex = _Alias(\"SupportsComplex\")\nSupportsBytes = _Alias(\"SupportsBytes\")\nAnyStr = _Alias(\"AnyStr\")\nText = str\n\n\ndef _deque(*args):\n    import collections\n    return collections.deque(*args)\n\n\ndef _defaultdict(*args):\n    import collections\n    return collections.defaultdict(*args)\n\n\ndef _counter(*args):\n    import collections\n    return collections.Counter(*args)\n\n\ndef _ordereddict(*args):\n    import collections\n    return collections.OrderedDict(*args)\n\n\nDeque = _Builtin(\"Deque\", _deque)\nDefaultDict = _Builtin(\"DefaultDict\", _defaultdict)\nCounter = _Builtin(\"Counter\", _counter)\nOrderedDict = _Builtin(\"OrderedDict\", _ordereddict)\nChainMap = _Alias(\"ChainMap\")\n\n\nclass TypeVar:\n    def __init__(self, name, *constraints, bound=None, covariant=False, contravariant=False, infer_variance=False, default=None):\n        self.__name__ = name\n        self.__constraints__ = constraints\n        self.__bound__ = bound\n        self.__covariant__ = covariant\n        self.__contravariant__ = contravariant\n        self.__default__ = default\n        self.__infer_variance__ = infer_variance\n\n    def __or__(self, other):\n        return Union[self, other]\n\n    def __ror__(self, other):\n        return Union[other, self]\n\n    def __repr__(self):\n        if self.__infer_variance__:\n            return self.__name__\n        if self.__covariant__:\n            return \"+\" + self.__name__\n        if self.__contravariant__:\n            return \"-\" + self.__name__\n        return \"~\" + self.__name__\n\n\nclass ParamSpec(TypeVar):\n    def __repr__(self):\n        return \"~\" + self.__name__\n\n\nclass TypeVarTuple(TypeVar):\n    def __repr__(self):\n        return self.__name__\n\n\nclass TypeAliasType:\n    def __init__(self, name, value, *, type_params=()):\n        self.__name__ = name\n        self.__value__ = value\n        self.__type_params__ = type_params\n\n    def __getitem__(self, params):\n        return self\n\n    def __repr__(self):\n        return self.__name__\n\n\nclass Generic:\n    def __class_getitem__(cls, params):\n        return cls\n\n\nclass Protocol(Generic):\n    pass\n\n\ndef runtime_checkable(cls):\n    return cls\n\n\ndef cast(typ, val):\n    return val\n\n\ndef assert_type(val, typ):\n    return val\n\n\ndef reveal_type(obj):\n    return obj\n\n\ndef assert_never(arg):\n    raise AssertionError(\"Expected code to be unreachable\")\n\n\ndef overload(func):\n    return func\n\n\ndef final(f):\n    return f\n\n\ndef override(method):\n    return method\n\n\ndef no_type_check(arg):\n    return arg\n\n\ndef get_overloads(func):\n    return []\n\n\ndef get_type_hints(obj, globalns=None, localns=None, include_extras=False):\n    return dict(getattr(obj, \"__annotations__\", {}) or {})\n\n\ndef get_origin(tp):\n    return getattr(tp, \"__origin__\", None)\n\n\ndef get_args(tp):\n    return getattr(tp, \"__args__\", ())\n\n\ndef NewType(name, tp):\n    def new_type(x):\n        return x\n    new_type.__name__ = name\n    new_type.__supertype__ = tp\n    return new_type\n\n\ndef NamedTuple(typename, fields=None, **kwargs):\n    import collections\n    if fields is None:\n        fields = list(kwargs.items())\n    return collections.namedtuple(typename, [f[0] for f in fields])\n\n\nclass TypedDict(dict):\n    pass\n"
            return s17
        }
        if (name == "unittest") {
            def s18@(optional):string "# SPDX-License-Identifier: MIT\n#\n# unittest for the Ranger Python runtime: TestCase with the assert methods,\n# skips, expected failures, subTest, setUp/tearDown/cleanups, TestResult,\n# TestSuite, TestLoader and main(). Written against CPython's documented\n# behaviour, not copied from it.\n\nimport sys\n\n\nclass SkipTest(Exception):\n    pass\n\n\ndef _id(obj):\n    return obj\n\n\ndef skip(reason):\n    def decorator(obj):\n        obj.__unittest_skip__ = True\n        obj.__unittest_skip_why__ = reason\n        return obj\n    if callable(reason) and not isinstance(reason, str):\n        fn = reason\n        reason = \"\"\n        return decorator(fn)\n    return decorator\n\n\ndef skipIf(condition, reason):\n    if condition:\n        return skip(reason)\n    return _id\n\n\ndef skipUnless(condition, reason):\n    if not condition:\n        return skip(reason)\n    return _id\n\n\ndef expectedFailure(fn):\n    fn.__unittest_expecting_failure__ = True\n    return fn\n\n\ndef _safe_repr(obj):\n    try:\n        return repr(obj)\n    except Exception:\n        return object.__repr__(obj)\n\n\ndef _matches(pattern, text):\n    # a regular expression is matched as text with its escapes removed\n    # (there is no re module yet); a pattern with other syntax matches\n    if pattern is None:\n        return True\n    if not isinstance(pattern, str):\n        pattern = getattr(pattern, \"pattern\", str(pattern))\n    special = \"^$*+?{}[]|()\"\n    plain = \"\"\n    i = 0\n    while i < len(pattern):\n        ch = pattern[i]\n        if ch == \"\\\\\" and i + 1 < len(pattern):\n            plain += pattern[i + 1]\n            i += 2\n            continue\n        if ch in special:\n            return True\n        if ch == \".\":\n            return True\n        plain += ch\n        i += 1\n    return plain in text\n\n\nclass _AssertRaisesContext:\n    def __init__(self, expected, test_case, regex=None, msg=None):\n        self.expected = expected\n        self.test_case = test_case\n        self.regex = regex\n        self.msg = msg\n        self.exception = None\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, exc_type, exc_value, tb):\n        if exc_type is None:\n            try:\n                name = self.expected.__name__\n            except AttributeError:\n                name = str(self.expected)\n            raise self.test_case.failureException(self.msg or (name + \" not raised\"))\n        if not issubclass(exc_type, self.expected):\n            return False\n        self.exception = exc_value\n        if self.regex is not None and not _matches(self.regex, str(exc_value)):\n            raise self.test_case.failureException('\"%s\" does not match \"%s\"' % (self.regex, str(exc_value)))\n        return True\n\n\nclass _AssertWarnsContext:\n    def __init__(self, expected, test_case):\n        self.expected = expected\n        self.test_case = test_case\n        self.warning = None\n        self.warnings = []\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, exc_type, exc_value, tb):\n        return False\n\n\nclass _SubTest:\n    def __init__(self, case, msg, params):\n        self.case = case\n        self.msg = msg\n        self.params = params\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, exc_type, exc_value, tb):\n        if exc_type is None:\n            return False\n        if issubclass(exc_type, SkipTest):\n            return True\n        if issubclass(exc_type, (KeyboardInterrupt, SystemExit)):\n            return False\n        self.case._subtest_failures.append((exc_type, exc_value))\n        return True\n\n\nclass TestCase:\n    failureException = AssertionError\n    longMessage = True\n    maxDiff = 640\n\n    def __init__(self, methodName=\"runTest\"):\n        self._testMethodName = methodName\n        self._cleanups = []\n        self._subtest_failures = []\n\n    def __repr__(self):\n        return \"<%s testMethod=%s>\" % (type(self).__name__, self._testMethodName)\n\n    def __str__(self):\n        return \"%s (%s)\" % (self._testMethodName, type(self).__name__)\n\n    def id(self):\n        return type(self).__name__ + \".\" + self._testMethodName\n\n    def shortDescription(self):\n        return None\n\n    def setUp(self):\n        pass\n\n    def tearDown(self):\n        pass\n\n    @classmethod\n    def setUpClass(cls):\n        pass\n\n    @classmethod\n    def tearDownClass(cls):\n        pass\n\n    def addCleanup(self, function, *args, **kwargs):\n        self._cleanups.append((function, args, kwargs))\n\n    def enterContext(self, cm):\n        result = cm.__enter__()\n        self.addCleanup(cm.__exit__, None, None, None)\n        return result\n\n    def doCleanups(self):\n        while self._cleanups:\n            function, args, kwargs = self._cleanups.pop()\n            function(*args, **kwargs)\n\n    def skipTest(self, reason):\n        raise SkipTest(reason)\n\n    def subTest(self, msg=None, **params):\n        return _SubTest(self, msg, params)\n\n    def run(self, result=None):\n        if result is None:\n            result = TestResult()\n        result.startTest(self)\n        method = getattr(self, self._testMethodName)\n        cls_skip = getattr(type(self), \"__unittest_skip__\", False)\n        if cls_skip or getattr(method, \"__unittest_skip__\", False):\n            why = getattr(method, \"__unittest_skip_why__\", \"\") or getattr(type(self), \"__unittest_skip_why__\", \"\")\n            result.addSkip(self, why)\n            result.stopTest(self)\n            return result\n        expecting = getattr(method, \"__unittest_expecting_failure__\", False)\n        outcome = None\n        try:\n            self.setUp()\n        except SkipTest as e:\n            outcome = (\"skip\", str(e))\n        except Exception as e:\n            outcome = (\"error\", e)\n        if outcome is None:\n            try:\n                method()\n            except SkipTest as e:\n                outcome = (\"skip\", str(e))\n            except AssertionError as e:\n                outcome = (\"fail\", e)\n            except Exception as e:\n                outcome = (\"error\", e)\n            if outcome is None and self._subtest_failures:\n                et, ev = self._subtest_failures[0]\n                if issubclass(et, AssertionError):\n                    outcome = (\"fail\", ev)\n                else:\n                    outcome = (\"error\", ev)\n            try:\n                self.tearDown()\n            except Exception as e:\n                if outcome is None:\n                    outcome = (\"error\", e)\n        try:\n            self.doCleanups()\n        except Exception as e:\n            if outcome is None:\n                outcome = (\"error\", e)\n        if outcome is None:\n            if expecting:\n                result.addUnexpectedSuccess(self)\n            else:\n                result.addSuccess(self)\n        elif outcome[0] == \"skip\":\n            result.addSkip(self, outcome[1])\n        elif expecting:\n            result.addExpectedFailure(self, outcome[1])\n        elif outcome[0] == \"fail\":\n            result.addFailure(self, outcome[1])\n        else:\n            result.addError(self, outcome[1])\n        result.stopTest(self)\n        return result\n\n    def __call__(self, *args, **kwds):\n        return self.run(*args, **kwds)\n\n    def debug(self):\n        self.setUp()\n        getattr(self, self._testMethodName)()\n        self.tearDown()\n        self.doCleanups()\n\n    # ---- assertions\n\n    def _formatMessage(self, msg, standardMsg):\n        if msg is None:\n            return standardMsg\n        if not self.longMessage:\n            return msg\n        return \"%s : %s\" % (standardMsg, msg)\n\n    def fail(self, msg=None):\n        raise self.failureException(msg)\n\n    def assertTrue(self, expr, msg=None):\n        if not expr:\n            self.fail(self._formatMessage(msg, \"%s is not true\" % _safe_repr(expr)))\n\n    def assertFalse(self, expr, msg=None):\n        if expr:\n            self.fail(self._formatMessage(msg, \"%s is not false\" % _safe_repr(expr)))\n\n    def assertEqual(self, first, second, msg=None):\n        if not first == second:\n            self.fail(self._formatMessage(msg, \"%s != %s\" % (_safe_repr(first), _safe_repr(second))))\n\n    def assertNotEqual(self, first, second, msg=None):\n        if not first != second:\n            self.fail(self._formatMessage(msg, \"%s == %s\" % (_safe_repr(first), _safe_repr(second))))\n\n    assertEquals = assertEqual\n    assertNotEquals = assertNotEqual\n    failUnless = assertTrue\n    failIf = assertFalse\n\n    def assertListEqual(self, first, second, msg=None):\n        self.assertIsInstance(first, list, msg)\n        self.assertIsInstance(second, list, msg)\n        self.assertEqual(first, second, msg)\n\n    def assertTupleEqual(self, first, second, msg=None):\n        self.assertIsInstance(first, tuple, msg)\n        self.assertIsInstance(second, tuple, msg)\n        self.assertEqual(first, second, msg)\n\n    def assertDictEqual(self, first, second, msg=None):\n        self.assertIsInstance(first, dict, msg)\n        self.assertIsInstance(second, dict, msg)\n        self.assertEqual(first, second, msg)\n\n    def assertSetEqual(self, first, second, msg=None):\n        self.assertEqual(set(first), set(second), msg)\n\n    def assertSequenceEqual(self, first, second, msg=None, seq_type=None):\n        if seq_type is not None:\n            self.assertIsInstance(first, seq_type, msg)\n            self.assertIsInstance(second, seq_type, msg)\n        self.assertEqual(list(first), list(second), msg)\n\n    def assertMultiLineEqual(self, first, second, msg=None):\n        self.assertEqual(first, second, msg)\n\n    def assertCountEqual(self, first, second, msg=None):\n        a = list(first)\n        b = list(second)