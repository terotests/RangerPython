        if (name == "shlex") {
            def s24@(optional):string "# SPDX-License-Identifier: MIT\n# shlex for the Ranger Python runtime: split, quote and join\nimport re\n\n_find_unsafe = re.compile(r\"[^\\w@%+=:,./-]\", re.ASCII).search\n\n\ndef quote(s):\n    if not s:\n        return \"''\"\n    if _find_unsafe(s) is None:\n        return s\n    return \"'\" + s.replace(\"'\", \"'\\\"'\\\"'\") + \"'\"\n\n\ndef join(split_command):\n    return \" \".join(quote(arg) for arg in split_command)\n\n\ndef split(s, comments=False, posix=True):\n    if s is None:\n        raise ValueError(\"s argument must not be None\")\n    out = []\n    cur = []\n    have = False\n    i = 0\n    n = len(s)\n    while i < n:\n        c = s[i]\n        if c in \" \\t\\r\\n\":\n            if have:\n                out.append(\"\".join(cur))\n                cur = []\n                have = False\n            i += 1\n        elif comments and c == \"#\":\n            while i < n and s[i] != \"\\n\":\n                i += 1\n        elif c == \"'\":\n            j = s.find(\"'\", i + 1)\n            if j < 0:\n                raise ValueError(\"No closing quotation\")\n            cur.append(s[i + 1:j])\n            have = True\n            i = j + 1\n        elif c == '\"':\n            i += 1\n            while True:\n                if i >= n:\n                    raise ValueError(\"No closing quotation\")\n                if s[i] == '\"':\n                    break\n                if s[i] == \"\\\\\" and i + 1 < n and s[i + 1] in '\"\\\\$`\\n':\n                    cur.append(s[i + 1])\n                    i += 2\n                    continue\n                cur.append(s[i])\n                i += 1\n            have = True\n            i += 1\n        elif c == \"\\\\\" and posix:\n            if i + 1 < n:\n                cur.append(s[i + 1])\n            have = True\n            i += 2\n        else:\n            cur.append(c)\n            have = True\n            i += 1\n    if have:\n        out.append(\"