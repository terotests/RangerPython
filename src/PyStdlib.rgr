   simplefilter(self._action, self._category)\n        if self._record:\n            _log = []\n            return _log\n        return None\n\n    def __exit__(self, *exc):\n        global _log\n        _filters[:] = self._saved[0]\n        _log = self._saved[1]\n        return False\n"
