        if (name == "marshal") {
            def s100@(optional):string "# SPDX-License-Identifier: MIT\n# marshal for the Ranger Python runtime: CPython's format for the plain\n# value types (code objects are not supported).\nimport struct as _struct\n\nversion = 4\n\n_NULL = b\"0\"\n\n\ndef _w_long(out, n):\n    out += _struct.pack(\"<i\", n)\n\n\ndef _dump(v, out, ver):\n    if v is None:\n        out += b\"N\"\n    elif v is StopIteration:\n        out += b\"S\"\n    elif v is ...:\n        out += b\".\"\n    elif v is False:\n        out += b\"F\"\n    elif v is True:\n        out += b\"T\"\n    elif type(v) is int:\n        if -2**31 <= v < 2**31:\n            out += b\"i\"\n            _w_long(out, v)\n        else:\n            out += b\"l\"\n            sign = -1 if v < 0 else 1\n            m = abs(v)\n            digits = []\n            while m:\n                digits.append(m & 0x7FFF)\n                m >>= 15\n            _w_long(out, sign * len(digits))\n            for d in digits:\n                out += _struct.pack(\"<H\", d)\n    elif type(v) is float:\n        out += b\"g\" + _struct.pack(\"<d\", v)\n    elif type(v) is complex:\n        out += b\"y\" + _struct.pack(\"<d\", v.real) + _struct.pack(\"<d\", v.imag)\n    elif type(v) is str:\n        b = v.encode(\"utf-8\", \"surrogatepass\")\n        if ver >= 4 and v.isascii() and len(b) < 256:\n            out += b\"z\" + bytes([len(b)]) + b\n        else:\n            out += b\"u\"\n            _w_long(out, len(b))\n            out += b\n    elif type(v) in (bytes, bytearray, memoryview):\n        b = bytes(v)\n        out += b\"s\"\n        _w_long(out, len(b))\n        out += b\n    elif type(v) is tuple:\n        if ver >= 4 and len(v) < 256:\n            out += b\")\" + bytes([len(v)])\n        else:\n            out += b\"(\"\n            _w_long(out, len(v))\n        for x in v:\n            _dump(x, out, ver)\n    elif type(v) is list:\n        out += b\"[\"\n        _w_long(out, len(v))\n        for x in v:\n            _dump(x, out, ver)\n    elif type(v) is dict:\n        out += b\"{\"\n        for k, x in v.items():\n            _dump(k, out, ver)\n            _dump(x, out, ver)\n        out += _NULL\n    elif type(v) in (set, frozenset):\n        out += b\"<\" if type(v) is set else b\">\"\n        _w_long(out, len(v))\n        for x in v:\n            _dump(x, out, ver)\n    else:\n        raise ValueError(\"unmarshallable object\")\n\n\ndef dumps(value, version=version, /, *, allow_code=True):\n    out = bytearray()\n    _dump(value, out, version)\n    return bytes(out)\n\n\ndef dump(value, file, version=version, /, *, allow_code=True):\n    file.write(dumps(value, version))\n\n\nclass _Reader:\n    def __init__(self, data):\n        self.data = data\n        self.pos = 0\n        self.refs = []\n\n    def take(self, n):\n        if self.pos + n > len(self.data):\n            raise EOFError(\"marshal data too short\")\n        b = self.data[self.pos:self.pos + n]\n        self.pos += n\n        return b\n\n    def long(self):\n        return _struct.unpack(\"<i\", self.take(4))[0]\n\n    def load(self):\n        if self.pos >= len(self.data):\n            raise EOFError(\"EOF read where object expected\")\n        code = self.data[self.pos]\n        self.pos += 1\n        flag = code & 0x80\n        t = chr(code & 0x7F)\n        idx = None\n        if flag and t in \"([{<>)ilgysuzZaAtfc\":\n            idx = len(self.refs)\n            self.refs.append(None)\n        v = self._value(t, idx)\n        if idx is not None:\n            self.refs[idx] = v\n        return v\n\n    def _value(self, t, idx):\n        if t == \"N\":\n            return None\n        if t == \"F\":\n            return False\n        if t == \"T\":\n            return True\n        if t == \"S\":\n            return StopIteration\n        if t == \".\":\n            return ...\n        if t == \"i\":\n            return self.long()\n        if t == \"l\":\n            n = self.long()\n            r = 0\n            for i in range(abs(n)):\n                r |= _struct.unpack(\"<H\", self.take(2))[0] << (15 * i)\n            return -r if n < 0 else r\n        if t == \"g\":\n            return _struct.unpack(\"<d\", self.take(8))[0]\n        if t == \"y\":\n            re = _struct.unpack(\"<d\", self.take(8))[0]\n            return complex(re, _struct.unpack(\"<d\", self.take(8))[0])\n        if t == \"s\":\n            return bytes(self.take(self.long()))\n        if t in \"ut\":\n            return bytes(self.take(self.long())).decode(\"utf-8\", \"surrogatepass\")\n        if t in \"aA\":\n            return bytes(self.take(self.long())).decode(\"latin-1\")\n        if t in \"zZ\":\n            return bytes(self.take(self.take(1)[0])).decode(\"latin-1\")\n        if t == \")\":\n            n = self.take(1)[0]\n            return tuple(self.load() for _ in range(n))\n        if t == \"(\":\n            n = self.long()\n            return tuple(self.load() for _ in range(n))\n        if t == \"[\":\n            n = self.long()\n            r = []\n            if idx is not None:\n                self.refs[idx] = r\n            for _ in range(n):\n                r.append(self.load())\n            return r\n        if t == \"{\":\n            r = {}\n            if idx is not None:\n                self.refs[idx] = r\n            while True:\n                if self.pos < len(self.data) and self.data[self.pos] == 0x30:\n                    self.pos += 1\n                    return r\n                k = self.load()\n                r[k] = self.load()\n        if t in \"<>\":\n            n = self.long()\n            items = [self.load() for _ in range(n)]\n            return set(items) if t == \"<\" else frozenset(items)\n        if t == \"r\":\n            n = self.long()\n            if not 0 <= n < len(self.refs) or self.refs[n] is None:\n                raise ValueError(\"bad marshal data (invalid reference)\")\n            return self.refs[n]\n        raise ValueError(\"bad marshal data (unknown type code)\")\n\n\ndef loads(data, /, *, allow_code=True):\n    return _Reader(bytes(data)).load()\n\n\ndef load(file, /, *, allow_code=True):\n    r = _Reader(file.read())\n    return r.load()\n"
            return s100
        }
        if (name == "numbers") {
            def s101@(optional):string "# SPDX-License-Identifier: MIT\n# numbers for the Ranger Python runtime: the numeric tower as classes that\n# answer isinstance() for the built-in numbers and for registered classes\n\n\ndef _tower(cls, builtins):\n    cls._registry = []\n    cls._builtins = builtins\n\n    def instancecheck(c, obj):\n        return subclasscheck(c, type(obj))\n\n    def subclasscheck(c, sub):\n        if sub is bool:\n            sub = int\n        if sub in c._builtins:\n            return True\n        for base in getattr(sub, \"__mro__\", (sub,)):\n            if base is c:\n                return True\n            for t in _all:\n                if c in t.__mro__ and (base in t._registry):\n                    return True\n        return False\n\n    def register(c, sub):\n        c._registry.append(sub)\n        return sub\n    cls.__instancecheck__ = classmethod(instancecheck)\n    cls.__subclasscheck__ = classmethod(subclasscheck)\n    cls.register = classmethod(register)\n    _all.append(cls)\n    return cls\n\n\n_all = []\n\n\nclass Number:\n    __slots__ = ()\n    __hash__ = None\n\n\nclass Complex(Number):\n    __slots__ = ()\n\n    def __bool__(self):\n        return self != 0\n\n    @property\n    def real(self):\n        raise NotImplementedError\n\n    @property\n    def imag(self):\n        raise NotImplementedError\n\n\nclass Real(Complex):\n    __slots__ = ()\n\n    def __complex__(self):\n        return complex(float(self))\n\n    @property\n    def real(self):\n        return +self\n\n    @property\n    def imag(self):\n        return 0\n\n    def conjugate(self):\n        return +self\n\n    def __divmod__(self, other):\n        return (self // other, self % other)\n\n    def __rdivmod__(self, other):\n        return (other // self, other % self)\n\n\nclass Rational(Real):\n    __slots__ = ()\n\n    def __float__(self):\n        return int(self.numerator) / int(self.denominator)\n\n\nclass Integral(Rational):\n    __slots__ = ()\n\n    def __float__(self):\n        return float(int(self))\n\n    def __index__(self):\n        return int(self)\n\n    @property\n    def numerator(self):\n        return +self\n\n    @property\n    def denominator(self):\n        return 1\n\n\n_tower(Number, (int, float, complex))\n_tower(Complex, (int, float, complex))\n_tower(Real, (int, float))\n_tower(Rational, (int,))\n_tower(Integral, (int,))\n"
            return s101
        }
        if (name == "operator") {
            def s102@(optional):string "# SPDX-License-Identifier: MIT\n# operator for the Ranger Python runtime.\n\ndef lt(a, b): return a < b\ndef le(a, b): return a <= b\ndef eq(a, b): return a == b\ndef ne(a, b): return a != b\ndef ge(a, b): return a >= b\ndef gt(a, b): return a > b\ndef not_(a): return not a\ndef truth(a): return bool(a)\ndef is_(a, b): return a is b\ndef is_not(a, b): return a is not b\ndef is_none(a): return a is None\ndef is_not_none(a): return a is not None\ndef abs(a): return __builtins_abs(a)\ndef add(a, b): return a + b\ndef and_(a, b): return a & b\ndef floordiv(a, b): return a // b\ndef index(a):\n    if isinstance(a, int):\n        return int.__index__(a)\n    m = getattr(type(a), \"__index__\", None)\n    if m is None:\n        raise TypeError(\"'%s' object cannot be interpreted as an integer\" % type(a).__name__)\n    r = m(a)\n    if type(r) is int:\n        return r\n    if not isinstance(r, int):\n        raise TypeError(\"__index__ returned non-int (type %s)\" % type(r).__name__)\n    import warnings\n    warnings.warn(\"__index__ returned non-int (type %s).  The ability to return an instance of a strict subclass of int is deprecated, and may be removed in a future version of Python.\" % type(r).__name__, DeprecationWarning, stacklevel=2)\n    return int.__index__(r)\ndef inv(a): return ~a\ninvert = inv\ndef lshift(a, b): return a << b\ndef mod(a, b): return a % b\ndef mul(a, b): return a * b\ndef matmul(a, b): return a @ b\ndef neg(a): return -a\ndef or_(a, b): return a | b\ndef pos(a): return +a\ndef pow(a, b): return a ** b\ndef rshift(a, b): return a >> b\ndef sub(a, b): return a - b\ndef truediv(a, b): return a / b\ndef xor(a, b): return a ^ b\ndef concat(a, b): return a + b\ndef contains(a, b): return b in a\ndef countOf(a, b):\n    n = 0\n    for x in a:\n        if x is b or x == b:\n            n += 1\n    return n\ndef delitem(a, b): del a[b]\ndef getitem(a, b): return a[b]\ndef indexOf(a, b):\n    for i, x in enumerate(a):\n        if x is b or x == b:\n            return i\n    raise ValueError(\"sequence.index(x): x not in sequence\")\ndef setitem(a, b, c): a[b] = c\ndef length_hint(obj, default=0):\n    if not isinstance(default, int):\n        raise TypeError(f\"'{type(default).__name__}' object cannot be interpreted as an integer\")\n    try:\n        return len(obj)\n    except TypeError:\n        pass\n    try:\n        hint = type(obj).__length_hint__\n    except AttributeError:\n        return default\n    try:\n        val = hint(obj)\n    except TypeError:\n        return default\n    if val is NotImplemented:\n        return default\n    if not isinstance(val, int):\n        raise TypeError(f\"__length_hint__ must be an integer, not {type(val).__name__}\")\n    if val < 0:\n        raise ValueError(\"__length_hint__() should return >= 0\")\n    return val\ndef iadd(a, b):\n    a += b\n    return a\ndef isub(a, b):\n    a -= b\n    return a\ndef imul(a, b):\n    a *= b\n    return a\ndef iconcat(a, b):\n    a += b\n    return a\n\ndef __builtins_abs(a):\n    return a if a >= 0 else -a\n\n\nclass attrgetter:\n    def __init__(self, attr, *attrs):\n        self._attrs = (attr,) + attrs\n\n    def __call__(self, obj):\n        out = []\n        for name in self._attrs:\n            v = obj\n            for part in name.split(\".\"):\n                v = getattr(v, part)\n            out.append(v)\n        if len(out) == 1:\n            return out[0]\n        return tuple(out)\n\n\nclass itemgetter:\n    def __init__(self, item, *items):\n        self._items = (item,) + items\n\n    def __call__(self, obj):\n        if len(self._items) == 1:\n            return obj[self._items[0]]\n        return tuple(obj[i] for i in self._items)\n\n\nclass methodcaller:\n    def __init__(self, name, *args, **kwargs):\n        self._name = name\n        self._args = args\n        self._kwargs = kwargs\n\n    def __call__(self, obj):\n        return getattr(obj, self._name)(*self._args, **self._kwargs)\n\n\n# the dunder aliases CPython's operator module also exports\nfor _name in (\"abs\", \"add\", \"and_\", \"call\", \"concat\", \"contains\", \"delitem\", \"eq\", \"floordiv\",\n              \"ge\", \"getitem\", \"gt\", \"iadd\", \"iand\", \"iconcat\", \"ifloordiv\", \"ilshift\",\n              \"imatmul\", \"imod\", \"imul\", \"index\", \"inv\", \"invert\", \"ior\", \"ipow\", \"irshift\",\n              \"isub\", \"itruediv\", \"ixor\", \"le\", \"lshift\", \"lt\", \"matmul\", \"mod\", \"mul\", \"ne\",\n              \"neg\", \"not_\", \"or_\", \"pos\", \"pow\", \"rshift\", \"setitem\", \"sub\", \"truediv\", \"xor\"):\n    if _name in globals():\n        globals()[\"__\" + _name.rstrip(\"_\") + \"__\"] = globals()[_name]\ndel _name\n"
            return s102
        }
        if (name == "pickle") {
            def s103@(optional):string "# SPDX-License-Identifier: MIT\n# pickle for the Ranger Python runtime: dumps() keeps a deep copy of the\n# value behind a small bytes key, and loads() copies it back out.\nimport copy as _copy\n\nHIGHEST_PROTOCOL = 5\nDEFAULT_PROTOCOL = 5\n_store = {}\n\n\nclass PickleError(Exception):\n    pass\n\n\nclass PicklingError(PickleError):\n    pass\n\n\nclass UnpicklingError(PickleError):\n    pass\n\n\ndef dumps(obj, protocol=None, *, fix_imports=True, buffer_callback=None):\n    key = len(_store)\n    _store[key] = _copy.deepcopy(obj)\n    return (\"\\x80pickle:%d.\" % key).encode(\"latin-1\")\n\n\ndef loads(data, /, *, fix_imports=True, encoding=\"ASCII\", errors=\"strict\", buffers=()):\n    text = data if isinstance(data, str) else data.decode(\"latin-1\")\n    if not text.startswith(\"\\x80pickle:\"):\n        raise UnpicklingError(\"invalid load key\")\n    return _copy.deepcopy(_store[int(text[8:-1])])\n\n\ndef dump(obj, file, protocol=None, **kw):\n    file.write(dumps(obj, protocol))\n\n\ndef load(file, **kw):\n    return loads(file.read())\n"
            return s103
        }
        if (name == "platform") {
            def s104@(optional):string "# SPDX-License-Identifier: MIT\n# platform for the Ranger Python runtime\nimport sys\n\n\ndef python_implementation():\n    return \"RangerPython\"\n\n\ndef python_version():\n    return \"%d.%d.%d\" % sys.version_info[:3]\n\n\ndef python_version_tuple():\n    return tuple(str(x) for x in sys.version_info[:3])\n\n\ndef system():\n    return \"\"\n\n\ndef machine():\n    return \"\"\n\n\ndef node():\n    return \"\"\n\n\ndef release():\n    return \"\"\n\n\ndef version():\n    return \"\"\n\n\ndef platform(aliased=False, terse=False):\n    return \"ranger\"\n\n\ndef architecture(executable=None, bits=\"\", linkage=\"\"):\n    return (\"64bit\", \"\")\n\n\ndef uname():\n    return (\"\", \"\", \"\", \"\", \"\", \"\")\n\n\ndef libc_ver(*args, **kw):\n    return (\"\", \"\")\n\n\ndef mac_ver(*args, **kw):\n    return (\"\", (\"\", \"\", \"\"), \"\")\n\n\ndef win32_ver(*args, **kw):\n    return (\"\", \"\", \"\", \"\")\n\n\ndef python_compiler():\n    return \"Ranger\"\n"
            return s104
        }
        if (name == "re") {
            def s105@(optional):string "# SPDX-License-Identifier: MIT\n# re for the Ranger Python runtime: a backtracking regular expression\n# engine written in Python, so it runs the same on every target. A pattern\n# is parsed to a tree, compiled to a small instruction list, and run by a\n# loop with an explicit backtrack stack (no recursion per character).\n\n__all__ = [\"match\", \"fullmatch\", \"search\", \"sub\", \"subn\", \"split\", \"findall\",\n           \"finditer\", \"compile\", \"purge\", \"escape\", \"error\", \"Pattern\", \"Match\",\n           \"A\", \"I\", \"L\", \"M\", \"S\", \"X\", \"U\", \"ASCII\", \"IGNORECASE\", \"LOCALE\",\n           \"MULTILINE\", \"DOTALL\", \"VERBOSE\", \"UNICODE\", \"NOFLAG\", \"RegexFlag\"]\n\n\nclass RegexFlag(int):\n    def __or__(self, other):\n        if isinstance(other, int):\n            return RegexFlag(int(self) | int(other))\n        return NotImplemented\n\n    __ror__ = __or__\n\n    def __and__(self, other):\n        if isinstance(other, int):\n            return RegexFlag(int(self) & int(other))\n        return NotImplemented\n\n    __rand__ = __and__\n\n    def __xor__(self, other):\n        if isinstance(other, int):\n            return RegexFlag(int(self) ^ int(other))\n        return NotImplemented\n\n    def __invert__(self):\n        return RegexFlag(~int(self) & 511)\n\n    def __repr__(self):\n        v = int(self)\n        if v == 0:\n            return \"re.NOFLAG\"\n        parts = []\n        for name, bit in _FLAG_NAMES:\n            if v & bit:\n                parts.append(\"re.\" + name)\n                v &= ~bit\n        if v:\n            parts.append(hex(v))\n        return \"|\".join(parts)\n\n    __str__ = __repr__\n\n    @property\n    def name(self):\n        for n, bit in _FLAG_NAMES:\n            if int(self) == bit:\n                return n\n        return None\n\n    @property\n    def value(self):\n        return int(self)\n\n\n_FLAG_NAMES = [(\"TEMPLATE\", 1), (\"IGNORECASE\", 2), (\"LOCALE\", 4), (\"MULTILINE\", 8),\n               (\"DOTALL\", 16), (\"UNICODE\", 32), (\"VERBOSE\", 64), (\"DEBUG\", 128),\n               (\"ASCII\", 256)]\nNOFLAG = RegexFlag(0)\nIGNORECASE = I = RegexFlag(2)\nLOCALE = L = RegexFlag(4)\nMULTILINE = M = RegexFlag(8)\nDOTALL = S = RegexFlag(16)\nUNICODE = U = RegexFlag(32)\nVERBOSE = X = RegexFlag(64)\nDEBUG = RegexFlag(128)\nASCII = A = RegexFlag(256)\n_INLINE = {\"a\": 256, \"i\": 2, \"L\": 4, \"m\": 8, \"s\": 16, \"u\": 32, \"x\": 64}\n\n\nclass error(Exception):\n    def __init__(self, msg, pattern=None, pos=None):\n        self.msg = msg\n        self.pattern = pattern\n        self.pos = pos\n        if pattern is not None and pos is not None:\n            self.lineno = pattern.count(\"\\n\", 0, pos) + 1\n            self.colno = pos - (pattern.rfind(\"\\n\", 0, pos) + 1) + 1\n            if \"\\n\" in pattern:\n                msg = \"%s at position %d (line %d, column %d)\" % (msg, pos, self.lineno, self.colno)\n            else:\n                msg = \"%s at position %d\" % (msg, pos)\n        else:\n            self.lineno = self.colno = None\n        Exception.__init__(self, msg)\n\n\nPatternError = error\n\n# ---- parsing: pattern text to a tree of tuples\n#   (\"lit\", ch, icase)  (\"any\", dotall)  (\"set\", neg, items, icase, ascii)\n#   (\"cat\", [nodes])  (\"alt\", [nodes])  (\"group\", n, node)\n#   (\"rep\", node, lo, hi, mode)  (\"at\", kind, multiline, ascii)\n#   (\"look\", ahead, neg, node)  (\"atomic\", node)  (\"bref\", n, icase)\n#   (\"cond\", n, yes, no)\n\n_DIGITS = \"0123456789\"\n_HEX = \"0123456789abcdefABCDEF\"\n_WS = \" \\t\\n\\r\\v\\f\"\n_REPEAT = \"*+?{\"\n_SPECIAL = \".^$*+?{}[]\\\\|()\"\n\n\nclass _Parser:\n    def __init__(self, pattern, flags):\n        self.p = pattern\n        self.i = 0\n        self.flags = flags\n        self.groups = 1\n        self.names = {}\n        self.open = []\n        self.lookbehind = 0\n        self.scan_global_flags()\n\n    def err(self, msg, pos=None):\n        raise error(msg, self.p, self.i if pos is None else pos)\n\n    def scan_global_flags(self):\n        # (?flags) is only allowed at the start, and applies to all of it\n        p = self.p\n        i = 0\n        while p.startswith(\"(?\", i):\n            j = i + 2\n            while j < len(p) and p[j] in _INLINE:\n                j += 1\n            if j < len(p) and p[j] == \")\" and j > i + 2:\n                for c in p[i + 2:j]:\n                    self.flags |= _INLINE[c]\n                i = j + 1\n            else:\n                break\n\n    def peek(self):\n        return self.p[self.i] if self.i < len(self.p) else \"\"\n\n    def skip_verbose(self, flags):\n        if not flags & 64:\n            return\n        p = self.p\n        while self.i < len(p):\n            c = p[self.i]\n            if c in _WS:\n                self.i += 1\n            elif c == \"#\":\n                while self.i < len(p) and p[self.i] != \"\\n\":\n                    self.i += 1\n            else:\n                break\n\n    def parse(self):\n        node = self.alt(self.flags)\n        if self.i < len(self.p):\n            if self.p[self.i] == \")\":\n                self.err(\"unbalanced parenthesis\")\n            self.err(\"unexpected end\")\n        return node\n\n    def alt(self, flags):\n        items = [self.seq(flags)]\n        while self.peek() == \"|\":\n            self.i += 1\n            items.append(self.seq(flags))\n        if len(items) == 1:\n            return items[0]\n        return (\"alt\", items)\n\n    def seq(self, flags):\n        items = []\n        while True:\n            self.skip_verbose(flags)\n            c = self.peek()\n            if c == \"\" or c == \"|\" or c == \")\":\n                break\n            start = self.i\n            atom = self.atom(flags)\n            if atom is None:\n                continue\n            atom = self.repeats(atom, flags, start)\n            items.append(atom)\n        if len(items) == 1:\n            return items[0]\n        return (\"cat\", items)\n\n    def repeats(self, atom, flags, start):\n        self.skip_verbose(flags)\n        c = self.peek()\n        if c == \"\" or c not in _REPEAT:\n            return atom\n        here = self.i\n        lo, hi = self.quant()\n        if lo is None:\n            return atom\n        if atom[0] == \"at\" or (atom[0] == \"cat\" and not atom[1]):\n            self.err(\"nothing to repeat\", here)\n        if atom[0] == \"look\":\n            pass\n        mode = \"greedy\"\n        if self.peek() == \"?\":\n            self.i += 1\n            mode = \"lazy\"\n        elif self.peek() == \"+\":\n            self.i += 1\n            mode = \"poss\"\n        node = (\"rep\", atom, lo, hi, mode)\n        self.skip_verbose(flags)\n        c = self.peek()\n        if c and c in \"*+?\" or (c == \"{\" and self.is_quant(self.i)):\n            self.err(\"multiple repeat\", self.i)\n        return node\n\n    def is_quant(self, i):\n        p = self.p\n        j = i + 1\n        while j < len(p) and p[j] in _DIGITS:\n            j += 1\n        if j < len(p) and p[j] == \",\":\n            j += 1\n            while j < len(p) and p[j] in _DIGITS:\n                j += 1\n        return j < len(p) and p[j] == \"}\"\n\n    def quant(self):\n        c = self.p[self.i]\n        if c == \"*\":\n            self.i += 1\n            return 0, None\n        if c == \"+\":\n            self.i += 1\n            return 1, None\n        if c == \"?\":\n            self.i += 1\n            return 0, 1\n        # {m,n}; anything else is a literal \"{\"\n        if not self.is_quant(self.i):\n            return None, None\n        here = self.i\n        j = self.p.index(\"}\", self.i)\n        body = self.p[self.i + 1:j]\n        self.i = j + 1\n        if \",\" in body:\n            a, b = body.split(\",\", 1)\n            lo = int(a) if a else 0\n            hi = int(b) if b else None\n        else:\n            lo = hi = int(body)\n        if hi is not None and hi < lo:\n            self.err(\"min repeat greater than max repeat\", here + 1)\n        if lo >= 4294967295 or (hi is not None and hi >= 4294967295):\n            raise OverflowError(\"the repetition number is too large\")\n        return lo, hi\n\n    def atom(self, flags):\n        p = self.p\n        c = p[self.i]\n        if c == \"(\":\n            return self.group(flags)\n        if c == \"[\":\n            return self.charset(flags)\n        if c == \".\":\n            self.i += 1\n            return (\"any\", bool(flags & 16))\n        if c == \"^\":\n            self.i += 1\n            return (\"at\", \"^\", bool(flags & 8), False)\n        if c == \"$\":\n            self.i += 1\n            return (\"at\", \"$\", bool(flags & 8), False)\n        if c == \"\\\\\":\n            return self.escape(flags, False)\n        if c in \"*+?\":\n            self.err(\"nothing to repeat\")\n        if c == \"{\" and self.is_quant(self.i):\n            self.err(\"nothing to repeat\")\n        self.i += 1\n        return (\"lit\", c, bool(flags & 2))\n\n    def group_name(self, end):\n        j = self.p.find(end, self.i)\n        if j < 0:\n            self.err(\"missing %s, unterminated name\" % end)\n        name = self.p[self.i:j]\n        if not name:\n            self.err(\"missing group name\")\n        if not name.isidentifier():\n            self.err(\"bad character in group name %r\" % name)\n        self.i = j + 1\n        return name\n\n    def group(self, flags):\n        p = self.p\n        start = self.i\n        self.i += 1\n        if p.startswith(\"?\", self.i):\n            self.i += 1\n            c = self.peek()\n            if c == \"P\":\n                self.i += 1\n                c2 = self.peek()\n                if c2 == \"<\":\n                    self.i += 1\n                    name = self.group_name(\">\")\n                    if name in self.names:\n                        self.err(\"redefinition of group name %r as group %d; was group %d\" % (name, self.groups, self.names[name]), start + 4)\n                    n = self.new_group()\n                    self.names[name] = n\n                    return self.group_body((\"group\", n), flags, start)\n                if c2 == \"=\":\n                    self.i += 1\n                    here = self.i\n                    name = self.group_name(\")\")\n                    if name not in self.names:\n                        self.err(\"unknown group name %r\" % name, here)\n                    n = self.names[name]\n                    if n in self.open:\n                        self.err(\"cannot refer to an open group\", start)\n                    return (\"bref\", n, bool(flags & 2))\n                if c2 == \"\":\n                    self.err(\"unexpected end of pattern\")\n                self.err(\"unknown extension ?P\" + c2, start + 1)\n            if c == \":\":\n                self.i += 1\n                return self.group_body(None, flags, start)\n            if c == \"#\":\n                j = p.find(\")\", self.i)\n                if j < 0:\n                    self.err(\"missing ), unterminated comment\", start)\n                self.i = j + 1\n                return None\n            if c == \"=\" or c == \"!\":\n                self.i += 1\n                return self.group_body((\"look\", True, c == \"!\"), flags, start)\n            if c == \"<\":\n                self.i += 1\n                c2 = self.peek()\n                if c2 == \"=\" or c2 == \"!\":\n                    self.i += 1\n                    self.lookbehind += 1\n                    node = self.group_body((\"look\", False, c2 == \"!\"), flags, start)\n                    self.lookbehind -= 1\n                    lo, hi = _width(node[3])\n                    if lo != hi:\n                        self.err(\"look-behind requires fixed-width pattern\", start)\n                    return node\n                if c2 and (c2.isalpha() or c2 == \"_\"):\n                    name = self.group_name(\">\")\n                    if name in self.names:\n                        self.err(\"redefinition of group name %r as group %d; was group %d\" % (name, self.groups, self.names[name]), start + 3)\n                    n = self.new_group()\n                    self.names[name] = n\n                    return self.group_body((\"group\", n), flags, start)\n                if c2 == \"\":\n                    self.err(\"unexpected end of pattern\")\n                self.err(\"unknown extension ?<\" + c2, start + 1)\n            if c == \">\":\n                self.i += 1\n                return self.group_body((\"atomic\",), flags, start)\n            if c == \"(\":\n                self.i += 1\n                here = self.i\n                j = p.find(\")\", self.i)\n                if j < 0:\n                    self.err(\"missing ), unterminated name\")\n                ref = p[self.i:j]\n                self.i = j + 1\n                if ref.isdigit():\n                    n = int(ref)\n                    if n == 0:\n                        self.err(\"bad group number\", here)\n                elif ref.isidentifier():\n                    if ref not in self.names:\n                        self.err(\"unknown group name %r\" % ref, here)\n                    n = self.names[ref]\n                else:\n                    self.err(\"bad character in group name %r\" % ref, here)\n                yes = self.seq(flags)\n                no = (\"cat\", [])\n                if self.peek() == \"|\":\n                    self.i += 1\n                    no = self.seq(flags)\n                    if self.peek() == \"|\":\n                        self.err(\"conditional backref with more than two branches\")\n                if self.peek() != \")\":\n                    self.err(\"missing ), unterminated subpattern\", start)\n                self.i += 1\n                if n >= 100:\n                    self.err(\"invalid group reference %d\" % n, here)\n                return (\"cond\", n, yes, no)\n            # inline flags, scoped (?i:...) or global (?i)\n            add = 0\n            rem = 0\n            neg = False\n            while True:\n                c = self.peek()\n                if c in _INLINE and c != \"\":\n                    if neg:\n                        if c not in \"imsx\":\n                            self.err(\"bad inline flags: cannot turn off flags 'a', 'u' and 'L'\")\n                        rem |= _INLINE[c]\n                    else:\n                        add |= _INLINE[c]\n                    self.i += 1\n                elif c == \"-\" and not neg:\n                    neg = True\n                    self.i += 1\n                    if self.peek() not in _INLINE or self.peek() == \"\":\n                        self.err(\"missing flag\" if self.peek() in \":)\" else \"unknown flag\")\n                else:\n                    break\n            if (add & 256) and (add & 32):\n                self.err(\"bad inline flags: flags 'a', 'u' and 'L' are incompatible\")\n            c = self.peek()\n            if c == \")\":\n                if neg:\n                    self.err(\"missing :\")\n                if start != 0 and not self.at_global_prefix(start):\n                    self.err(\"global flags not at the start of the expression\", start)\n                self.i += 1\n                return None\n            if c == \":\":\n                self.i += 1\n                nf = (flags | add) & ~rem\n                return self.group_body(None, nf, start)\n            if c == \"\":\n                self.err(\"missing -, : or )\")\n            if add == 0 and rem == 0 and not neg:\n                self.err(\"unknown extension ?\" + c, start + 1)\n            self.err(\"unknown flag\" if c.isalpha() else \"missing -, : or )\")\n        n = self.new_group()\n        return self.group_body((\"group\", n), flags, start)\n\n    def at_global_prefix(self, start):\n        # every (?flags) before this one at the very start is also global\n        i = 0\n        p = self.p\n        while i < start:\n            if not p.startswith(\"(?\", i):\n                return False\n            j = p.find(\")\", i)\n            i = j + 1\n        return i == start\n\n    def new_group(self):\n        n = self.groups\n        self.groups += 1\n        if self.groups > 101:\n            pass\n        return n\n\n    def group_body(self, kind, flags, start):\n        if kind is not None and kind[0] == \"group\":\n            self.open.append(kind[1])\n        node = self.alt(flags)\n        if self.peek() != \")\":\n            self.err(\"missing ), unterminated subpattern\", start)\n        self.i += 1\n        if kind is None:\n            return node\n        if kind[0] == \"group\":\n            self.open.pop()\n            return (\"group\", kind[1], node)\n        if kind[0] == \"look\":\n            return (\"look\", kind[1], kind[2], node)\n        return (\"atomic\", node)\n\n    def escape_char(self, inset):\n        # an escape that stands for one character, or None\n        p = self.p\n        start = self.i\n        c = p[self.i + 1] if self.i + 1 < len(p) else \"\"\n        if c == \"\":\n            self.err(\"bad escape (end of pattern)\")\n        simple = {\"n\": \"\\n\", \"t\": \"\\t\", \"r\": \"\\r\", \"f\": \"\\f\", \"v\": \"\\v\", \"a\": \"\\a\", \"\\\\\": \"\\\\\"}\n        if c in simple:\n            self.i += 2\n            return simple[c]\n        if inset and c == \"b\":\n            self.i += 2\n            return \"\\b\"\n        if c == \"x\":\n            h = p[self.i + 2:self.i + 4]\n            if len(h) < 2 or not all(ch in _HEX for ch in h):\n                self.err(\"incomplete escape \\\\x\" + h)\n            self.i += 4\n            return chr(int(h, 16))\n        if c == \"u\" or c == \"U\":\n            k = 4 if c == \"u\" else 8\n            h = p[self.i + 2:self.i + 2 + k]\n            if len(h) < k or not all(ch in _HEX for ch in h):\n                self.err(\"incomplete escape \\\\%s%s\" % (c, h))\n            v = int(h, 16)\n            if v > 0x10FFFF:\n                self.err(\"bad escape \\\\%s%s\" % (c, h))\n            self.i += 2 + k\n            return chr(v)\n        if c == \"N\":\n            if not p.startswith(\"{\", self.i + 2):\n                self.err(\"missing {\", self.i + 2)\n            j = p.find(\"}\", self.i + 3)\n            if j < 0:\n                self.err(\"missing }, unterminated name\", self.i + 3)\n            name = p[self.i + 3:j]\n            if not name:\n                self.err(\"missing character name\", self.i + 3)\n            try:\n                import unicodedata\n                ch = unicodedata.lookup(name)\n            except Exception:\n                try:\n                    ch = eval('\"\\\\N{' + name + '}\"')\n                except Exception:\n                    self.err(\"undefined character name %r\" % name)\n            self.i = j + 1\n            return ch\n        if c == \"0\":\n            j = self.i + 2\n            while j < len(p) and j < self.i + 4 and p[j] in \"01234567\":\n                j += 1\n            v = int(p[self.i + 1:j], 8)\n            self.i = j\n            return chr(v)\n        if c in \"1234567\" and inset:\n            j = self.i + 1\n            while j < len(p) and j < self.i + 4 and p[j] in \"01234567\":\n                j += 1\n            v = int(p[self.i + 1:j], 8)\n            if v > 0o377:\n                self.err(\"octal escape value \\\\%s outside of range 0-0o377\" % p[self.i + 1:j])\n            self.i = j\n            return chr(v)\n        if c.isalnum() and c.isascii():\n            return None\n        self.i += 2\n        return c\n\n    def escape(self, flags, inset):\n        p = self.p\n        start = self.i\n        c = p[self.i + 1] if self.i + 1 < len(p) else \"\"\n        icase = bool(flags & 2)\n        asc = bool(flags & 256)\n        if c in \"dDwWsS\" and c:\n            self.i += 2\n            return (\"set\", False, [(\"cls\", c)], icase, asc)\n        if c in \"AZbB\" and c:\n            self.i += 2\n            return (\"at\", c, False, asc)\n        if c and c in \"123456789\":\n            # a back reference, or an octal escape of three digits\n            j = self.i + 1\n            if (j + 2 < len(p) + 0 and p[j] in \"01234567\" and p[j + 1:j + 2] and p[j + 1] in \"01234567\"\n                    and p[j + 2:j + 3] and p[j + 2] in \"01234567\"):\n                v = int(p[j:j + 3], 8)\n                if v > 0o377:\n                    self.err(\"octal escape value \\\\%s outside of range 0-0o377\" % p[j:j + 3])\n                self.i = j + 3\n                return (\"lit\", chr(v), icase)\n            k = j\n            while k < len(p) and k < j + 2 and p[k] in _DIGITS:\n                k += 1\n            n = int(p[j:k])\n            self.i = k\n            if n >= self.groups:\n                self.err(\"invalid group reference %d\" % n, j)\n            if n in self.open:\n                self.err(\"cannot refer to an open group\", start)\n            return (\"bref\", n, icase)\n        ch = self.escape_char(False)\n        if ch is None:\n            self.err(\"bad escape \\\\\" + c)\n        return (\"lit\", ch, icase)\n\n    def charset(self, flags):\n        p = self.p\n        start = self.i\n        self.i += 1\n        neg = False\n        if self.peek() == \"^\":\n            neg = True\n            self.i += 1\n        items = []\n        first = True\n        while True:\n            if self.i >= len(p):\n                self.err(\"unterminated character set\", start)\n            c = p[self.i]\n            if c == \"]\" and not first:\n                self.i += 1\n                break\n            first = False\n            here = self.i\n            lo = self.set_item(flags)\n            if lo[0] == \"ch\" and p.startswith(\"-\", self.i) and self.i + 1 < len(p) and p[self.i + 1] != \"]\":\n                self.i += 1\n                hi = self.set_item(flags)\n                if hi[0] != \"ch\":\n                    self.err(\"bad character range %s\" % p[here:self.i], here)\n                if ord(hi[1]) < ord(lo[1]):\n                    self.err(\"bad character range %s\" % p[here:self.i], here)\n                items.append((\"range\", lo[1], hi[1]))\n            else:\n                items.append(lo)\n        return (\"set\", neg, items, bool(flags & 2), bool(flags & 256))\n\n    def set_item(self, flags):\n        p = self.p\n        c = p[self.i]\n        if c == \"\\\\\":\n            d = p[self.i + 1] if self.i + 1 < len(p) else \"\"\n            if d and d in \"dDwWsS\":\n                self.i += 2\n                return (\"cls\", d)\n            ch = self.escape_char(True)\n            if ch is None:\n                self.err(\"bad escape \\\\\" + d)\n            return (\"ch\", ch)\n        self.i += 1\n        return (\"ch\", c)\n\n\ndef _width(node):\n    k = node[0]\n    if k == \"lit\" or k == \"any\" or k == \"set\":\n        return 1, 1\n    if k == \"cat\":\n        lo = hi = 0\n        for n in node[1]:\n            a, b = _width(n)\n            lo += a\n            hi = None if hi is None or b is None else hi + b\n        return lo, hi\n    if k == \"alt\":\n        ws = [_width(n) for n in node[1]]\n        lo = min(w[0] for w in ws)\n        his = [w[1] for w in ws]\n        return lo, None if None in his else max(his)\n    if k == \"group\" or k == \"atomic\":\n        return _width(node[-1])\n    if k == \"rep\":\n        a, b = _width(node[1])\n        hi = None if node[3] is None or b is None else b * node[3]\n        return a * node[2], hi\n    if k == \"at\" or k == \"look\":\n        return 0, 0\n    if k == \"bref\":\n        return 0, None\n    if k == \"cond\":\n        a = _width(node[2])\n        b = _width(node[3])\n        return min(a[0], b[0]), (None if a[1] is None or b[1] is None else max(a[1], b[1]))\n    return 0, 0\n\n\n# ---- compiling the tree to instructions\n_CHAR, _ANY, _SET, _SPLIT, _JMP, _SAVE, _AT, _BREF, _LOOK, _ATOMIC, _COND, _MARK, _PROG, _MATCH = range(14)\n\n\nclass _Compiler:\n    def __init__(self, nslots):\n        self.code = []\n        self.nslots = nslots\n        self.marks = 0\n\n    def emit(self, *ins):\n        self.code.append(list(ins))\n        return len(self.code) - 1\n\n    def sub(self, node):\n        c = _Compiler(self.nslots)\n        c.marks = self.marks\n        c.node(node)\n        c.emit(_MATCH)\n        self.marks = c.marks\n        return c.code\n\n    def node(self, n):\n        k = n[0]\n        if k == \"lit\":\n            if n[2] and n[1].lower() != n[1].upper():\n                self.emit(_SET, False, [(\"ch\", n[1])], True, False)\n            else:\n                self.emit(_CHAR, n[1])\n        elif k == \"any\":\n            self.emit(_ANY, n[1])\n        elif k == \"set\":\n            self.emit(_SET, n[1], n[2], n[3], n[4])\n        elif k == \"cat\":\n            for x in n[1]:\n                self.node(x)\n        elif k == \"alt\":\n            jumps = []\n            items = n[1]\n            for idx in range(len(items)):\n                if idx < len(items) - 1:\n                    sp = self.emit(_SPLIT, 0, 0)\n                    self.code[sp][1] = len(self.code)\n                    self.node(items[idx])\n                    jumps.append(self.emit(_JMP, 0))\n                    self.code[sp][2] = len(self.code)\n                else:\n                    self.node(items[idx])\n            for j in jumps:\n                self.code[j][1] = len(self.code)\n        elif k == \"group\":\n            self.emit(_SAVE, 2 * n[1])\n            self.node(n[2])\n            self.emit(_SAVE, 2 * n[1] + 1)\n        elif k == \"at\":\n            self.emit(_AT, n[1], n[2], n[3])\n        elif k == \"bref\":\n            self.emit(_BREF, n[1], n[2])\n        elif k == \"look\":\n            w = _width(n[3])[0] if not n[1] else 0\n            self.emit(_LOOK, self.sub(n[3]), n[1], n[2], w)\n        elif k == \"atomic\":\n            self.emit(_ATOMIC, self.sub(n[1]))\n        elif k == \"cond\":\n            c = self.emit(_COND, n[1], 0)\n            self.node(n[2])\n            j = self.emit(_JMP, 0)\n            self.code[c][2] = len(self.code)\n            self.node(n[3])\n            self.code[j][1] = len(self.code)\n        elif k == \"rep\":\n            self.rep(n)\n\n    def rep(self, n):\n        body, lo, hi, mode = n[1], n[2], n[3], n[4]\n        if mode == \"poss\":\n            self.emit(_ATOMIC, self.sub((\"rep\", body, lo, hi, \"greedy\")))\n            return\n        lazy = mode == \"lazy\"\n        nullable = _width(body)[0] == 0\n        for _ in range(lo):\n            self.node(body)\n        if hi is None:\n            # L: split body, out; body; jmp L\n            top = len(self.code)\n            sp = self.emit(_SPLIT, 0, 0)\n            mark = None\n            first = len(self.code)\n            if nullable:\n                mark = self.nslots + self.marks\n                self.marks += 1\n                self.emit(_MARK, mark)\n            self.node(body)\n            prog = None\n            if nullable:\n                prog = self.emit(_PROG, mark, 0)\n            self.emit(_JMP, top)\n            out = len(self.code)\n            if prog is not None:\n                self.code[prog][2] = out\n            self.code[sp][1], self.code[sp][2] = (out, first) if lazy else (first, out)\n        else:\n            splits = []\n            for _ in range(hi - lo):\n                sp = self.emit(_SPLIT, 0, 0)\n                splits.append((sp, len(self.code)))\n                self.node(body)\n            out = len(self.code)\n            for sp, first in splits:\n                self.code[sp][1], self.code[sp][2] = (out, first) if lazy else (first, out)\n\n\ndef _is_word(ch, asc):\n    if asc:\n        return ch.isascii() and (ch.isalnum() or ch == \"_\")\n    return ch.isalnum() or ch == \"_\"\n\n\ndef _in_cls(ch, cls, asc):\n    if cls == \"d\":\n        return (\"0\" <= ch <= \"9\") if asc else ch.isdigit() and ch.isdecimal()\n    if cls == \"D\":\n        return not _in_cls(ch, \"d\", asc)\n    if cls == \"w\":\n        return _is_word(ch, asc)\n    if cls == \"W\":\n        return not _is_word(ch, asc)\n    if cls == \"s\":\n        if asc:\n            return ch in _WS\n        return ch.isspace() or ch in \"\\x1c\\x1d\\x1e\\x1f\\x85\"\n    return not _in_cls(ch, \"s\", asc)\n\n\ndef _in_set(ch, items, icase, asc):\n    for it in items:\n        k = it[0]\n        if k == \"ch\":\n            if ch == it[1]:\n                return True\n            if icase and (not asc or ch < \"\\x80\") and (ch.lower() == it[1].lower() or ch.upper() == it[1].upper()):\n                return True\n        elif k == \"range\":\n            if it[1] <= ch <= it[2]:\n                return True\n            if icase and (not asc or ch < \"\\x80\"):\n                # sre folds with the simple (one-character) case mappings;\n                # U+0130 is the only character whose full lowercase is longer\n                lo = ch.lower()[0]\n                up = ch.upper()\n                if it[1] <= lo <= it[2] or (len(up) == 1 and it[1] <= up <= it[2]):\n                    return True\n        elif _in_cls(ch, it[1], asc):\n            return True\n    return False\n\n\ndef _run(code, s, start, end, sv, avoid):\n    # one match attempt at start; returns (end, slots) or None. avoid is a\n    # position where an empty match is not accepted (after an empty match)\n    stack = [(0, start, sv)]\n    while stack:\n        pc, i, sv = stack.pop()\n        while True:\n            ins = code[pc]\n            op = ins[0]\n            if op == _CHAR:\n                if i < end and s[i] == ins[1]:\n                    i += 1\n                    pc += 1\n                    continue\n                break\n            if op == _SET:\n                if i < end and _in_set(s[i], ins[2], ins[3], ins[4]) != ins[1]:\n                    i += 1\n                    pc += 1\n                    continue\n                break\n            if op == _SPLIT:\n                stack.append((ins[2], i, sv))\n                pc = ins[1]\n                continue\n            if op == _JMP:\n                pc = ins[1]\n                continue\n            if op == _ANY:\n                if i < end and (ins[1] or s[i] != \"\\n\"):\n                    i += 1\n                    pc += 1\n                    continue\n                break\n            if op == _SAVE:\n                sv = sv[:]\n                sv[ins[1]] = i\n                if ins[1] & 1:\n                    sv[-1] = ins[1] >> 1\n                pc += 1\n                continue\n            if op == _MARK:\n                sv = sv[:]\n                sv[ins[1]] = i\n                pc += 1\n                continue\n            if op == _PROG:\n                # an iteration that matched nothing ends the loop\n                if sv[ins[1]] == i:\n                    pc = ins[2]\n                else:\n                    pc += 1\n                continue\n            if op == _MATCH:\n                if avoid is not None and i == start == avoid:\n                    break\n                return i, sv\n            if op == _AT:\n                if _at(ins[1], ins[2], ins[3], s, i, end):\n                    pc += 1\n                    continue\n                break\n            if op == _BREF:\n                a = sv[2 * ins[1]]\n                b = sv[2 * ins[1] + 1]\n                if a < 0 or b < 0:\n                    break\n                g = s[a:b]\n                if ins[2]:\n                    if s[i:i + len(g)].lower() == g.lower() and i + len(g) <= end:\n                        i += len(g)\n                        pc += 1\n                        continue\n                    break\n                if i + len(g) <= end and s.startswith(g, i):\n                    i += len(g)\n                    pc += 1\n                    continue\n                break\n            if op == _LOOK:\n                if ins[2]:\n                    at = i\n                else:\n                    at = i - ins[4]\n                if at < 0:\n                    r = None\n                else:\n                    r = _run(ins[1], s, at, end if ins[2] else i, sv, None)\n                    if r is not None and not ins[2] and r[0] != i:\n                        r = None\n                if ins[3]:\n                    if r is not None:\n                        break\n                else:\n                    if r is None:\n                        break\n                    sv = r[1]\n                pc += 1\n                continue\n            if op == _ATOMIC:\n                r = _run(ins[1], s, i, end, sv, None)\n                if r is None:\n                    break\n                i, sv = r\n                pc += 1\n                continue\n            if op == _COND:\n                if sv[2 * ins[1] + 1] >= 0:\n                    pc += 1\n                else:\n                    pc = ins[2]\n                continue\n            break\n    return None\n\n\ndef _at(kind, ml, asc, s, i, end):\n    if kind == \"^\":\n        return i == 0 or (ml and s[i - 1] == \"\\n\")\n    if kind == \"$\":\n        if ml:\n            return i == end or s[i] == \"\\n\"\n        return i == end or (i == end - 1 and s[i] == \"\\n\")\n    if kind == \"A\":\n        return i == 0\n    if kind == \"Z\":\n        return i == end\n    a = i > 0 and _is_word(s[i - 1], asc)\n    b = i < end and _is_word(s[i], asc)\n    if kind == \"b\":\n        return a != b\n    return a == b\n\n\nclass Pattern:\n    def __init__(self, pattern, flags):\n        if isinstance(flags, RegexFlag) is False:\n            flags = RegexFlag(flags)\n        if not isinstance(pattern, str):\n            raise TypeError(\"first argument must be string or compiled pattern\")\n        if flags & 256 and flags & 32:\n            raise ValueError(\"ASCII and UNICODE flags are incompatible\")\n        if flags & 4:\n            raise ValueError(\"cannot use LOCALE flag with a str pattern\")\n        ps = _Parser(pattern, int(flags))\n        tree = ps.parse()\n        self.pattern = pattern\n        self.flags = RegexFlag(ps.flags | (0 if ps.flags & 256 else 32))\n        self.groups = ps.groups - 1\n        self.groupindex = dict(ps.names)\n        nslots = 2 * ps.groups\n        c = _Compiler(nslots)\n        c.node(tree)\n        c.emit(_MATCH)\n        self._code = c.code\n        self._slots = [-1] * (nslots + c.marks + 1)\n        # a pattern that starts with a plain character can skip ahead to it\n        self._first = c.code[0][1] if c.code[0][0] == _CHAR else None\n\n    def __repr__(self):\n        fl = int(self.flags) & ~32\n        r = repr(self.pattern)\n        if len(r) > 200:\n            r = r[:200]\n        if fl:\n            return \"re.compile(%s, %r)\" % (r, RegexFlag(fl))\n        return \"re.compile(%s)\" % r\n\n    def __eq__(self, other):\n        if not isinstance(other, Pattern):\n            return NotImplemented\n        return self.pattern == other.pattern and self.flags == other.flags\n\n    def __hash__(self):\n        return hash((self.pattern, int(self.flags)))\n\n    def __copy__(self):\n        return self\n\n    def __deepcopy__(self, memo):\n        return self\n\n    def __class_getitem__(cls, item):\n        import types\n        return types.GenericAlias(cls, item)\n\n    def _bounds(self, string, pos, endpos):\n        if not isinstance(string, str):\n            raise TypeError(\"expected string or bytes-like object, got '%s'\" % type(string).__name__)\n        n = len(string)\n        if pos < 0:\n            pos = 0\n        if endpos is None or endpos > n:\n            endpos = n\n        if pos > endpos:\n            pos = endpos\n        return pos, endpos\n\n    def _at(self, string, i, endpos, avoid=None):\n        r = _run(self._code, string, i, endpos, self._slots, avoid)\n        if r is None:\n            return None\n        return r\n\n    def _search(self, string, pos, endpos, avoid=None):\n        i = pos\n        first = self._first\n        while i <= endpos:\n            if first is not None:\n                i = string.find(first, i, endpos)\n                if i < 0:\n                    return None\n            r = _run(self._code, string, i, endpos, self._slots, avoid)\n            if r is not None:\n                return Match(self, string, pos, endpos, i, r[0], r[1])\n            i += 1\n        return None\n\n    def match(self, string, pos=0, endpos=None):\n        pos, endpos = self._bounds(string, pos, endpos)\n        r = _run(self._code, string, pos, endpos, self._slots, None)\n        if r is None:\n            return None\n        return Match(self, string, pos, endpos, pos, r[0], r[1])\n\n    def fullmatch(self, string, pos=0, endpos=None):\n        pos, endpos = self._bounds(string, pos, endpos)\n        code = self._full_code()\n        r = _run(code, string, pos, endpos, self._slots, None)\n        if r is None:\n            return None\n        return Match(self, string, pos, endpos, pos, r[0], r[1])\n\n    def _full_code(self):\n        fc = getattr(self, \"_fcode\", None)\n        if fc is None:\n            # the pattern, atomic so far as it must reach the end: append \\Z\n            fc = [list(x) for x in self._code]\n            fc[-1] = [_AT, \"Z\", False, False]\n            fc.append([_MATCH])\n            self._fcode = fc\n        return fc\n\n    def search(self, string, pos=0, endpos=None):\n        pos, endpos = self._bounds(string, pos, endpos)\n        return self._search(string, pos, endpos)\n\n    def finditer(self, string, pos=0, endpos=None):\n        pos, endpos = self._bounds(string, pos, endpos)\n        return iter(self._all(string, pos, endpos, 0))\n\n    def _all(self, string, pos, endpos, count):\n        out = []\n        avoid = None\n        i = pos\n        while i <= endpos:\n            m = self._search(string, i, endpos, avoid)\n            if m is None:\n                break\n            m.pos = pos\n            out.append(m)\n            if count and len(out) >= count:\n                break\n            a, b = m.span()\n            if a == b:\n                avoid = b\n            else:\n                avoid = None\n            i = b\n        return out\n\n    def findall(self, string, pos=0, endpos=None):\n        pos, endpos = self._bounds(string, pos, endpos)\n        out = []\n        for m in self._all(string, pos, endpos, 0):\n            if self.groups == 0:\n                out.append(m.group())\n            elif self.groups == 1:\n                out.append(m.group(1) or \"\")\n            else:\n                out.append(tuple(g or \"\" for g in m.groups()))\n        return out\n\n    def split(self, string, maxsplit=0):\n        pos, endpos = self._bounds(string, 0, None)\n        out = []\n        last = 0\n        for m in self._all(string, 0, endpos, maxsplit if maxsplit > 0 else 0):\n            if maxsplit < 0:\n                break\n            a, b = m.span()\n            out.append(string[last:a])\n            out.extend(m.groups())\n            last = b\n        out.append(string[last:])\n        return out\n\n    def subn(self, repl, string, count=0):\n        pos, endpos = self._bounds(string, 0, None)\n        if callable(repl):\n            fn = repl\n        else:\n            if not isinstance(repl, str):\n                raise TypeError(\"expected str instance, %s found\" % type(repl).__name__)\n            tpl = _template(self, repl)\n            if len(tpl) == 1 and isinstance(tpl[0], str):\n                lit = tpl[0]\n                fn = lambda m: lit\n            else:\n                fn = lambda m: _expand(m, tpl)\n        parts = []\n        last = 0\n        n = 0\n        for m in self._all(string, 0, endpos, count if count > 0 else 0):\n            if count < 0:\n                break\n            a, b = m.span()\n            parts.append(string[last:a])\n            r = fn(m)\n            if r is None:\n                r = \"\"\n            if not isinstance(r, str):\n                raise TypeError(\"expected str instance, %s found\" % type(r).__name__)\n            parts.append(r)\n            last = b\n            n += 1\n        parts.append(string[last:])\n        return \"\".join(parts), n\n\n    def sub(self, repl, string, count=0):\n        return self.subn(repl, string, count)[0]\n\n    def scanner(self, string, pos=0, endpos=None):\n        return _Scanner(self, string, pos, endpos)\n\n\nclass _Scanner:\n    def __init__(self, pattern, string, pos, endpos):\n        self.pattern = pattern\n        self._s = string\n        self._pos, self._end = pattern._bounds(string, pos, endpos)\n        self._avoid = None\n\n    def match(self):\n        if self._pos > self._end:\n            return None\n        r = _run(self.pattern._code, self._s, self._pos, self._end, self.pattern._slots, self._avoid)\n        if r is None:\n            return None\n        m = Match(self.pattern, self._s, self._pos, self._end, self._pos, r[0], r[1])\n        self._avoid = r[0] if r[0] == self._pos else None\n        self._pos = r[0]\n        return m\n\n    def search(self):\n        if self._pos > self._end:\n            return None\n        m = self.pattern._search(self._s, self._pos, self._end, self._avoid)\n        if m is None:\n            self._pos = self._end + 1\n            return None\n        a, b = m.span()\n        self._avoid = b if a == b else None\n        self._pos = b\n        return m\n\n\ndef _template(pattern, repl):\n    # a replacement string as literal parts and group numbers\n    out = []\n    lit = []\n    i = 0\n    n = len(repl)\n    simple = {\"n\": \"\\n\", \"t\": \"\\t\", \"r\": \"\\r\", \"f\": \"\\f\", \"v\": \"\\v\", \"a\": \"\\a\", \"b\": \"\\b\", \"\\\\\": \"\\\\\"}\n    while i < n:\n        c = repl[i]\n        if c != \"\\\\\":\n            lit.append(c)\n            i += 1\n            continue\n        if i + 1 >= n:\n            raise error(\"bad escape (end of pattern)\", repl, i)\n        d = repl[i + 1]\n        if d == \"g\":\n            if not repl.startswith(\"<\", i + 2):\n                raise error(\"missing <\", repl, i + 2)\n            j = repl.find(\">\", i + 3)\n            if j < 0:\n                raise error(\"missing >, unterminated name\", repl, i + 3)\n            name = repl[i + 3:j]\n            if not name:\n                raise error(\"missing group name\", repl, i + 3)\n            if name.isdigit() and name.isascii():\n                g = int(name)\n                if g > pattern.groups:\n                    raise error(\"invalid group reference %d\" % g, repl, i + 3)\n            elif name.isidentifier():\n                if name not in pattern.groupindex:\n                    raise IndexError(\"unknown group name %r\" % name)\n                g = pattern.groupindex[name]\n            else:\n                raise error(\"bad character in group name %r\" % name, repl, i + 3)\n            out.append(\"\".join(lit))\n            lit = []\n            out.append(g)\n            i = j + 1\n        elif d == \"0\":\n            j = i + 2\n            while j < n and j < i + 4 and repl[j] in \"01234567\":\n                j += 1\n            lit.append(chr(int(repl[i + 1:j], 8)))\n            i = j\n        elif d in \"123456789\":\n            j = i + 1\n            if (j + 2 < n + 0 and repl[j] in \"01234567\" and repl[j + 1] in \"01234567\"\n                    and repl[j + 2] in \"01234567\"):\n                v = int(repl[j:j + 3], 8)\n                if v > 0o377:\n                    raise error(\"octal escape value \\\\%s outside of range 0-0o377\" % repl[j:j + 3], repl, i)\n                lit.append(chr(v))\n                i = j + 3\n                continue\n            k = j\n            while k < n and k < j + 2 and repl[k] in _DIGITS:\n                k += 1\n            g = int(repl[j:k])\n            if g > pattern.groups:\n                raise error(\"invalid group reference %d\" % g, repl, j)\n            out.append(\"\".join(lit))\n            lit = []\n            out.append(g)\n            i = k\n        elif d in simple:\n            lit.append(simple[d])\n            i += 2\n        elif d.isascii() and d.isalpha():\n            raise error(\"bad escape \\\\\" + d, repl, i)\n        else:\n            lit.append(\"\\\\\" + d)\n            i += 2\n    out.append(\"\".join(lit))\n    return [x for x in out if x != \"\"] or [\"\"]\n\n\ndef _expand(m, tpl):\n    parts = []\n    for x in tpl:\n        if isinstance(x, str):\n            parts.append(x)\n        else:\n            parts.append(m.group(x) or \"\")\n    return \"\".join(parts)\n\n\nclass Match:\n    def __init__(self, pattern, string, pos, endpos, start, end, slots):\n        self.re = pattern\n        self.string = string\n        self.pos = pos\n        self.endpos = endpos\n        n = pattern.groups + 1\n        sp = [(start, end)]\n        for g in range(1, n):\n            a = slots[2 * g]\n            b = slots[2 * g + 1]\n            sp.append((a, b) if a >= 0 and b >= 0 else (-1, -1))\n        self._spans = sp\n        last = slots[-1] if slots[-1] > 0 else None\n        self.lastindex = last\n        self.lastgroup = None\n        if last is not None:\n            for k, v in pattern.groupindex.items():\n                if v == last:\n                    self.lastgroup = k\n\n    def _index(self, g):\n        if isinstance(g, str):\n            if g in self.re.groupindex:\n                return self.re.groupindex[g]\n            raise IndexError(\"no such group\")\n        if isinstance(g, int) and not isinstance(g, bool) or hasattr(g, \"__index__\"):\n            try:\n                g = g.__index__()\n            except AttributeError:\n                pass\n            if 0 <= g <= self.re.groups:\n                return g\n        raise IndexError(\"no such group\")\n\n    def _get(self, g, default=None):\n        a, b = self._spans[self._index(g)]\n        if a < 0:\n            return default\n        return self.string[a:b]\n\n    def group(self, *args):\n        if not args:\n            return self._get(0)\n        if len(args) == 1:\n            return self._get(args[0])\n        return tuple(self._get(g) for g in args)\n\n    def __getitem__(self, g):\n        return self._get(g)\n\n    def groups(self, default=None):\n        return tuple(self._get(g, default) for g in range(1, self.re.groups + 1))\n\n    def groupdict(self, default=None):\n        return {k: self._get(v, default) for k, v in self.re.groupindex.items()}\n\n    def start(self, group=0):\n        return self._spans[self._index(group)][0]\n\n    def end(self, group=0):\n        return self._spans[self._index(group)][1]\n\n    def span(self, group=0):\n        return self._spans[self._index(group)]\n\n    @property\n    def regs(self):\n        return tuple(self._spans)\n\n    def expand(self, template):\n        return _expand(self, _template(self.re, template))\n\n    def __repr__(self):\n        return \"<re.Match object; span=%r, match=%r>\" % (self.span(), self.group())\n\n    def __bool__(self):\n        return True\n\n    def __copy__(self):\n        return self\n\n    def __deepcopy__(self, memo):\n        return self\n\n    def __class_getitem__(cls, item):\n        import types\n        return types.GenericAlias(cls, item)\n\n\n_cache = {}\n\n\ndef _compile(pattern, flags):\n    if isinstance(pattern, Pattern):\n        if flags:\n            raise ValueError(\"cannot process flags argument with a compiled pattern\")\n        return pattern\n    key = (type(pattern).__name__, pattern, int(flags))\n    p = _cache.get(key)\n    if p is None:\n        p = Pattern(pattern, flags)\n        if len(_cache) >= 512:\n            _cache.clear()\n        _cache[key] = p\n    return p\n\n\ndef compile(pattern, flags=0):\n    return _compile(pattern, flags)\n\n\ndef match(pattern, string, flags=0):\n    return _compile(pattern, flags).match(string)\n\n\ndef fullmatch(pattern, string, flags=0):\n    return _compile(pattern, flags).fullmatch(string)\n\n\ndef search(pattern, string, flags=0):\n    return _compile(pattern, flags).search(string)\n\n\ndef findall(pattern, string, flags=0):\n    return _compile(pattern, flags).findall(string)\n\n\ndef finditer(pattern, string, flags=0):\n    return _compile(pattern, flags).finditer(string)\n\n\ndef sub(pattern, repl, string, count=0, flags=0):\n    return _compile(pattern, flags).sub(repl, string, count)\n\n\ndef subn(pattern, repl, string, count=0, flags=0):\n    return _compile(pattern, flags).subn(repl, string, count)\n\n\ndef split(pattern, string, maxsplit=0, flags=0):\n    return _compile(pattern, flags).split(string, maxsplit)\n\n\ndef purge():\n    _cache.clear()\n\n\n_ALNUM = frozenset(\"_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")\n\n\ndef escape(pattern):\n    out = []\n    for c in pattern:\n        if c in _ALNUM or ord(c) >= 128:\n            out.append(c)\n        elif c == \"\\x00\":\n            out.append(\"\\\\000\" if False else \"\\\\\\x00\")\n        else:\n            out.append(\"\\\\\" + c)\n    return \"\".join(out)\n\n\nclass Scanner:\n    def __init__(self, lexicon, flags=0):\n        self.lexicon = lexicon\n        self._pats = [(compile(p, flags), action) for p, action in lexicon]\n\n    def scan(self, string):\n        result = []\n        i = 0\n        while True:\n            best = None\n            for p, action in self._pats:\n                m = p.match(string, i)\n                if m is not None:\n                    best = (m, action)\n                    break\n            if best is None:\n                break\n            m, action = best\n            j = m.end()\n            if j == i:\n                break\n            if callable(action):\n                self.match = m\n                action = action(self, m.group())\n            if action is not None:\n                result.append(action)\n            i = j\n        return result, string[i:]\n"
            return s105
