        if (name == "string") {
            def s26@(optional):string "# SPDX-License-Identifier: MIT\n# string for the Ranger Python runtime: the constants come from the\n# native _string, Template, Formatter and capwords are written here.\nfrom _string import *\nimport re as _re\n\n__all__ = [\"ascii_letters\", \"ascii_lowercase\", \"ascii_uppercase\", \"capwords\",\n           \"digits\", \"hexdigits\", \"octdigits\", \"printable\", \"punctuation\",\n           \"whitespace\", \"Formatter\", \"Template\"]\n\n\ndef capwords(s, sep=None):\n    return (sep or \" \").join(map(str.capitalize, s.split(sep)))\n\n\nclass Template:\n    delimiter = \"$\"\n    idpattern = r\"(?a:[_a-z][_a-z0-9]*)\"\n    braceidpattern = None\n    flags = _re.IGNORECASE\n\n    def __init_subclass__(cls, **kw):\n        cls.pattern = cls._compile()\n\n    @classmethod\n    def _compile(cls):\n        if \"pattern\" in cls.__dict__ and not isinstance(cls.__dict__[\"pattern\"], str):\n            return cls.__dict__[\"pattern\"]\n        d = _re.escape(cls.delimiter)\n        ident = cls.idpattern.replace(\"(?a:\", \"(?:\")\n        bid = cls.braceidpattern or ident\n        src = cls.__dict__.get(\"pattern\")\n        if not isinstance(src, str):\n            src = (d + r\"(?:(?P<escaped>\" + d + r\")|(?P<named>\" + ident + r\")|\\{(?P<braced>\" + bid +\n                   r\")\\}|(?P<invalid>))\")\n        return _re.compile(src, cls.flags | _re.VERBOSE if src is cls.__dict__.get(\"pattern\") else cls.flags)\n\n    def __init__(self, template):\n        self.template = template\n\n    def _pat(self):\n        p = type(self).__dict__.get(\"pattern\")\n        if p is None or isinstance(p, str):\n            p = type(self)._compile()\n        return p\n\n    def _invalid(self, mo):\n        i = mo.start(\"invalid\")\n        lines = self.template[:i].splitlines(keepends=True)\n        if not lines:\n            colno = 1\n            lineno = 1\n        else:\n            colno = i - len(\"\".join(lines[:-1]))\n            lineno = len(lines)\n        raise ValueError(\"Invalid placeholder in string: line %d, col %d\" % (lineno, colno))\n\n    def substitute(self, mapping=None, /, **kws):\n        if mapping is None:\n            mapping = kws\n        elif kws:\n            m = dict(mapping)\n            m.update(kws)\n            mapping = m\n\n        def convert(mo):\n            named = mo.group(\"named\") or mo.group(\"braced\")\n            if named is not None:\n                return str(mapping[named])\n            if mo.group(\"escaped\") is not None:\n                return self.delimiter\n            if mo.group(\"invalid\") is not None:\n                self._invalid(mo)\n            raise ValueError(\"Unrecognized named group in pattern\", self.pattern)\n        return self._pat().sub(convert, self.template)\n\n    def safe_substitute(self, mapping=None, /, **kws):\n        if mapping is None:\n            mapping = kws\n        elif kws:\n            m = dict(mapping)\n            m.update(kws)\n            mapping = m\n\n        def convert(mo):\n            named = mo.group(\"named\") or mo.group(\"braced\")\n            if named is not None:\n                try:\n                    return str(mapping[named])\n                except KeyError:\n                    return mo.group()\n            if mo.group(\"escaped\") is not None:\n                return self.delimiter\n            if mo.group(\"invalid\") is not None:\n                return mo.group()\n            raise ValueError(\"Unrecognized named group in pattern\", self.pattern)\n        return self._pat().sub(convert, self.template)\n\n    def is_valid(self):\n        for mo in self._pat().finditer(self.template):\n            if mo.group(\"invalid\") is not None:\n                return False\n            if mo.group(\"named\") is None and mo.group(\"braced\") is None and mo.group(\"escaped\") is None:\n                raise ValueError(\"Unrecognized named group in pattern\", self.pattern)\n        return True\n\n    def get_identifiers(self):\n        ids = []\n        for mo in self._pat().finditer(self.template):\n            named = mo.group(\"named\") or mo.group(\"braced\")\n            if named is not None and named not in ids:\n                ids.append(named)\n            elif named is None and mo.group(\"invalid\") is None and mo.group(\"escaped\") is None:\n                raise ValueError(\"Unrecognized named group in pattern\", self.pattern)\n        return ids\n\n\nclass Formatter:\n    def format(self, format_string, /, *args, **kwargs):\n        return self.vformat(format_string, args, kwargs)\n\n    def vformat(self, format_string, args, kwargs):\n        used = set()\n        result, _ = self._vformat(format_string, args, kwargs, used, 2)\n        self.check_unused_args(used, args, kwargs)\n        return result\n\n    def _vformat(self, format_string, args, kwargs, used_args, recursion_depth, auto_arg_index=0):\n        if recursion_depth < 0:\n            raise ValueError(\"Max string recursion exceeded\")\n        result = []\n        for literal_text, field_name, format_spec, conversion in self.parse(format_string):\n            if literal_text:\n                result.append(literal_text)\n            if field_name is not None:\n                if field_name == \"\":\n                    if auto_arg_index is False:\n                        raise ValueError(\"cannot switch from manual field specification to automatic field numbering\")\n                    field_name = str(auto_arg_index)\n                    auto_arg_index += 1\n                elif field_name.isdigit():\n                    if auto_arg_index:\n                        raise ValueError(\"cannot switch from manual field specification to automatic field numbering\")\n                    auto_arg_index = False\n                obj, arg_used = self.get_field(field_name, args, kwargs)\n                used_args.add(arg_used)\n                obj = self.convert_field(obj, conversion)\n                format_spec, auto_arg_index = self._vformat(format_spec, args, kwargs, used_args,\n                                                            recursion_depth - 1, auto_arg_index=auto_arg_index)\n                result.append(self.format_field(obj, format_spec))\n        return \"\".join(result), auto_arg_index\n\n    def get_value(self, key, args, kwargs):\n        if isinstance(key, int):\n            return args[key]\n        return kwargs[key]\n\n    def check_unused_args(self, used_args, args, kwargs):\n        pass\n\n    def format_field(self, value, format_spec):\n        return format(value, format_spec)\n\n    def convert_field(self, value, conversion):\n        if conversion is None:\n            return value\n        if conversion == \"s\":\n            return str(value)\n        if conversion == \"r\":\n            return repr(value)\n        if conversion == \"a\":\n            return ascii(value)\n        raise ValueError(\"Unknown conversion specifier \" + str(conversion))\n\n    def parse(self, format_string):\n        out = []\n        i = 0\n        n = len(format_string)\n        lit = []\n        while i < n:\n            c = format_string[i]\n            if c == \"{\":\n                if i + 1 < n and format_string[i + 1] == \"{\":\n                    lit.append(\"{\")\n                    i += 2\n                    continue\n                depth = 1\n                j = i + 1\n                while j < n and depth:\n                    if format_string[j] == \"{\":\n                        depth += 1\n                    elif format_string[j] == \"}\":\n                        depth -= 1\n                    j += 1\n                if depth:\n                    raise ValueError(\"expected '}' before end of string\")\n                field = format_string[i + 1:j - 1]\n                conv = None\n                spec = \"\"\n                k = 0\n                bracket = 0\n                name_end = len(field)\n                while k < len(field):\n                    ch = field[k]\n                    if ch == \"[\":\n                        bracket += 1\n                    elif ch == \"]\":\n                        bracket -= 1\n                    elif bracket == 0 and ch in \"!:\":\n                        name_end = k\n                        break\n                    k += 1\n                name = field[:name_end]\n                rest = field[name_end:]\n                if rest.startswith(\"!\"):\n                    if len(rest) < 2:\n                        raise ValueError(\"end of string while looking for conversion specifier\")\n                    conv = rest[1]\n                    rest = rest[2:]\n                    if rest and not rest.startswith(\":\"):\n                        raise ValueError(\"expected ':' after conversion specifier\")\n                if rest.startswith(\":\"):\n                    spec = rest[1:]\n                out.append((\"\".join(lit), name, spec, conv))\n                lit = []\n                i = j\n            elif c == \"}\":\n                if i + 1 < n and format_string[i + 1] == \"}\":\n                    lit.append(\"}\")\n                    i += 2\n                    continue\n                raise ValueError(\"Single '}' encountered in format string\")\n            else:\n                lit.append(c)\n                i += 1\n        if lit:\n            out.append((\"\".join(lit), None, None, None))\n        return out\n\n    def get_field(self, field_name, args, kwargs):\n        first = field_name\n        rest = \"\"\n        for k, ch in enumerate(field_name):\n            if ch in \".[\":\n                first = field_name[:k]\n                rest = field_name[k:]\n                break\n        key = int(first) if first.isdigit() else first\n        obj = self.get_value(key, args, kwargs)\n        while rest:\n            if rest[0] == \".\":\n                k = 1\n                while k < len(rest) and rest[k] not in \".[\":\n                    k += 1\n                obj = getattr(obj, rest[1:k])\n                rest = rest[k:]\n            else:\n                k = rest.index(\"]\")\n                idx = rest[1:k]\n                obj = obj[int(idx) if idx.isdigit() else idx]\n                rest = rest[k + 1:]\n        return obj, key\nTemplate.pattern = Template._compile()\n"
            return s26
        }
        if (name == "tempfile") {
            def s27@(optional):string "# SPDX-License-Identifier: MIT\n# tempfile for the Ranger Python runtime, on its file system\nimport os\n\ntempdir = \"/tmp\"\ntemplate = \"tmp\"\n_count = [0]\n\n\ndef gettempdir():\n    return tempdir\n\n\ndef _name(prefix, suffix, dir):\n    _count[0] += 1\n    return os.path.join(dir or tempdir, \"%s%d%s\" % (prefix or template, _count[0], suffix or \"\"))\n\n\ndef mkdtemp(suffix=None, prefix=None, dir=None):\n    path = _name(prefix, suffix, dir)\n    os.makedirs(path, exist_ok=True)\n    return path\n\n\ndef mkstemp(suffix=None, prefix=None, dir=None, text=False):\n    path = _name(prefix, suffix, dir)\n    with open(path, \"w\") as f:\n        f.write(\"\")\n    return (3, path)\n\n\ndef mktemp(suffix=\"\", prefix=template, dir=None):\n    return _name(prefix, suffix, dir)\n\n\nclass TemporaryDirectory:\n    def __init__(self, suffix=None, prefix=None, dir=None, ignore_cleanup_errors=False, *, delete=True):\n        self.name = mkdtemp(suffix, prefix, dir)\n\n    def __enter__(self):\n        return self.name\n\n    def __exit__(self, *exc):\n        self.cleanup()\n\n    def cleanup(self):\n        import shutil\n        shutil.rmtree(self.name, ignore_errors=True)\n\n\ndef NamedTemporaryFile(mode=\"w+b\", buffering=-1, encoding=None, newline=None, suffix=None,\n                       prefix=None, dir=None, delete=True, *, errors=None, delete_on_close=True):\n    path = _name(prefix, suffix, dir)\n    f = open(path, \"w\")\n    return f\n\n\nTemporaryFile = NamedTemporaryFile\n"
            return s27
        }
        if (name == "textwrap") {
            def s28@(optional):string "# SPDX-License-Identifier: MIT\n# textwrap for the Ranger Python runtime: dedent, indent, wrap, fill, shorten.\n\ndef dedent(text):\n    lines = text.split(\"\\n\")\n    margin = None\n    for line in lines:\n        stripped = line.lstrip(\" \\t\")\n        if not stripped:\n            continue\n        ws = line[:len(line) - len(stripped)]\n        if margin is None:\n            margin = ws\n        else:\n            n = 0\n            while n < len(margin) and n < len(ws) and margin[n] == ws[n]:\n                n += 1\n            margin = margin[:n]\n    out = []\n    for line in lines:\n        if not line.strip(\" \\t\"):\n            out.append(line.lstrip(\" \\t\") if line.strip() == \"\" else line)\n        elif margin:\n            out.append(line[len(margin):])\n        else:\n            out.append(line)\n    return \"\\n\".join(\"\" if l.strip() == \"\" else l for l in out)\n\n\ndef indent(text, prefix, predicate=None):\n    if predicate is None:\n        predicate = lambda line: line.strip()\n    out = []\n    for line in text.splitlines(True):\n        out.append(prefix + line if predicate(line) else line)\n    return \"\".join(out)\n\n\ndef wrap(text, width=70, initial_indent=\"\", subsequent_indent=\"\", break_long_words=True, **kwargs):\n    words = text.split()\n    lines = []\n    cur = initial_indent\n    empty = True\n    for w in words:\n        prefix = initial_indent if not lines else subsequent_indent\n        if empty:\n            cand = prefix + w\n        else:\n            cand = cur + \" \" + w\n        if len(cand) <= width or empty and not break_long_words:\n            cur = cand\n            empty = False\n        elif empty:\n            while len(prefix + w) > width:\n                lines.append(prefix + w[:width - len(prefix)])\n                w = w[width - len(prefix):]\n                prefix = subsequent_indent\n            cur = prefix + w\n            empty = False\n        else:\n            lines.append(cur)\n            cur = subsequent_indent + w\n    if not empty:\n        lines.append(cur)\n    return lines\n\n\ndef fill(text, width=70, **kwargs):\n    return \"\\n\".join(wrap(text, width, **kwargs))\n\n\ndef shorten(text, width, placeholder=\" [...]\", **kwargs):\n    text = \" \".join(text.split())\n    if len(text) <= width:\n        return text\n    words = text.split()\n    out = \"\"\n    for w in words:\n        cand = w if not out else out + \" \" + w\n        if len(cand) + len(placeholder) > width:\n            break\n        out = cand\n    return out + placeholder\n"
            return s28
        }
        if (name == "threading") {
            def s29@(optional):string "# SPDX-License-Identifier: MIT\n# threading for the Ranger Python runtime. There is one thread: start()\n# runs the target to the end, and locks never have to wait.\n\n_ident = [1]\n\n\nclass Lock:\n    def __init__(self):\n        self._locked = False\n\n    def acquire(self, blocking=True, timeout=-1):\n        if self._locked:\n            if not blocking:\n                return False\n            raise RuntimeError(\"deadlock: the lock is held and there is only one thread\")\n        self._locked = True\n        return True\n\n    def release(self):\n        if not self._locked:\n            raise RuntimeError(\"release unlocked lock\")\n        self._locked = False\n\n    def locked(self):\n        return self._locked\n\n    def __enter__(self):\n        return self.acquire()\n\n    def __exit__(self, *exc):\n        self.release()\n\n\nclass RLock:\n    def __init__(self):\n        self._count = 0\n\n    def acquire(self, blocking=True, timeout=-1):\n        self._count += 1\n        return True\n\n    def release(self):\n        if not self._count:\n            raise RuntimeError(\"cannot release un-acquired lock\")\n        self._count -= 1\n\n    def __enter__(self):\n        return self.acquire()\n\n    def __exit__(self, *exc):\n        self.release()\n\n\nclass Condition:\n    def __init__(self, lock=None):\n        self._lock = lock or RLock()\n\n    def __enter__(self):\n        return self._lock.__enter__()\n\n    def __exit__(self, *exc):\n        return self._lock.__exit__(*exc)\n\n    def wait(self, timeout=None):\n        return True\n\n    def wait_for(self, predicate, timeout=None):\n        return predicate()\n\n    def notify(self, n=1):\n        pass\n\n    def notify_all(self):\n        pass\n\n\nclass Semaphore:\n    def __init__(self, value=1):\n        self._value = value\n\n    def acquire(self, blocking=True, timeout=None):\n        if self._value <= 0:\n            return False\n        self._value -= 1\n        return True\n\n    def release(self, n=1):\n        self._value += n\n\n    __enter__ = acquire\n\n    def __exit__(self, *exc):\n        self.release()\n\n\nBoundedSemaphore = Semaphore\n\n\nclass Event:\n    def __init__(self):\n        self._flag = False\n\n    def is_set(self):\n        return self._flag\n\n    def set(self):\n        self._flag = True\n\n    def clear(self):\n        self._flag = False\n\n    def wait(self, timeout=None):\n        return self._flag\n\n\nclass local:\n    pass\n\n\nclass Thread:\n    def __init__(self, group=None, target=None, name=None, args=(), kwargs=None, *, daemon=None):\n        self._target = target\n        self._args = args\n        self._kwargs = kwargs or {}\n        _ident[0] += 1\n        self.name = name or \"Thread-%d\" % (_ident[0] - 1)\n        self.ident = None\n        self.daemon = bool(daemon)\n        self._started = False\n        self._done = False\n\n    def start(self):\n        if self._started:\n            raise RuntimeError(\"threads can only be started once\")\n        self._started = True\n        self.ident = _ident[0]\n        try:\n            self.run()\n        finally:\n            self._done = True\n\n    def run(self):\n        if self._target is not None:\n            self._target(*self._args, **self._kwargs)\n\n    def join(self, timeout=None):\n        pass\n\n    def is_alive(self):\n        return self._started and not self._done\n\n\nclass _MainThread(Thread):\n    def __init__(self):\n        Thread.__init__(self, name=\"MainThread\")\n        self.ident = 1\n        self._started = True\n\n\n_main = _MainThread()\n\n\ndef current_thread():\n    return _main\n\n\ndef main_thread():\n    return _main\n\n\ndef get_ident():\n    return 1\n\n\ndef active_count():\n    return 1\n\n\ndef enumerate():\n    return [_main]\n\n\nTIMEOUT_MAX = 2147483.0\n"
            return s29
        }
        if (name == "traceback") {
            def s30@(optional):string "# SPDX-License-Identifier: MIT\n# traceback for the Ranger Python runtime: the exception's type and message.\nimport sys\n\ndef format_exception_only(exc, value=None):\n    if value is None and isinstance(exc, BaseException):\n        value = exc\n    msg = str(value)\n    name = type(value).__name__\n    return [name + (\": \" + msg if msg else \"\") + \"\\n\"]\n\ndef format_exception(exc, value=None, tb=None, limit=None, chain=True):\n    return [\"Traceback (most recent call last):\\n\"] + format_exception_only(exc, value)\n\ndef format_exc(limit=None, chain=True):\n    return \"NoneType: None\\n\"\n\ndef print_exc(limit=None, file=None, chain=True):\n    print(format_exc(), end=\"\", file=file)\n\ndef print_exception(exc, value=None, tb=None, limit=None, file=None, chain=True):\n    print(\"\".join(format_exception(exc, value)), end=\"\", file=file)\n\ndef format_stack(f=None, limit=None):\n    return []\n\ndef extract_stack(f=None, limit=None):\n    return []\n"
            return s30
        }
        if (name == "types") {
            def s31@(optional):string "# SPDX-License-Identifier: MIT\n# types for the Ranger Python runtime.\n\ndef _f():\n    pass\n\nclass _C:\n    def _m(self):\n        pass\n\nFunctionType = type(_f)\nLambdaType = type(lambda: None)\nMethodType = type(_C()._m)\nBuiltinFunctionType = type(len)\nBuiltinMethodType = type([].append)\nModuleType = type(__import__(\"sys\"))\nNoneType = type(None)\nEllipsisType = type(...)\nNotImplementedType = type(NotImplemented)\nGeneratorType = type((x for x in ()))\n\n\nclass SimpleNamespace:\n    def __init__(self, mapping_or_iterable=(), /, **kwargs):\n        if isinstance(mapping_or_iterable, dict):\n            for k in mapping_or_iterable:\n                setattr(self, k, mapping_or_iterable[k])\n        else:\n            for k, v in mapping_or_iterable:\n                setattr(self, k, v)\n        for k in kwargs:\n            setattr(self, k, kwargs[k])\n\n    def __repr__(self):\n        items = [\"%s=%r\" % (k, v) for k, v in self.__dict__.items()]\n        return \"namespace(\" + \", \".join(items) + \")\"\n\n    def __eq__(self, other):\n        return isinstance(other, SimpleNamespace) and self.__dict__ == other.__dict__\n\n\nclass MappingProxyType:\n    def __init__(self, mapping):\n        self._m = mapping\n\n    def __getitem__(self, k):\n        return self._m[k]\n\n    def __len__(self):\n        return len(self._m)\n\n    def __iter__(self):\n        return iter(self._m)\n\n    def __contains__(self, k):\n        return k in self._m\n\n    def get(self, k, default=None):\n        return self._m.get(k, default)\n\n    def keys(self):\n        return self._m.keys()\n\n    def values(self):\n        return self._m.values()\n\n    def items(self):\n        return self._m.items()\n\n    def copy(self):\n        return dict(self._m)\n\n\ndef new_class(name, bases=(), kwds=None, exec_body=None):\n    ns = {}\n    if exec_body is not None:\n        exec_body(ns)\n    return type(name, bases, ns)\n\n\nclass GenericAlias:\n    def __init__(self, origin, args):\n        if not isinstance(args, tuple):\n            args = (args,)\n        self.__origin__ = origin\n        self.__args__ = args\n        self.__parameters__ = ()\n\n    def __call__(self, *args, **kwargs):\n        return self.__origin__(*args, **kwargs)\n\n    def __getitem__(self, params):\n        return GenericAlias(self.__origin__, params)\n\n    def __or__(self, other):\n        return UnionType((self, other))\n\n    def __ror__(self, other):\n        return UnionType((other, self))\n\n    def __eq__(self, other):\n        return isinstance(other, GenericAlias) and self.__origin__ == other.__origin__ and self.__args__ == other.__args__\n\n    def __hash__(self):\n        return hash((self.__origin__, self.__args__))\n\n    def __mro_entries__(self, bases):\n        return (self.__origin__,)\n\n    def __repr__(self):\n        return _repr(self.__origin__) + \"[\" + \", \".join(_repr(a) for a in self.__args__) + \"]\"\n\n\nclass UnionType:\n    def __init__(self, args):\n        self.__args__ = args\n\n    def __or__(self, other):\n        return UnionType(self.__args__ + (other,))\n\n    def __repr__(self):\n        return \" | \".join(_repr(a) for a in self.__args__)\n\n\ndef _repr(obj):\n    if obj is ...:\n        return \"...\"\n    if obj is None or obj is type(None):\n        return \"None\"\n    if isinstance(obj, type):\n        if obj.__module__ == \"builtins\":\n            return obj.__qualname__\n        return obj.__module__ + \".\" + obj.__qualname__\n    if isinstance(obj, tuple) and not obj:\n        return \"()\"\n    return repr(obj)\n"
            return s31
        }
        if (name == "typing") {
            def s32@(optional):string "# SPDX-License-Identifier: MIT\n# typing for the Ranger Python runtime: the names exist and subscripting\n# them works, so annotated code runs; nothing is checked.\n\nTYPE_CHECKING = False\n\n\nclass _Alias:\n    def __init__(self, name, args=(), origin=None):\n        self._name = name\n        self.__args__ = args\n        self.__origin__ = origin\n        self.__name__ = name\n\n    def __getitem__(self, params):\n        if not isinstance(params, tuple):\n            params = (params,)\n        return _Alias(self._name, params, self)\n\n    def __call__(self, *args, **kwargs):\n        if self.__origin__ is not None:\n            return self.__origin__(*args, **kwargs)\n        raise TypeError(\"Cannot instantiate typing.\" + self._name)\n\n    def __or__(self, other):\n        return Union[self, other]\n\n    def __ror__(self, other):\n        return Union[other, self]\n\n    def __repr__(self):\n        if self.__args__:\n            return \"typing.%s[%s]\" % (self._name, \", \".join(_type_repr(a) for a in self.__args__))\n        return \"typing.\" + self._name\n\n    def __eq__(self, other):\n        return isinstance(other, _Alias) and self._name == other._name and self.__args__ == other.__args__\n\n    def __hash__(self):\n        return hash((self._name, self.__args__))\n\n\ndef _type_repr(obj):\n    if isinstance(obj, type):\n        if obj.__module__ == \"builtins\":\n            return obj.__qualname__\n        return obj.__module__ + \".\" + obj.__qualname__\n    if obj is ...:\n        return \"...\"\n    return repr(obj)\n\n\nclass _Builtin(_Alias):\n    def __init__(self, name, origin):\n        _Alias.__init__(self, name)\n        self._real = origin\n\n    def __call__(self, *args, **kwargs):\n        return self._real(*args, **kwargs)\n\n    def __getitem__(self, params):\n        if not isinstance(params, tuple):\n            params = (params,)\n        a = _Alias(self._name, params, self._real)\n        return a\n\n\nAny = _Alias(\"Any\")\nNoReturn = _Alias(\"NoReturn\")\nNever = _Alias(\"Never\")\nSelf = _Alias(\"Self\")\nLiteralString = _Alias(\"LiteralString\")\nUnion = _Alias(\"Union\")\nOptional = _Alias(\"Optional\")\nLiteral = _Alias(\"Literal\")\nClassVar = _Alias(\"ClassVar\")\nFinal = _Alias(\"Final\")\nAnnotated = _Alias(\"Annotated\")\nConcatenate = _Alias(\"Concatenate\")\nTypeGuard = _Alias(\"TypeGuard\")\nTypeIs = _Alias(\"TypeIs\")\nUnpack = _Alias(\"Unpack\")\nRequired = _Alias(\"Required\")\nNotRequired = _Alias(\"NotRequired\")\nReadOnly = _Alias(\"ReadOnly\")\nList = _Builtin(\"List\", list)\nDict = _Builtin(\"Dict\", dict)\nSet = _Builtin(\"Set\", set)\nFrozenSet = _Builtin(\"FrozenSet\", frozenset)\nTuple = _Builtin(\"Tuple\", tuple)\nType = _Builtin(\"Type\", type)\nCallable = _Alias(\"Callable\")\nIterable = _Alias(\"Iterable\")\nIterator = _Alias(\"Iterator\")\nGenerator = _Alias(\"Generator\")\nAsyncIterator = _Alias(\"AsyncIterator\")\nAsyncGenerator = _Alias(\"AsyncGenerator\")\nAwaitable = _Alias(\"Awaitable\")\nCoroutine = _Alias(\"Coroutine\")\nSequence = _Alias(\"Sequence\")\nMutableSequence = _Alias(\"MutableSequence\")\nMapping = _Alias(\"Mapping\")\nMutableMapping = _Alias(\"MutableMapping\")\nAbstractSet = _Alias(\"AbstractSet\")\nMutableSet = _Alias(\"MutableSet\")\nCollection = _Alias(\"Collection\")\nContainer = _Alias(\"Container\")\nHashable = _Alias(\"Hashable\")\nSized = _Alias(\"Sized\")\nReversible = _Alias(\"Reversible\")\nKeysView = _Alias(\"KeysView\")\nValuesView = _Alias(\"ValuesView\")\nItemsView = _Alias(\"ItemsView\")\nIO = _Alias(\"IO\")\nTextIO = _Alias(\"TextIO\")\nBinaryIO = _Alias(\"BinaryIO\")\nPattern = _Alias(\"Pattern\")\nMatch = _Alias(\"Match\")\nSupportsInt = _Alias(\"SupportsInt\")\nSupportsFloat = _Alias(\"SupportsFloat\")\nSupportsIndex = _Alias(\"SupportsIndex\")\nSupportsAbs = _Alias(\"SupportsAbs\")\nSupportsRound = _Alias(\"SupportsRound\")\nSupportsComplex = _Alias(\"SupportsComplex\")\nSupportsBytes = _Alias(\"SupportsBytes\")\nAnyStr = _Alias(\"AnyStr\")\nText = str\n\n\ndef _deque(*args):\n    import collections\n    return collections.deque(*args)\n\n\ndef _defaultdict(*args):\n    import collections\n    return collections.defaultdict(*args)\n\n\ndef _counter(*args):\n    import collections\n    return collections.Counter(*args)\n\n\ndef _ordereddict(*args):\n    import collections\n    return collections.OrderedDict(*args)\n\n\nDeque = _Builtin(\"Deque\", _deque)\nDefaultDict = _Builtin(\"DefaultDict\", _defaultdict)\nCounter = _Builtin(\"Counter\", _counter)\nOrderedDict = _Builtin(\"OrderedDict\", _ordereddict)\nChainMap = _Alias(\"ChainMap\")\n\n\nclass TypeVar:\n    def __init__(self, name, *constraints, bound=None, covariant=False, contravariant=False, infer_variance=False, default=None):\n        self.__name__ = name\n        self.__constraints__ = constraints\n        self.__bound__ = bound\n        self.__covariant__ = covariant\n        self.__contravariant__ = contravariant\n        self.__default__ = default\n        self.__infer_variance__ = infer_variance\n\n    def __or__(self, other):\n        return Union[self, other]\n\n    def __ror__(self, other):\n        return Union[other, self]\n\n    def __repr__(self):\n        if self.__infer_variance__:\n            return self.__name__\n        if self.__covariant__:\n            return \"+\" + self.__name__\n        if self.__contravariant__:\n            return \"-\" + self.__name__\n        return \"~\" + self.__name__\n\n\nclass ParamSpec(TypeVar):\n    def __repr__(self):\n        return \"~\" + self.__name__\n\n\nclass TypeVarTuple(TypeVar):\n    def __repr__(self):\n        return self.__name__\n\n\nclass TypeAliasType:\n    def __init__(self, name, value, *, type_params=()):\n        self.__name__ = name\n        self.__value__ = value\n        self.__type_params__ = type_params\n\n    def __getitem__(self, params):\n        return self\n\n    def __repr__(self):\n        return self.__name__\n\n\nclass Generic:\n    def __class_getitem__(cls, params):\n        return cls\n\n\nclass Protocol(Generic):\n    pass\n\n\ndef runtime_checkable(cls):\n    return cls\n\n\ndef cast(typ, val):\n    return val\n\n\ndef assert_type(val, typ):\n    return val\n\n\ndef reveal_type(obj):\n    return obj\n\n\ndef assert_never(arg):\n    raise AssertionError(\"Expected code to be unreachable\")\n\n\ndef overload(func):\n    return func\n\n\ndef final(f):\n    return f\n\n\ndef override(method):\n    return method\n\n\ndef no_type_check(arg):\n    return arg\n\n\ndef get_overloads(func):\n    return []\n\n\ndef get_type_hints(obj, globalns=None, localns=None, include_extras=False):\n    return dict(getattr(obj, \"__annotations__\", {}) or {})\n\n\ndef get_origin(tp):\n    return getattr(tp, \"__origin__\", None)\n\n\ndef get_args(tp):\n    return getattr(tp, \"__args__\", ())\n\n\ndef NewType(name, tp):\n    def new_type(x):\n        return x\n    new_type.__name__ = name\n    new_type.__supertype__ = tp\n    return new_type\n\n\ndef NamedTuple(typename, fields=None, **kwargs):\n    import collections\n    if fields is None:\n        fields = list(kwargs.items())\n    return collections.namedtuple(typename, [f[0] for f in fields])\n\n\nclass TypedDict(dict):\n    pass\n"
