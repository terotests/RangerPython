        if (name == "tempfile") {
            def s110@(optional):string "# SPDX-License-Identifier: MIT\n# tempfile for the Ranger Python runtime, on its file system\nimport os\n\ntempdir = \"/tmp\"\ntemplate = \"tmp\"\n_count = [0]\n\n\ndef gettempdir():\n    return tempdir\n\n\ndef _name(prefix, suffix, dir):\n    _count[0] += 1\n    return os.path.join(dir or tempdir, \"%s%d%s\" % (prefix or template, _count[0], suffix or \"\"))\n\n\ndef mkdtemp(suffix=None, prefix=None, dir=None):\n    path = _name(prefix, suffix, dir)\n    os.makedirs(path, exist_ok=True)\n    return path\n\n\ndef mkstemp(suffix=None, prefix=None, dir=None, text=False):\n    path = _name(prefix, suffix, dir)\n    with open(path, \"w\") as f:\n        f.write(\"\")\n    return (3, path)\n\n\ndef mktemp(suffix=\"\", prefix=template, dir=None):\n    return _name(prefix, suffix, dir)\n\n\nclass TemporaryDirectory:\n    def __init__(self, suffix=None, prefix=None, dir=None, ignore_cleanup_errors=False, *, delete=True):\n        self.name = mkdtemp(suffix, prefix, dir)\n\n    def __enter__(self):\n        return self.name\n\n    def __exit__(self, *exc):\n        self.cleanup()\n\n    def cleanup(self):\n        import shutil\n        shutil.rmtree(self.name, ignore_errors=True)\n\n\ndef NamedTemporaryFile(mode=\"w+b\", buffering=-1, encoding=None, newline=None, suffix=None,\n                       prefix=None, dir=None, delete=True, *, errors=None, delete_on_close=True):\n    path = _name(prefix, suffix, dir)\n    f = open(path, \"w\")\n    return f\n\n\nTemporaryFile = NamedTemporaryFile\n"
            return s110
        }
        if (name == "textwrap") {
            def s111@(optional):string "# SPDX-License-Identifier: MIT\n# textwrap for the Ranger Python runtime: dedent, indent, wrap, fill, shorten.\n\ndef dedent(text):\n    lines = text.split(\"\\n\")\n    margin = None\n    for line in lines:\n        stripped = line.lstrip(\" \\t\")\n        if not stripped:\n            continue\n        ws = line[:len(line) - len(stripped)]\n        if margin is None:\n            margin = ws\n        else:\n            n = 0\n            while n < len(margin) and n < len(ws) and margin[n] == ws[n]:\n                n += 1\n            margin = margin[:n]\n    out = []\n    for line in lines:\n        if not line.strip(\" \\t\"):\n            out.append(line.lstrip(\" \\t\") if line.strip() == \"\" else line)\n        elif margin:\n            out.append(line[len(margin):])\n        else:\n            out.append(line)\n    return \"\\n\".join(\"\" if l.strip() == \"\" else l for l in out)\n\n\ndef indent(text, prefix, predicate=None):\n    if predicate is None:\n        predicate = lambda line: line.strip()\n    out = []\n    for line in text.splitlines(True):\n        out.append(prefix + line if predicate(line) else line)\n    return \"\".join(out)\n\n\ndef wrap(text, width=70, initial_indent=\"\", subsequent_indent=\"\", break_long_words=True, **kwargs):\n    words = text.split()\n    lines = []\n    cur = initial_indent\n    empty = True\n    for w in words:\n        prefix = initial_indent if not lines else subsequent_indent\n        if empty:\n            cand = prefix + w\n        else:\n            cand = cur + \" \" + w\n        if len(cand) <= width or empty and not break_long_words:\n            cur = cand\n            empty = False\n        elif empty:\n            while len(prefix + w) > width:\n                lines.append(prefix + w[:width - len(prefix)])\n                w = w[width - len(prefix):]\n                prefix = subsequent_indent\n            cur = prefix + w\n            empty = False\n        else:\n            lines.append(cur)\n            cur = subsequent_indent + w\n    if not empty:\n        lines.append(cur)\n    return lines\n\n\ndef fill(text, width=70, **kwargs):\n    return \"\\n\".join(wrap(text, width, **kwargs))\n\n\ndef shorten(text, width, placeholder=\" [...]\", **kwargs):\n    text = \" \".join(text.split())\n    if len(text) <= width:\n        return text\n    words = text.split()\n    out = \"\"\n    for w in words:\n        cand = w if not out else out + \" \" + w\n        if len(cand) + len(placeholder) > width:\n            break\n        out = cand\n    return out + placeholder\n"
            return s111
        }
        if (name == "threading") {
            def s112@(optional):string "# SPDX-License-Identifier: MIT\n# threading for the Ranger Python runtime. There is one thread: start()\n# runs the target to the end, and locks never have to wait.\n\n_ident = [1]\n\n\nclass Lock:\n    def __init__(self):\n        self._locked = False\n\n    def acquire(self, blocking=True, timeout=-1):\n        if self._locked:\n            if not blocking:\n                return False\n            raise RuntimeError(\"deadlock: the lock is held and there is only one thread\")\n        self._locked = True\n        return True\n\n    def release(self):\n        if not self._locked:\n            raise RuntimeError(\"release unlocked lock\")\n        self._locked = False\n\n    def locked(self):\n        return self._locked\n\n    def __enter__(self):\n        return self.acquire()\n\n    def __exit__(self, *exc):\n        self.release()\n\n\nclass RLock:\n    def __init__(self):\n        self._count = 0\n\n    def acquire(self, blocking=True, timeout=-1):\n        self._count += 1\n        return True\n\n    def release(self):\n        if not self._count:\n            raise RuntimeError(\"cannot release un-acquired lock\")\n        self._count -= 1\n\n    def __enter__(self):\n        return self.acquire()\n\n    def __exit__(self, *exc):\n        self.release()\n\n\nclass Condition:\n    def __init__(self, lock=None):\n        self._lock = lock or RLock()\n\n    def __enter__(self):\n        return self._lock.__enter__()\n\n    def __exit__(self, *exc):\n        return self._lock.__exit__(*exc)\n\n    def wait(self, timeout=None):\n        return True\n\n    def wait_for(self, predicate, timeout=None):\n        return predicate()\n\n    def notify(self, n=1):\n        pass\n\n    def notify_all(self):\n        pass\n\n\nclass Semaphore:\n    def __init__(self, value=1):\n        self._value = value\n\n    def acquire(self, blocking=True, timeout=None):\n        if self._value <= 0:\n            return False\n        self._value -= 1\n        return True\n\n    def release(self, n=1):\n        self._value += n\n\n    __enter__ = acquire\n\n    def __exit__(self, *exc):\n        self.release()\n\n\nBoundedSemaphore = Semaphore\n\n\nclass Event:\n    def __init__(self):\n        self._flag = False\n\n    def is_set(self):\n        return self._flag\n\n    def set(self):\n        self._flag = True\n\n    def clear(self):\n        self._flag = False\n\n    def wait(self, timeout=None):\n        return self._flag\n\n\nclass local:\n    pass\n\n\nclass Thread:\n    def __init__(self, group=None, target=None, name=None, args=(), kwargs=None, *, daemon=None):\n        self._target = target\n        self._args = args\n        self._kwargs = kwargs or {}\n        _ident[0] += 1\n        self.name = name or \"Thread-%d\" % (_ident[0] - 1)\n        self.ident = None\n        self.daemon = bool(daemon)\n        self._started = False\n        self._done = False\n\n    def start(self):\n        if self._started:\n            raise RuntimeError(\"threads can only be started once\")\n        self._started = True\n        self.ident = _ident[0]\n        try:\n            self.run()\n        finally:\n            self._done = True\n\n    def run(self):\n        if self._target is not None:\n            self._target(*self._args, **self._kwargs)\n\n    def join(self, timeout=None):\n        pass\n\n    def is_alive(self):\n        return self._started and not self._done\n\n\nclass _MainThread(Thread):\n    def __init__(self):\n        Thread.__init__(self, name=\"MainThread\")\n        self.ident = 1\n        self._started = True\n\n\n_main = _MainThread()\n\n\ndef current_thread():\n    return _main\n\n\ndef main_thread():\n    return _main\n\n\ndef get_ident():\n    return 1\n\n\ndef active_count():\n    return 1\n\n\ndef enumerate():\n    return [_main]\n\n\nTIMEOUT_MAX = 2147483.0\n"
            return s112
