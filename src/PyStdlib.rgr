        if (name == "io") {
            def s96@(optional):string "# SPDX-License-Identifier: MIT\n# io for the Ranger Python runtime: StringIO, and open as in builtins.\n\nopen = open\nSEEK_SET = 0\nSEEK_CUR = 1\nSEEK_END = 2\n\n\nclass UnsupportedOperation(OSError, ValueError):\n    pass\n\n\nclass StringIO:\n    def __init__(self, initial_value=\"\", newline=\"\\n\"):\n        self._parts = [initial_value] if initial_value else []\n        self._value = None\n        self._pos = 0\n        self.closed = False\n\n    def _text(self):\n        if self._value is None:\n            self._value = \"\".join(self._parts)\n            self._parts = [self._value]\n        return self._value\n\n    def write(self, s):\n        if self.closed:\n            raise ValueError(\"I/O operation on closed file.\")\n        if not isinstance(s, str):\n            raise TypeError(\"string argument expected, got '%s'\" % type(s).__name__)\n        text = self._text()\n        if self._pos == len(text):\n            self._parts.append(s)\n            self._value = None\n        else:\n            self._value = text[:self._pos] + s + text[self._pos + len(s):]\n            self._parts = [self._value]\n        self._pos += len(s)\n        return len(s)\n\n    def writelines(self, lines):\n        for line in lines:\n            self.write(line)\n\n    def getvalue(self):\n        return self._text()\n\n    def read(self, size=-1):\n        text = self._text()\n        if size is None or size < 0:\n            out = text[self._pos:]\n        else:\n            out = text[self._pos:self._pos + size]\n        self._pos += len(out)\n        return out\n\n    def readline(self, size=-1):\n        text = self._text()\n        end = text.find(\"\\n\", self._pos)\n        end = len(text) if end < 0 else end + 1\n        out = text[self._pos:end]\n        self._pos = end\n        return out\n\n    def readlines(self):\n        out = []\n        while True:\n            line = self.readline()\n            if not line:\n                return out\n            out.append(line)\n\n    def __iter__(self):\n        return iter(self.readlines())\n\n    def seek(self, pos, whence=0):\n        if whence == 0:\n            self._pos = pos\n        elif whence == 2:\n            self._pos = len(self._text()) + pos\n        else:\n            self._pos += pos\n        return self._pos\n\n    def tell(self):\n        return self._pos\n\n    def truncate(self, size=None):\n        text = self._text()\n        if size is None:\n            size = self._pos\n        self._value = text[:size]\n        self._parts = [self._value]\n        return size\n\n    def flush(self):\n        pass\n\n    def close(self):\n        self.closed = True\n\n    def readable(self):\n        return True\n\n    def writable(self):\n        return True\n\n    def seekable(self):\n        return True\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, *args):\n        self.close()\n        return False\n\n\nTextIOWrapper = StringIO\n"
