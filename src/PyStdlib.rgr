        if (name == "bisect") {
            def s5@(optional):string "# SPDX-License-Identifier: MIT\n# bisect for the Ranger Python runtime\n\n\ndef bisect_right(a, x, lo=0, hi=None, *, key=None):\n    if lo < 0:\n        raise ValueError(\"lo must be non-negative\")\n    if hi is None:\n        hi = len(a)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        v = a[mid] if key is None else key(a[mid])\n        if x < v:\n            hi = mid\n        else:\n            lo = mid + 1\n    return lo\n\n\ndef bisect_left(a, x, lo=0, hi=None, *, key=None):\n    if lo < 0:\n        raise ValueError(\"lo must be non-negative\")\n    if hi is None:\n        hi = len(a)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        v = a[mid] if key is None else key(a[mid])\n        if v < x:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo\n\n\ndef insort_right(a, x, lo=0, hi=None, *, key=None):\n    lo = bisect_right(a, x if key is None else key(x), lo, hi, key=key)\n    a.insert(lo, x)\n\n\ndef insort_left(a, x, lo=0, hi=None, *, key=None):\n    lo = bisect_left(a, x if key is None else key(x), lo, hi, key=key)\n    a.insert(lo, x)\n\n\nbisect = bisect_right\ninsort = insort_right\n"
