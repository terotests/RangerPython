        if (name == "string") {
            def s108@(optional):string "# SPDX-License-Identifier: MIT\n# string for the Ranger Python runtime: the constants come from the\n# native _string, Template, Formatter and capwords are written here.\nfrom _string import *\nimport re as _re\n\n__all__ = [\"ascii_letters\", \"ascii_lowercase\", \"ascii_uppercase\", \"capwords\",\n           \"digits\", \"hexdigits\", \"octdigits\", \"printable\", \"punctuation\",\n           \"whitespace\", \"Formatter\", \"Template\"]\n\n\ndef capwords(s, sep=None):\n    return (sep or \" \").join(map(str.capitalize, s.split(sep)))\n\n\nclass Template:\n    delimiter = \"$\"\n    idpattern = r\"(?a:[_a-z][_a-z0-9]*)\"\n    braceidpattern = None\n    flags = _re.IGNORECASE\n\n    def __init_subclass__(cls, **kw):\n        cls.pattern = cls._compile()\n\n    @classmethod\n    def _compile(cls):\n        if \"pattern\" in cls.__dict__ and not isinstance(cls.__dict__[\"pattern\"], str):\n            return cls.__dict__[\"pattern\"]\n        d = _re.escape(cls.delimiter)\n        ident = cls.idpattern\n        bid = cls.braceidpattern or ident\n        src = cls.__dict__.get(\"pattern\")\n        if not isinstance(src, str):\n            src = (d + r\"(?:(?P<escaped>\" + d + r\")|(?P<named>\" + ident + r\")|\\{(?P<braced>\" + bid +\n                   r\")\\}|(?P<invalid>))\")\n        return _re.compile(src, cls.flags | _re.VERBOSE if src is cls.__dict__.get(\"pattern\") else cls.flags)\n\n    def __init__(self, template):\n        self.template = template\n\n    def _pat(self):\n        p = type(self).__dict__.get(\"pattern\")\n        if p is None or isinstance(p, str):\n            p = type(self)._compile()\n        return p\n\n    def _invalid(self, mo):\n        i = mo.start(\"invalid\")\n        lines = self.template[:i].splitlines(keepends=True)\n        if not lines:\n            colno = 1\n            lineno = 1\n        else:\n            colno = i - len(\"\".join(lines[:-1]))\n            lineno = len(lines)\n        raise ValueError(\"Invalid placeholder in string: line %d, col %d\" % (lineno, colno))\n\n    def substitute(self, mapping=None, /, **kws):\n        if mapping is None:\n            mapping = kws\n        elif kws:\n            m = dict(mapping)\n            m.update(kws)\n            mapping = m\n\n        def convert(mo):\n            named = mo.group(\"named\") or mo.group(\"braced\")\n            if named is not None:\n                return str(mapping[named])\n            if mo.group(\"escaped\") is not None:\n                return self.delimiter\n            if mo.group(\"invalid\") is not None:\n                self._invalid(mo)\n            raise ValueError(\"Unrecognized named group in pattern\", self.pattern)\n        return self._pat().sub(convert, self.template)\n\n    def safe_substitute(self, mapping=None, /, **kws):\n        if mapping is None:\n            mapping = kws\n        elif kws:\n            m = dict(mapping)\n            m.update(kws)\n            mapping = m\n\n        def convert(mo):\n            named = mo.group(\"named\") or mo.group(\"braced\")\n            if named is not None:\n                try:\n                    return str(mapping[named])\n                except KeyError:\n                    return mo.group()\n            if mo.group(\"escaped\") is not None:\n                return self.delimiter\n            if mo.group(\"invalid\") is not None:\n                return mo.group()\n            raise ValueError(\"Unrecognized named group in pattern\", self.pattern)\n        return self._pat().sub(convert, self.template)\n\n    def is_valid(self):\n        for mo in self._pat().finditer(self.template):\n            if mo.group(\"invalid\") is not None:\n                return False\n            if mo.group(\"named\") is None and mo.group(\"braced\") is None and mo.group(\"escaped\") is None:\n                raise ValueError(\"Unrecognized named group in pattern\", self.pattern)\n        return True\n\n    def get_identifiers(self):\n        ids = []\n        for mo in self._pat().finditer(self.template):\n            named = mo.group(\"named\") or mo.group(\"braced\")\n            if named is not None and named not in ids:\n                ids.append(named)\n            elif named is None and mo.group(\"invalid\") is None and mo.group(\"escaped\") is None:\n                raise ValueError(\"Unrecognized named group in pattern\", self.pattern)\n        return ids\n\n\nclass Formatter:\n    def format(self, format_string, /, *args, **kwargs):\n        return self.vformat(format_string, args, kwargs)\n\n    def vformat(self, format_string, args, kwargs):\n        used = set()\n        result, _ = self._vformat(format_string, args, kwargs, used, 2)\n        self.check_unused_args(used, args, kwargs)\n        return result\n\n    def _vformat(self, format_string, args, kwargs, used_args, recursion_depth, auto_arg_index=0):\n        if recursion_depth < 0:\n            raise ValueError(\"Max string recursion exceeded\")\n        result = []\n        for literal_text, field_name, format_spec, conversion in self.parse(format_string):\n            if literal_text:\n                result.append(literal_text)\n            if field_name is not None:\n                if field_name == \"\":\n                    if auto_arg_index is False:\n                        raise ValueError(\"cannot switch from manual field specification to automatic field numbering\")\n                    field_name = str(auto_arg_index)\n                    auto_arg_index += 1\n                elif field_name.isdigit():\n                    if auto_arg_index:\n                        raise ValueError(\"cannot switch from manual field specification to automatic field numbering\")\n                    auto_arg_index = False\n                obj, arg_used = self.get_field(field_name, args, kwargs)\n                used_args.add(arg_used)\n                obj = self.convert_field(obj, conversion)\n                format_spec, auto_arg_index = self._vformat(format_spec, args, kwargs, used_args,\n                                                            recursion_depth - 1, auto_arg_index=auto_arg_index)\n                result.append(self.format_field(obj, format_spec))\n        return \"\".join(result), auto_arg_index\n\n    def get_value(self, key, args, kwargs):\n        if isinstance(key, int):\n            return args[key]\n        return kwargs[key]\n\n    def check_unused_args(self, used_args, args, kwargs):\n        pass\n\n    def format_field(self, value, format_spec):\n        return format(value, format_spec)\n\n    def convert_field(self, value, conversion):\n        if conversion is None:\n            return value\n        if conversion == \"s\":\n            return str(value)\n        if conversion == \"r\":\n            return repr(value)\n        if conversion == \"a\":\n            return ascii(value)\n        raise ValueError(\"Unknown conversion specifier \" + str(conversion))\n\n    def parse(self, format_string):\n        out = []\n        i = 0\n        n = len(format_string)\n        lit = []\n        while i < n:\n            c = format_string[i]\n            if c == \"{\":\n                if i + 1 < n and format_string[i + 1] == \"{\":\n                    lit.append(\"{\")\n                    i += 2\n                    continue\n                depth = 1\n                j = i + 1\n                while j < n and depth:\n                    if format_string[j] == \"{\":\n                        depth += 1\n                    elif format_string[j] == \"}\":\n                        depth -= 1\n                    j += 1\n                if depth:\n                    raise ValueError(\"expected '}' before end of string\")\n                field = format_string[i + 1:j - 1]\n                conv = None\n                spec = \"\"\n                k = 0\n                bracket = 0\n                name_end = len(field)\n                while k < len(field):\n                    ch = field[k]\n                    if ch == \"[\":\n                        bracket += 1\n                    elif ch == \"]\":\n                        bracket -= 1\n                    elif bracket == 0 and ch in \"!:\":\n                        name_end = k\n                        break\n                    k += 1\n                name = field[:name_end]\n                rest = field[name_end:]\n                if rest.startswith(\"!\"):\n                    if len(rest) < 2:\n                        raise ValueError(\"end of string while looking for conversion specifier\")\n                    conv = rest[1]\n                    rest = rest[2:]\n                    if rest and not rest.startswith(\":\"):\n                        raise ValueError(\"expected ':' after conversion specifier\")\n                if rest.startswith(\":\"):\n                    spec = rest[1:]\n                out.append((\"\".join(lit), name, spec, conv))\n                lit = []\n                i = j\n            elif c == \"}\":\n                if i + 1 < n and format_string[i + 1] == \"}\":\n                    lit.append(\"}\")\n                    i += 2\n                    continue\n                raise ValueError(\"Single '}' encountered in format string\")\n            else:\n                lit.append(c)\n                i += 1\n        if lit:\n            out.append((\"\".join(lit), None, None, None))\n        return out\n\n    def get_field(self, field_name, args, kwargs):\n        first = field_name\n        rest = \"\"\n        for k, ch in enumerate(field_name):\n            if ch in \".[\":\n                first = field_name[:k]\n                rest = field_name[k:]\n                break\n        key = int(first) if first.isdigit() else first\n        obj = self.get_value(key, args, kwargs)\n        while rest:\n            if rest[0] == \".\":\n                k = 1\n                while k < len(rest) and rest[k] not in \".[\":\n                    k += 1\n                obj = getattr(obj, rest[1:k])\n                rest = rest[k:]\n            else:\n                k = rest.index(\"]\")\n                idx = rest[1:k]\n                obj = obj[int(idx) if idx.isdigit() else idx]\n                rest = rest[k + 1:]\n        return obj, key\nTemplate.pattern = Template._compile()\n"
            return s108
        }
        if (name == "subprocess") {
            def s109@(optional):string "# SPDX-License-Identifier: MIT\n# subprocess for the Ranger Python runtime, on the native _rpyprocess. A\n# child is started at once; its pipes are fed and read to the end when the\n# parent first asks for their data (communicate, wait, or a read), as a\n# runtime without threads can do it. A WebAssembly build cannot start one.\nimport os\nimport sys\nimport _rpyprocess\n\n__all__ = [\"Popen\", \"PIPE\", \"STDOUT\", \"call\", \"check_call\", \"getstatusoutput\",\n           \"getoutput\", \"check_output\", \"run\", \"CalledProcessError\", \"DEVNULL\",\n           \"SubprocessError\", \"TimeoutExpired\", \"CompletedProcess\"]\n\nPIPE = -1\nSTDOUT = -2\nDEVNULL = -3\n\n_can_fork_exec = _rpyprocess.available\n_USE_POSIX_SPAWN = False\n_USE_VFORK = False\n\n\nclass SubprocessError(Exception):\n    pass\n\n\nclass CalledProcessError(SubprocessError):\n    def __init__(self, returncode, cmd, output=None, stderr=None):\n        self.returncode = returncode\n        self.cmd = cmd\n        self.output = output\n        self.stderr = stderr\n\n    def __str__(self):\n        if self.returncode and self.returncode < 0:\n            return \"Command '%s' died with signal %d.\" % (self.cmd, -self.returncode)\n        return \"Command '%s' returned non-zero exit status %d.\" % (self.cmd, self.returncode)\n\n    @property\n    def stdout(self):\n        return self.output\n\n    @stdout.setter\n    def stdout(self, value):\n        self.output = value\n\n\nclass TimeoutExpired(SubprocessError):\n    def __init__(self, cmd, timeout, output=None, stderr=None):\n        self.cmd = cmd\n        self.timeout = timeout\n        self.output = output\n        self.stderr = stderr\n\n    def __str__(self):\n        return \"Command '%s' timed out after %s seconds\" % (self.cmd, self.timeout)\n\n    @property\n    def stdout(self):\n        return self.output\n\n    @stdout.setter\n    def stdout(self, value):\n        self.output = value\n\n\nclass CompletedProcess:\n    def __init__(self, args, returncode, stdout=None, stderr=None):\n        self.args = args\n        self.returncode = returncode\n        self.stdout = stdout\n        self.stderr = stderr\n\n    def __repr__(self):\n        args = [\"args={!r}\".format(self.args), \"returncode={!r}\".format(self.returncode)]\n        if self.stdout is not None:\n            args.append(\"stdout={!r}\".format(self.stdout))\n        if self.stderr is not None:\n            args.append(\"stderr={!r}\".format(self.stderr))\n        return \"{}({})\".format(type(self).__name__, \", \".join(args))\n\n    def check_returncode(self):\n        if self.returncode:\n            raise CalledProcessError(self.returncode, self.args, self.stdout, self.stderr)\n\n\ndef _fsdecode(name):\n    name = os.fspath(name)\n    return name.decode(\"utf-8\", \"surrogateescape\") if isinstance(name, bytes) else name\n\n\ndef _cleanup():\n    pass\n\n\ndef list2cmdline(seq):\n    # as CPython's: the MS C runtime's quoting rules\n    result = []\n    needquote = False\n    for arg in map(_fsdecode, seq):\n        bs_buf = []\n        if result:\n            result.append(' ')\n        needquote = (\" \" in arg) or (\"\\t\" in arg) or not arg\n        if needquote:\n            result.append('\"')\n        for c in arg:\n            if c == '\\\\':\n                bs_buf.append(c)\n            elif c == '\"':\n                result.append('\\\\' * len(bs_buf) * 2)\n                bs_buf = []\n                result.append('\\\\\"')\n            else:\n                if bs_buf:\n                    result.extend(bs_buf)\n                    bs_buf = []\n                result.append(c)\n        if bs_buf:\n            result.extend(bs_buf)\n        if needquote:\n            result.extend(bs_buf)\n            result.append('\"')\n    return ''.join(result)\n\n\nclass _Pipe:\n    \"\"\"The parent's end of a child's pipe.\"\"\"\n\n    def __init__(self, proc, name, text):\n        self._proc = proc\n        self._name = name\n        self._text = text\n        self._buf = None\n        self.closed = False\n\n    # stdin: what is written goes to the child when its output is read\n    def write(self, data):\n        if self.closed:\n            raise ValueError(\"write to closed file\")\n        self._proc._input.append(data)\n        return len(data)\n\n    def flush(self):\n        pass\n\n    def _data(self):\n        if self._buf is None:\n            self._proc._collect()\n            self._buf = self._proc._captured[self._name]\n            if self._buf is None:\n                self._buf = \"\" if self._text else b\"\"\n        return self._buf\n\n    def read(self, size=-1):\n        if self.closed:\n            raise ValueError(\"read of closed file\")\n        data = self._data()\n        if size is None or size < 0:\n            size = len(data)\n        self._buf = data[size:]\n        return data[:size]\n\n    def readline(self, size=-1):\n        data = self._data()\n        nl = \"\\n\" if self._text else b\"\\n\"\n        i = data.find(nl)\n        end = len(data) if i < 0 else i + 1\n        if size is not None and 0 <= size < end:\n            end = size\n        self._buf = data[end:]\n        return data[:end]\n\n    def readlines(self):\n        lines = []\n        while True:\n            line = self.readline()\n            if not line:\n                return lines\n            lines.append(line)\n\n    def __iter__(self):\n        return iter(self.readlines())\n\n    def fileno(self):\n        raise OSError(\"the pipe has no file descriptor on this runtime\")\n\n    def close(self):\n        self.closed = True\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, *exc):\n        self.close()\n\n\ndef _mode(stream):\n    # what the native side does with a stream argument; a file object\n    # gets the data through a pipe once the child is done\n    if stream is None or stream in (PIPE, STDOUT, DEVNULL):\n        return stream\n    if isinstance(stream, int):\n        return None\n    if hasattr(stream, \"write\"):\n        return PIPE\n    raise TypeError(\"bad stream argument %r\" % (stream,))\n\n\nclass Popen:\n    def __init__(self, args, bufsize=-1, executable=None, stdin=None, stdout=None, stderr=None,\n                 preexec_fn=None, close_fds=True, shell=False, cwd=None, env=None,\n                 universal_newlines=None, startupinfo=None, creationflags=0,\n                 restore_signals=True, start_new_session=False, pass_fds=(), *,\n                 user=None, group=None, extra_groups=None, encoding=None, errors=None,\n                 text=None, umask=-1, pipesize=-1, process_group=None):\n        self.args = args\n        self.returncode = None\n        self.stdin = self.stdout = self.stderr = None\n        self._input = []\n        self._captured = None\n        if universal_newlines is not None and text is not None and bool(universal_newlines) != bool(text):\n            raise SubprocessError(\"Cannot disambiguate when both text and universal_newlines are supplied but different. Pass one or the other.\")\n        self.text_mode = bool(encoding or errors or text or universal_newlines)\n        self.encoding = encoding\n        self.errors = errors\n        if isinstance(args, (str, bytes)) or hasattr(args, \"__fspath__\"):\n            argv = [args]\n        else:\n            argv = list(args)\n        if shell:\n            argv = [\"/bin/sh\", \"-c\"] + argv\n        argv = [_fsdecode(a) for a in argv]\n        if executable is not None:\n            argv[0] = _fsdecode(executable)\n        if env is None:\n            env = os.environ\n        env = {_fsdecode(k): _fsdecode(v) for k, v in env.items()}\n        if cwd is not None:\n            cwd = _fsdecode(cwd)\n        self._streams = (stdin, stdout, stderr)\n        modes = (_mode(stdin), _mode(stdout), _mode(stderr))\n        self._handle, self.pid = _rpyprocess.spawn(argv, env, cwd, *modes)\n        if stdin == PIPE:\n            self.stdin = _Pipe(self, 0, self.text_mode)\n        if stdout == PIPE:\n            self.stdout = _Pipe(self, 0, self.text_mode)\n        if stderr == PIPE:\n            self.stderr = _Pipe(self, 1, self.text_mode)\n        self._modes = modes\n\n    def _translate(self, data):\n        if data is None or not self.text_mode:\n            return data\n        data = data.decode(self.encoding or \"utf-8\", self.errors or \"strict\")\n        return data.replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\")\n\n    def _collect(self, input=None):\n        # runs the child to its end, once: feeds stdin, reads the pipes\n        if self._captured is not None:\n            return\n        chunks = self._input\n        if input is not None:\n            chunks = chunks + [input]\n        data = None\n        if self._modes[0] == PIPE:\n            if self.text_mode:\n                data = \"\".join(chunks).encode(self.encoding or \"utf-8\", self.errors or \"strict\")\n            else:\n                data = b\"\".join(bytes(c) for c in chunks)\n        out, err, self.returncode = _rpyprocess.communicate(self._handle, data)\n        out, err = self._translate(out), self._translate(err)\n        # a file object given as a stream receives what the child wrote\n        for stream, value in ((self._streams[1], out), (self._streams[2], err)):\n            if value is not None and stream not in (None, PIPE, STDOUT, DEVNULL) and not isinstance(stream, int):\n                stream.write(value)\n        self._captured = (out if self._streams[1] == PIPE else None,\n                          err if self._streams[2] == PIPE else None)\n\n    def communicate(self, input=None, timeout=None):\n        if self._captured is not None and input:\n            raise ValueError(\"Cannot send input after starting communication\")\n        if self.stdin is not None:\n            self.stdin.closed = True\n        self._collect(input)\n        out = self.stdout.read() if self.stdout is not None and not self.stdout.closed else self._captured[0]\n        err = self.stderr.read() if self.stderr is not None and not self.stderr.closed else self._captured[1]\n        return (out, err)\n\n    def poll(self):\n        if self.returncode is None:\n            self.returncode = _rpyprocess.poll(self._handle)\n        return self.returncode\n\n    def wait(self, timeout=None):\n        if self.returncode is None:\n            if self._modes[1] == PIPE or self._modes[2] == PIPE:\n                # the pipes are drained so that the child cannot block on them\n                self._collect()\n            else:\n                self.returncode = _rpyprocess.wait(self._handle)\n        return self.returncode\n\n    def send_signal(self, sig):\n        self.kill()\n\n    def terminate(self):\n        self.kill()\n\n    def kill(self):\n        if self.returncode is None:\n            _rpyprocess.kill(self._handle)\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, exc_type, value, traceback):\n        for s in (self.stdout, self.stderr, self.stdin):\n            if s is not None:\n                s.close()\n        self.wait()\n\n    def __repr__(self):\n        return \"<%s: returncode: %s args: %r>\" % (type(self).__name__, self.returncode, self.args)\n\n    __class_getitem__ = classmethod(lambda cls, item: cls)\n\n\ndef call(*popenargs, timeout=None, **kwargs):\n    with Popen(*popenargs, **kwargs) as p:\n        return p.wait(timeout=timeout)\n\n\ndef check_call(*popenargs, **kwargs):\n    retcode = call(*popenargs, **kwargs)\n    if retcode:\n        cmd = kwargs.get(\"args\")\n        if cmd is None:\n            cmd = popenargs[0]\n        raise CalledProcessError(retcode, cmd)\n    return 0\n\n\ndef run(*popenargs, input=None, capture_output=False, timeout=None, check=False, **kwargs):\n    if input is not None:\n        if kwargs.get(\"stdin\") is not None:\n            raise ValueError(\"stdin and input arguments may not both be used.\")\n        kwargs[\"stdin\"] = PIPE\n    if capture_output:\n        if kwargs.get(\"stdout\") is not None or kwargs.get(\"stderr\") is not None:\n            raise ValueError(\"stdout and stderr arguments may not be used with capture_output.\")\n        kwargs[\"stdout\"] = PIPE\n        kwargs[\"stderr\"] = PIPE\n    with Popen(*popenargs, **kwargs) as process:\n        stdout, stderr = process.communicate(input, timeout=timeout)\n        retcode = process.poll()\n        if check and retcode:\n            raise CalledProcessError(retcode, process.args, output=stdout, stderr=stderr)\n    return CompletedProcess(process.args, retcode, stdout, stderr)\n\n\ndef check_output(*popenargs, timeout=None, **kwargs):\n    for kw in (\"stdout\", \"check\"):\n        if kw in kwargs:\n            raise ValueError(\"%s argument not allowed, it will be overridden.\" % kw)\n    if \"input\" in kwargs and kwargs[\"input\"] is None:\n        kwargs[\"input\"] = \"\" if kwargs.get(\"universal_newlines\") or kwargs.get(\"text\") or kwargs.get(\"encoding\") or kwargs.get(\"errors\") else b\"\"\n    return run(*popenargs, stdout=PIPE, timeout=timeout, check=True, **kwargs).stdout\n\n\ndef getstatusoutput(cmd, *, encoding=None, errors=None):\n    try:\n        data = check_output(cmd, shell=True, text=True, stderr=STDOUT, encoding=encoding, errors=errors)\n        exitcode = 0\n    except CalledProcessError as ex:\n        data = ex.output\n        exitcode = ex.returncode\n    if data[-1:] == \"\\n\":\n        data = data[:-1]\n    return exitcode, data\n\n\ndef getoutput(cmd, *, encoding=None, errors=None):\n    return getstatusoutput(cmd, encoding=encoding, errors=errors)[1]\n"
