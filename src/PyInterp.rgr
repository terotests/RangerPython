    ; ---- arithmetic

    fn intPow:PyVal (base:int ex:int) {
        if (ex < 0) {
            return (this.mkFloat((py_pow (py_i2d base) (py_i2d ex))))
        }
        def r:int 1
        def b:int base
        def e:int ex
        def big:boolean false
        def approx:double 1.0
        while (e > 0) {
            if ((PyFormat.floorModInt(e 2)) == 1) {
                r = r * b
            }
            e = (PyFormat.floorDivInt(e 2))
            if (e > 0) {
                b = b * b
            }
        }
        def check:double (py_pow (py_i2d base) (py_i2d ex))
        if ((check > 9007199254740991.0) || (check < -9007199254740991.0)) {
            ; past 2^53 the integer is no longer exact here
            return (this.mkFloat(check))
        }
        return (this.mkInt(r))
    }

    sfn bitOp:int (op:string a0:int b0:int) {
        ; two's complement bit by bit (infinite sign extension), exact below 2^53
        def a:int a0
        def b:int b0
        def result:int 0
        def bit:int 1
        def k:int 0
        while (k < 62) {
            if (((a == 0) || (a == -1)) && ((b == 0) || (b == -1))) {
                break
            }
            def x:int (PyFormat.floorModInt(a 2))
            def y:int (PyFormat.floorModInt(b 2))
            def z:int 0
            if (op == "&") {
                if ((x == 1) && (y == 1)) {
                    z = 1
                }
            }
            if (op == "|") {
                if ((x == 1) || (y == 1)) {
                    z = 1
                }
            }
            if (op == "^") {
                if (x != y) {
                    z = 1
                }
            }
            if (z == 1) {
                result = result + bit
            }
            a = (PyFormat.floorDivInt(a 2))
            b = (PyFormat.floorDivInt(b 2))
            bit = bit * 2
            k = k + 1
        }
        ; the sign bits
        def sa:int 0
        if (a == -1) {
            sa = 1
        }
        def sb:int 0
        if (b == -1) {
            sb = 1
        }
        def sz:int 0
        if (op == "&") {
            if ((sa == 1) && (sb == 1)) {
                sz = 1
            }
        }
        if (op == "|") {
            if ((sa == 1) || (sb == 1)) {
                sz = 1
            }
        }
        if (op == "^") {
            if (sa != sb) {
                sz = 1
            }
        }
        if (sz == 1) {
            result = result - bit
        }
        return result
    }

    ; ---- complex numbers (re in d, im in d2)

    fn mkComplex:PyVal (re:double im:double) {
        def v (new PyVal(PyT.Complex))
        v.d = re
        v.d2 = im
        return v
    }

    fn isComplexNum:boolean (v:PyVal) {
