    fn dunderName:string (op:string) {
        if (op == "+") {
            return "add"
        }
        if (op == "-") {
            return "sub"
        }
        if (op == "*") {
            return "mul"
        }
        if (op == "/") {
            return "truediv"
        }
        if (op == "//") {
            return "floordiv"
        }
        if (op == "%") {
            return "mod"
        }
        if (op == "**") {
            return "pow"
        }
        if (op == "@") {
            return "matmul"
        }
        if (op == "&") {
            return "and"
        }
        if (op == "|") {
            return "or"
        }
        if (op == "^") {
            return "xor"
        }
        if (op == "<<") {
            return "lshift"
        }
        if (op == ">>") {
            return "rshift"
        }
        return "op"
    }

    fn repeatSeq:PyVal (seq:PyVal n:int) {
