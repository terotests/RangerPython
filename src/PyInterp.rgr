    fn evalFStr:string (n:PyNode sc:PyScope) {
        def parts:[string]
        for n.kids k:PyNode i {
            if (k.kind == PyK.StrLit) {
                push parts k.s
                continue
            }
            def v:PyVal (this.eval((unwrap k.k1) sc))
            def spec:string ""
            if (!null? k.k2) {
                spec = (this.evalFStr((unwrap k.k2) sc))
            }
            if (k.s == "r") {
                v = (this.mkStr((this.toRepr(v))))
            }
            if (k.s == "s") {
                v = (this.mkStr((this.toStr(v))))
            }
            if (k.s == "a") {
                v = (this.mkStr((this.bi.asciiOf((this.toRepr(v))))))
            }
            push parts (this.formatValue(v spec))
        }
        return (join parts "")
    }

    fn formatValue:string (v:PyVal spec:string) {
        if (v.t == PyT.Inst) {
            def m@(optional):PyVal (this.findMethod(v "__format__"))
            if (!null? m) {
                def r:PyVal (this.callMethodVal((unwrap m) v ([] _:PyVal ((this.mkStr(spec))))))
                return (this.toStr(r))
            }
        }
        if ((strlen spec) == 0) {
            return (this.toStr(v))
        }
        def sp:PySpec (PyFormat.parseSpec(spec))
        if ((strlen sp.err) > 0) {
            this.raise("ValueError" sp.err)
        }
        def out:string ""
        if (this.isIntLike(v)) {
            out = (PyFormat.formatInt(v.i sp))
        } {
            if (v.t == PyT.Float) {
                out = (PyFormat.formatFloat(v.d sp))
            } {
                if (v.t == PyT.Str) {
                    out = (PyFormat.formatStr(v.s sp))
                } {
                    if ((v.t == PyT.None) || (v.t == PyT.List) || (v.t == PyT.Tuple) || (v.t == PyT.Dict) || (v.t == PyT.Inst)) {
                        this.raise("TypeError" ("unsupported format string passed to " + (this.typeName(v)) + ".__format__"))
                    }
                    out = (PyFormat.formatStr((this.toStr(v)) sp))
                }
            }
        }
        if (startsWith out ((py_chr 0) + "!")) {
            this.raise("ValueError" (substring out 2 (strlen out)))
        }
        return out
    }

    fn evalCall:PyVal (n:PyNode sc:PyScope) {
        def fnode:PyNode (unwrap n.k1)
        def f:PyVal NONE
        ; super() with no arguments: the class the function was defined in
        if ((fnode.kind == PyK.Name) && (fnode.s == "super") && ((array_length n.kids) == 0)) {
            return (this.zeroArgSuper(sc))
        }
        f = (this.eval(fnode sc))
        def args:[PyVal]
        def kn:[string]
        def kv:[PyVal]
        for n.kids a:PyNode i {
            if (a.kind == PyK.Keyword) {
                push kn a.s
                push kv (this.eval((unwrap a.k1) sc))
                continue
            }
            if (a.kind == PyK.Starred) {
                def sv:PyVal (this.eval((unwrap a.k1) sc))
                def vals:[PyVal] (this.iterValues(sv))
                for vals x:PyVal j {
                    push args x
                }
                continue
            }
            if (a.kind == PyK.StarStar) {
                def dv:PyVal (this.eval((unwrap a.k1) sc))
                def tmp:PyVal (this.mkDict())
                this.mergeMapping(tmp dv)
                for tmp.items dk:PyVal di {
                    if (dk.t != PyT.Str) {
                        this.raise("TypeError" "keywords must be strings")
                    }
                    push kn dk.s
                    push kv (itemAt tmp.vals di)
                }
                continue
            }
            push args (this.eval(a sc))
        }
        def saved:int curLine
        if (f.t == PyT.Builtin) {
            callScope = sc
        }
        def r:PyVal (this.callValue(f args kn kv))
        curLine = saved
        return r
    }

    ; ---- eval, exec, compile

    ; parses source as a module ("exec") or an expression ("eval"); a syntax
    ; error raises SyntaxError with lineno and msg
    fn parseSource:PyNode (src:string mode:string) {
        def ps (new PyParser)
        def tree@(optional):PyNode
        try {
            if (mode == "eval") {
                tree = (ps.parseExpressionText((trim src) 1))
            } {
                tree = (ps.parseModule(src))
            }
        } {
            if ((strlen ps.err) == 0) {
                ps.err = (error_msg)
            }
        }
        if ((strlen ps.err) > 0) {
            def e:PyVal (this.makeExc((this.excClass("SyntaxError")) ps.err))
            e.putAttr("msg" (this.mkStr(ps.err)))
            e.putAttr("lineno" (this.mkInt(ps.errLine)))
            e.putAttr("offset" NONE)
            e.putAttr("text" NONE)
            e.putAttr("filename" (this.mkStr("<string>")))
            this.raiseVal(e)
        }
        def t:PyNode (unwrap tree)
        return t
    }

    fn codeOf:PyVal (src:PyVal mode:string) {
        if ((src.t == PyT.Builtin) && (src.mode == "code")) {
            return src
        }
        if (src.t != PyT.Str) {
            this.raise("TypeError" (mode + "() arg 1 must be a string, bytes or code object"))
        }
        def c (new PyVal(PyT.Builtin))
        c.s = "<code>"
        c.mode = "code"
        c.putAttr("co_source" src)
        c.putAttr("co_mode" (this.mkStr(mode)))
        def tree:PyNode (this.parseSource(src.s mode))
        c.node = tree
        return c
    }

    ; the scope a run of code sees: the caller's, or one over a dict
    fn scopeFor:PyScope (g:PyVal l:PyVal) {
        def ns:PyVal g
        if ((ns.t == PyT.None) && (l.t == PyT.Dict)) {
            ns = l
        }
        if (ns.t == PyT.None) {
            return callScope
        }
        if (ns.t != PyT.Dict) {
            this.raise("TypeError" ("globals must be a dict, not " + (this.typeName(ns))))
        }
        def sc (new PyScope)
        for ns.items k:PyVal i {
            if (k.t == PyT.Str) {
                set sc.vars k.s (itemAt ns.vals i)
            }
        }
        if ((l.t == PyT.Dict) && ((this.same(l ns)) == false)) {
            for l.items k2:PyVal i2 {
                if (k2.t == PyT.Str) {
                    set sc.vars k2.s (itemAt l.vals i2)
                }
            }
        }
        return sc
    }

    fn writeBack:void (sc:PyScope g:PyVal l:PyVal) {
        def ns:PyVal g
        if ((l.t == PyT.Dict) && ((ns.t == PyT.None) || ((this.same(l ns)) == false))) {
            ns = l
        }
        if (ns.t != PyT.Dict) {
            return
        }
        def ks:[string] (keys sc.vars)
        for ks k:string i {
            this.dictSet(ns (this.mkStr(k)) (unwrap (get sc.vars k)))
        }
    }

    fn runCode:PyVal (fname:string src:PyVal g:PyVal l:PyVal) {
        def mode:string fname
        def code:PyVal (this.codeOf(src mode))
        def cm@(optional):PyVal (get code.attrs "co_mode")
        if (!null? cm) {
            def cmv:PyVal (unwrap cm)
            mode = cmv.s
        }
        def tree:PyNode (unwrap code.node)
        def sc:PyScope (this.scopeFor(g l))
        def saved:int curLine
        def result:PyVal NONE
        if (mode == "eval") {
            result = (this.eval(tree sc))
        } {
            this.hoistDecls(tree.body sc)
            this.setupAnn(tree.body sc)
            this.execBlock(tree.body sc)
        }
        curLine = saved
        this.writeBack(sc g l)
        return result
    }

    fn zeroArgSuper:PyVal (sc:PyScope) {
        if ((array_length frames) == 0) {
            this.raise("RuntimeError" "super(): no arguments")
        }
        def fr:PyFrame (last frames)
        if ((null? fr.func) || (null? fr.self)) {
            this.raise("RuntimeError" "super(): no arguments")
        }
        def f:PyVal (unwrap fr.func)
        if (null? f.cls) {
            this.raise("RuntimeError" "super(): __class__ cell not found")
        }
        def s (new PyVal(PyT.Super))
        s.cls = f.cls
        s.self = fr.self
        return s
    }

    ; ---- calls

    fn makeFunction:PyVal (n:PyNode name:string sc:PyScope) {
        def f (new PyVal(PyT.Func))
        f.s = name
        f.node = n
        ; a function defined in a class body sees the class's enclosing scope
        def closure:PyScope sc
        while (closure.isClass && (!null? closure.parent)) {
            closure = (unwrap closure.parent)
        }
        if closure.isClass {
            closure = (this.moduleScope(closure))
        }
        f.scope = closure
        for n.kids p:PyNode i {
            if (!null? p.k1) {
                set f.defs p.s (this.eval((unwrap p.k1) sc))
            }
        }
        if (n.kind == PyK.Def) {
            def asc:PyScope sc
            if ((array_length n.tparams) > 0) {
                ; def f[T]: T is seen by the annotations and the body
                def ts (new PyScope)
                ts.parent = closure
                ts.globals = (this.moduleScope(sc))
                f.putAttr("__type_params__" (this.bindTypeParams(n.tparams ts)))
                f.scope = ts
                asc = ts
            }
            def ann:PyVal (this.mkDict())
            for n.kids p2:PyNode i2 {
                if (!null? p2.k2) {
                    this.dictSet(ann (this.mkStr(p2.s)) (this.eval((unwrap p2.k2) asc)))
                }
            }
            if (!null? n.k3) {
                this.dictSet(ann (this.mkStr("return")) (this.eval((unwrap n.k3) asc)))
            }
            if ((array_length ann.items) > 0) {
                f.putAttr("__annotations__" ann)
            }
        }
        return f
    }

    fn funcAttr@(optional):PyVal (f:PyVal name:string) {
        def none@(optional):PyVal
        def node:PyNode (unwrap f.node)
        def r@(optional):PyVal
        if (name == "__name__") {
            r = (this.mkStr(f.s))
            return r
        }
        if (name == "__qualname__") {
            if ((strlen node.qual) > 0) {
                r = (this.mkStr(node.qual))
            } {
                r = (this.mkStr(f.s))
            }
            return r
        }
        if (name == "__doc__") {
            if (node.kind == PyK.Def) {
                r = (this.docOf(node.body))
                return r
            }
            r = NONE
            return r
        }
        if (name == "__module__") {
            r = (this.moduleName((unwrap f.scope)))
            return r
        }
        if (name == "__annotations__") {
            def ad:PyVal (this.mkDict())
            f.putAttr("__annotations__" ad)
            r = ad
            return r
        }
        if (name == "__type_params__") {
            r = (this.mkTuple(([] _:PyVal ())))
            return r
        }
        if ((name == "__defaults__") || (name == "__kwdefaults__")) {
            def pos:[PyVal]
            def kwd:PyVal (this.mkDict())
            def kwOnly:boolean false
            for node.kids p:PyNode i {
                if ((p.i == 1) || (p.i == 3)) {
                    kwOnly = true
                }
                if (has f.defs p.s) {
                    if kwOnly {
                        this.dictSet(kwd (this.mkStr(p.s)) (unwrap (get f.defs p.s)))
                    } {
                        push pos (unwrap (get f.defs p.s))
                    }
                }
            }
            if (name == "__defaults__") {
                if ((array_length pos) == 0) {
                    r = NONE
                    return r
                }
                r = (this.mkTuple(pos))
                return r
            }
            if ((array_length kwd.items) == 0) {
                r = NONE
                return r
            }
            r = kwd
            return r
        }
        if (name == "__dict__") {
            def dd:PyVal (this.mkDict())
            for (f.attrKeys()) k:string ki {
                this.dictSet(dd (this.mkStr(k)) (unwrap (get f.attrs k)))
            }
            r = dd
            return r
        }
        if (name == "__globals__") {
            def gs:PyScope (this.moduleScope((unwrap f.scope)))
            def gd:PyVal (this.mkDict())
            for (keys gs.vars) gk:string gi {
                this.dictSet(gd (this.mkStr(gk)) (unwrap (get gs.vars gk)))
            }
            r = gd
            return r
        }
        if (name == "__closure__") {
            r = NONE
            return r
        }
        if (name == "__code__") {
            def co (new PyVal(PyT.Inst))
            co.cls = (this.codeClass())
            co.putAttr("co_name" (this.mkStr(f.s)))
            co.putAttr("co_qualname" (this.mkStr(node.qual)))
            co.putAttr("co_firstlineno" (this.mkInt(node.line)))
            co.putAttr("co_filename" (this.mkStr("<script>")))
            def argc:int 0
            def kwc:int 0
            def posonly:int 0
            def flags:int 0
            def names:[PyVal]
            def kwOnly2:boolean false
            for node.kids p3:PyNode i3 {
                if (p3.i == 4) {
                    posonly = argc
                }
                if (p3.i == 1) {
                    flags = flags + 4
                    kwOnly2 = true
                }
                if (p3.i == 2) {
                    flags = flags + 8
                }
                if (p3.i == 3) {
                    kwOnly2 = true
                }
                if (p3.i == 0) {
                    if kwOnly2 {
                        kwc = kwc + 1
                    } {
                        argc = argc + 1
                    }
                }
            }
            for node.kids p4:PyNode i4 {
                if ((p4.i == 0)) {
                    push names (this.mkStr(p4.s))
                }
            }
            for node.kids p5:PyNode i5 {
                if ((p5.i == 1) || (p5.i == 2)) {
                    push names (this.mkStr(p5.s))
                }
            }
            if (node.i == 1) {
                flags = flags + 32
            }
            co.putAttr("co_argcount" (this.mkInt(argc)))
            co.putAttr("co_kwonlyargcount" (this.mkInt(kwc)))
            co.putAttr("co_posonlyargcount" (this.mkInt(posonly)))
            co.putAttr("co_flags" (this.mkInt(flags)))
            co.putAttr("co_varnames" (this.mkTuple(names)))
            co.putAttr("co_nlocals" (this.mkInt((array_length names))))
            r = co
            return r
        }
        return none
    }

    def codeCls@(optional):PyVal

    fn codeClass:PyVal () {
        if (null? codeCls) {
            def c (new PyVal(PyT.Class))
            c.s = "code"
            codeCls = c
        }
        return (unwrap codeCls)
    }

    fn execTypeAlias:void (n:PyNode sc:PyScope) {
        def ts:PyScope sc
        def tps:PyVal (this.mkTuple(([] _:PyVal ())))
        if ((array_length n.tparams) > 0) {
            def tsc (new PyScope)
            tsc.parent = sc
            tsc.globals = (this.moduleScope(sc))
            tps = (this.bindTypeParams(n.tparams tsc))
            ts = tsc
        }
        ; the value is lazy in CPython: a name defined later is fine
        def val:PyVal NONE
        try {
            val = (this.eval((unwrap n.k1) ts))
        } {
            this.takeException((error_msg))
        }
        def tat:PyVal (this.getAttr((this.importModule("typing")) "TypeAliasType"))
        def kn:[string]
        def kv:[PyVal]
        push kn "type_params"
        push kv tps
        def alias:PyVal (this.callValue(tat ([] _:PyVal ((this.mkStr(n.s)) val)) kn kv))
        this.store(n.s alias sc)
    }

    ; T, *Ts, **P bound as typing.TypeVar in sc; their tuple
    fn bindTypeParams:PyVal (names:[string] sc:PyScope) {
        def tv:PyVal (this.getAttr((this.importModule("typing")) "TypeVar"))
        def out:[PyVal]
        for names nm:string i {
            def kn:[string]
            def kv:[PyVal]
            push kn "infer_variance"
            push kv TRUE
            def v:PyVal (this.callValue(tv ([] _:PyVal ((this.mkStr(nm)))) kn kv))
            set sc.vars nm v
            push out v
        }
        return (this.mkTuple(out))
    }

    ; the docstring of a def or class body, or None
    fn docOf:PyVal (body:[PyNode]) {
        if ((array_length body) > 0) {
            def st:PyNode (itemAt body 0)
            if ((st.kind == PyK.ExprStmt) && (!null? st.k1)) {
                def e:PyNode (unwrap st.k1)
                if (e.kind == PyK.StrLit) {
                    return (this.mkStr(e.s))
                }
            }
        }
        return NONE
    }

    fn moduleName:PyVal (sc:PyScope) {
        def ms:PyScope (this.moduleScope(sc))
        def nm@(optional):PyVal (get ms.vars "__name__")
        if (null? nm) {
            return (this.mkStr("__main__"))
        }
        return (unwrap nm)
    }

    fn callValue:PyVal (f:PyVal args:[PyVal] kn:[string] kv:[PyVal]) {
        switch f.t {
            case PyT.Func {
                return (this.callFunc(f args kn kv))
            }
            case PyT.Bound {
                def self:PyVal (unwrap f.self)
                if (null? f.cls) {
                    return (this.meth.callMethod(self f.s args kn kv))
                }
                def all:[PyVal]
                push all self
                for args a:PyVal i {
                    push all a
                }
                def fn2:PyVal (unwrap f.cls)
                if (fn2.t == PyT.Func) {
                    return (this.callFunc(fn2 all kn kv))
                }
                return (this.callValue(fn2 all kn kv))
            }
            case PyT.Builtin {
                if (!null? f.wrapped) {
                    return (this.mods.callWrapped(f args kn kv))
                }
                return (this.bi.call(f.s args kn kv))
            }
            case PyT.Class {
                if (!null? f.cls) {
                    def mcall@(optional):PyVal (this.classLookup((unwrap f.cls) "__call__"))
                    if ((!null? mcall) && ((this.orNone(mcall)).t == PyT.Func)) {
                        def mall:[PyVal]
                        push mall f
                        for args ma:PyVal mai {
                            push mall ma
                        }
                        return (this.callValue((unwrap mcall) mall kn kv))
                    }
                }
                return (this.instantiate(f args kn kv))
            }
            case PyT.Inst {
                def m@(optional):PyVal (this.findMethod(f "__call__"))
                if (!null? m) {
                    def mv:PyVal (unwrap m)
                    if ((mv.t == PyT.Inst) || (mv.t == PyT.Bound)) {
                        return (this.callValue(mv args kn kv))
                    }
                    def all2:[PyVal]
                    push all2 f
                    for args a2:PyVal i2 {
                        push all2 a2
                    }
                    return (this.callValue((unwrap m) all2 kn kv))
                }
            }
            case PyT.Static {
                return (this.callValue((unwrap f.wrapped) args kn kv))
            }
        }
        if (this.isDataSub(f)) {
            def dm@(optional):PyVal (this.findMethod(f "__call__"))
            if (!null? dm) {
                def all3:[PyVal]
                push all3 f
                for args a3:PyVal i3 {
                    push all3 a3
                }
                return (this.callValue((unwrap dm) all3 kn kv))
            }
        }
        this.raise("TypeError" ("'" + (this.typeName(f)) + "' object is not callable"))
        return NONE
    }

    fn callFunc:PyVal (f:PyVal args:[PyVal] kn:[string] kv:[PyVal]) {
        def node:PyNode (unwrap f.node)
        def sc (new PyScope)
        sc.parent = f.scope
        def fsc:PyScope (unwrap f.scope)
        sc.globals = (this.moduleScope(fsc))
        this.bindArgs(f node sc args kn kv)
        if ((array_length frames) >= maxDepth) {
            this.raise("RecursionError" "maximum recursion depth exceeded")
        }
        def fr (new PyFrame)
        fr.func = f
        fr.name = f.s
        fr.line = curLine
        fr.callLine = curLine
        if ((array_length args) > 0) {
            fr.self = (itemAt args 0)
        }
        push frames fr
        def result:PyVal NONE
        def failed:boolean false
        def err:PyVal NONE
        def outerGen@(optional):PyGen curGen
        def noGen@(optional):PyGen
        curGen = noGen
        if (node.kind == PyK.Lambda) {
            try {
                result = (this.eval((unwrap node.k1) sc))
            } {
                failed = true
                err = (this.takeException((error_msg)))
            }
        } {
            this.hoistDecls(node.body sc)
            if (node.i == 1) {
                def gen (new PyGen)
                gen.func = f
                gen.node = node
                gen.scope = sc
                gen.name = f.s
                gen.line = node.line
                if ((array_length args) > 0) {
                    gen.selfv = (itemAt args 0)
                }
                def g (new PyVal(PyT.Gen))
                g.gen = gen
                g.s = f.s
                result = g
            } {
                try {
                    def sig:int (this.execBlock(node.body sc))
                    if (sig == 3) {
                        result = retVal
                    }
                } {
                    failed = true
                    err = (this.takeException((error_msg)))
                }
            }
        }
        removeLast frames
        curGen = outerGen
        if failed {
            this.reraise(err)
        }
        retVal = NONE
        return result
    }

    fn reraise:void (e:PyVal) {
        excValue = e
        py_raise ("python exception")
    }

    ; global / nonlocal statements anywhere in the body apply to all of it
    fn hoistDecls:void (body:[PyNode] sc:PyScope) {
        for body st:PyNode i {
            if (st.kind == PyK.Global) {
                for st.strs nm:string j {
                    set sc.decl nm 1
                }
            }
            if (st.kind == PyK.Nonlocal) {
                for st.strs nm2:string j2 {
                    set sc.decl nm2 2
                }
            }
            if ((st.kind == PyK.If) || (st.kind == PyK.While) || (st.kind == PyK.For) || (st.kind == PyK.With) || (st.kind == PyK.Try)) {
                this.hoistDecls(st.body sc)
                this.hoistDecls(st.orelse sc)
                this.hoistDecls(st.final sc)
                for st.handlers h:PyNode k {
                    this.hoistDecls(h.body sc)
                }
            }
        }
    }

    fn bindArgs:void (f:PyVal node:PyNode sc:PyScope args:[PyVal] kn:[string] kv:[PyVal]) {
        def params:[PyNode] node.kids
        def nargs:int (array_length args)
        def ai:int 0
        def afterStar:boolean false
        def kwParam:string ""
        def positional:int 0
        def bound:[string:boolean]
        for params p:PyNode i {
            if (p.i == 4) {
                continue
            }
            if (p.i == 3) {
                afterStar = true
                continue
            }
            if (p.i == 1) {
                def rest:[PyVal]
                while (ai < nargs) {
                    push rest (itemAt args ai)
                    ai = ai + 1
                }
                set sc.vars p.s (this.mkTuple(rest))
                set bound p.s true
                afterStar = true
                continue
            }
            if (p.i == 2) {
                kwParam = p.s
                continue
            }
            if (afterStar == false) {
                positional = positional + 1
                if (ai < nargs) {
                    set sc.vars p.s (itemAt args ai)
                    set bound p.s true
                    ai = ai + 1
                }
            }
        }
        if (ai < nargs) {
            this.raise("TypeError" (f.s + "() takes " + (to_string positional) + " positional argument" + (this.plural(positional)) + " but " + (to_string nargs) + " " + (this.wasWere(nargs)) + " given"))
        }
        def kwDict:PyVal (this.mkDict())
        for kn name:string k {
            def found:boolean false
            for params p2:PyNode j {
                if ((p2.i == 0) && (p2.s == name)) {
                    found = true
                }
            }
            if found {
                if (has bound name) {
                    this.raise("TypeError" (f.s + "() got multiple values for argument '" + name + "'"))
                }
