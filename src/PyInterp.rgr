        def s@(optional):PyScope sc
        while (!null? s) {
            def cur:PyScope (unwrap s)
            def v@(optional):PyVal (get cur.vars name)
            if (!null? v) {
                return v
            }
            s = cur.parent
        }
        def g2:PyScope (this.moduleScope(sc))
        def gv2@(optional):PyVal (get g2.vars name)
        if (!null? gv2) {
            return gv2
        }
        return (get builtins name)
    }

    fn store:void (name:string val:PyVal sc:PyScope) {
        def d@(optional):int (get sc.decl name)
