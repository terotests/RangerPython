            }
        }
        def made@(optional):PyVal (this.mods.make(name))
        if (null? made) {
            made = (this.importFromFiles(name))
        }
        if (null? made) {
            this.raise("ModuleNotFoundError" ("No module named '" + name + "'"))
        }
        def mv:PyVal (unwrap made)
        set modules name mv
        this.dictSet(sysModules (this.mkStr(name)) mv)
        if (!null? parent) {
            def pv:PyVal (unwrap parent)
            pv.putAttr((substring name (dot + 1) (strlen name)) mv)
        }
        return mv
    }

    ; name.py or name/__init__.py in the working folder or a search path folder
    fn importFromFiles@(optional):PyVal (name:string) {
        def none@(optional):PyVal
        def rel:string (replace name "." "/")
        def roots:[string]
        push roots ""
        for searchPath sp:string i {
            push roots sp
