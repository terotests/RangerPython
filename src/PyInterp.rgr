    fn plural:string (n:int) {
        if (n == 1) {
            return ""
        }
        return "s"
    }

    fn wasWere:string (n:int) {
        if (n == 1) {
            return "was"
        }
        return "were"
    }

    fn instantiate:PyVal (cls:PyVal args:[PyVal] kn:[string] kv:[PyVal]) {
