        for roots root:string j {
            def base:string rel
            if ((strlen root) > 0) {
                base = (root + "/" + rel)
            }
            def cands:[string]
            push cands (base + ".py")
            push cands (base + "/__init__.py")
            for cands c:string k {
                def src@(optional):string (fs.read(c))
                if (!null? src) {
                    def mod:PyVal (this.runModuleSource(name (unwrap src)))
                    mod.putAttr("__file__" (this.mkStr((fs.normalize(c)))))
                    if (endsWith c "/__init__.py") {
                        mod.putAttr("__path__" (this.mkList(([] _:PyVal ((this.mkStr((fs.normalize(base)))))))))
                    }
