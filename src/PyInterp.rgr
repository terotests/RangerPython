        set sc.vars name val
    }

    fn deleteName:void (name:string sc:PyScope) {
        def d@(optional):int (get sc.decl name)
        if ((!null? d) && ((unwrap d) == 1)) {
            def g:PyScope (this.moduleScope(sc))
