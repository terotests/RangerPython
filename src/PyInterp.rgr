; ============================================================================
; PyInterp.rgr — the tree-walking evaluator.
;
; Statements return a signal (0 go on, 1 break, 2 continue, 3 return with
; the value in retVal). A Python exception is a value in excValue and an
; unwinding of the host stack (py_raise) to the nearest `try` statement or
; to the run; a host error caught on the way (a stack overflow, a bug in the
; runtime) becomes a RecursionError or a RuntimeError there.
;
; Generators run to the end when called and give an iterator over what they
; yielded (a generator that never ends stops at the step limit).
; ============================================================================

Import "PyOps.rgr"
Import "PyAst.rgr"
Import "PyValue.rgr"
Import "PyFormat.rgr"
Import "PyFs.rgr"
Import "PyParser.rgr"
Import "PyBuiltins.rgr"
Import "PyMethods.rgr"
Import "PyModules.rgr"

; what a running generator has yielded so far
class PyGenFrame {
    def items:[PyVal]
}

; a call in progress: for super() and the traceback
class PyFrame {
    def func@(optional):PyVal
    def self@(optional):PyVal
    def name:string ""
    def line:int 0
    ; the caller's line when the call was made
    def callLine:int 0
}

class PyInterp {
    def fs:PyFileSystem (new PyFileSystem)
    def outParts:[string]
    ; print to the host as lines are completed (print), besides keeping them
    def echo:boolean false
    def pendingLine:string ""
    def builtins:[string:PyVal]
    def modules:[string:PyVal]
    def NONE:PyVal (new PyVal(PyT.None))
    def TRUE:PyVal (new PyVal(PyT.Bool))
    def FALSE:PyVal (new PyVal(PyT.Bool))
    def NOTIMPL:PyVal (new PyVal(PyT.Builtin))
    def excValue@(optional):PyVal
    ; the exceptions being handled (bare raise re-raises the last)
    def handling:[PyVal]
    def retVal:PyVal (new PyVal(PyT.None))
    def nextId:int 1
    def maxDepth:int 200
    def steps:int 0
    def maxSteps:int 0
    ; an endless generator stops here instead of filling memory
    def maxYield:int 1000000
    def curLine:int 0
    def frames:[PyFrame]
    def genStack:[PyGenFrame]
    def reprDepth:int 0
    def globals:PyScope (new PyScope)
    def bi:PyBuiltins
    def meth:PyMethods
    def mods:PyModules
    def argv:[string]

    Constructor (filesystem:PyFileSystem) {
        fs = filesystem
        TRUE.i = 1
        NOTIMPL.s = "NotImplemented"
        retVal = NONE
        globals = (new PyScope)
        bi = (new PyBuiltins(this))
        meth = (new PyMethods(this))
        mods = (new PyModules(this))
        bi.install()
        this.resetGlobals()
    }

    fn resetGlobals:void () {
        globals = (new PyScope)
        set globals.vars "__name__" (this.mkStr("__main__"))
        set globals.vars "__file__" (this.mkStr("<script>"))
    }

    ; ---- values

    fn newId:int () {
        nextId = nextId + 1
        return nextId
    }

    fn idOf:int (v:PyVal) {
        if (v.id == 0) {
            v.id = (this.newId())
        }
        return v.id
    }

    fn mkInt:PyVal (n:int) {
        def v (new PyVal(PyT.Int))
        v.i = n
        return v
    }

    fn mkFloat:PyVal (x:double) {
        def v (new PyVal(PyT.Float))
        v.d = x
        return v
    }

    fn mkStr:PyVal (s:string) {
        def v (new PyVal(PyT.Str))
        v.s = s
        return v
    }

    fn mkBool:PyVal (b:boolean) {
        if b {
            return TRUE
        }
        return FALSE
    }

    fn mkList:PyVal (items:[PyVal]) {
        def v (new PyVal(PyT.List))
        v.items = items
        return v
    }

    fn mkTuple:PyVal (items:[PyVal]) {
        def v (new PyVal(PyT.Tuple))
        v.items = items
        return v
    }

    fn mkDict:PyVal () {
        return (new PyVal(PyT.Dict))
    }

    fn mkSet:PyVal () {
        return (new PyVal(PyT.Set))
    }

    fn mkIter:PyVal (items:[PyVal]) {
        def v (new PyVal(PyT.Iter))
        v.items = items
        v.s = "iterator"
        return v
    }

    fn mkBuiltinMethod:PyVal (self:PyVal name:string) {
        def b (new PyVal(PyT.Bound))
        b.self = self
        b.s = name
        return b
    }

    ; xs[i], or None past the end (for conditions the compiler may evaluate early)
    fn argAt:PyVal (xs:[PyVal] i:int) {
        if ((i >= 0) && (i < (array_length xs))) {
            return (itemAt xs i)
        }
        return NONE
    }

    fn orNone:PyVal (v@(optional):PyVal) {
        if (null? v) {
            return NONE
        }
        def got:PyVal (unwrap v)
        return got
    }

    fn pair:PyVal (a:PyVal b:PyVal) {
        def it:[PyVal]
        push it a
        push it b
        return (this.mkTuple(it))
    }

    fn isNum:boolean (v:PyVal) {
        return ((v.t == PyT.Int) || (v.t == PyT.Bool) || (v.t == PyT.Float))
    }

    fn isIntLike:boolean (v:PyVal) {
        return ((v.t == PyT.Int) || (v.t == PyT.Bool))
    }

    fn toDouble:double (v:PyVal) {
        if (v.t == PyT.Float) {
            return v.d
        }
        return (py_i2d v.i)
    }

    ; ---- exceptions

    fn excClass:PyVal (name:string) {
        def c@(optional):PyVal (get builtins name)
        if (null? c) {
            def e:PyVal (unwrap (get builtins "Exception"))
            return e
        }
        return (unwrap c)
    }

    fn makeExc:PyVal (cls:PyVal msg:string) {
        def e (new PyVal(PyT.Inst))
        e.cls = cls
        def args:[PyVal]
        if ((strlen msg) > 0) {
            push args (this.mkStr(msg))
        }
        set e.attrs "args" (this.mkTuple(args))
        return e
    }

    fn raise:void (name:string msg:string) {
        def e:PyVal (this.makeExc((this.excClass(name)) msg))
        this.raiseVal(e)
    }

    fn raiseVal:void (e:PyVal) {
        if ((has e.attrs "__line__") == false) {
            set e.attrs "__line__" (this.mkInt(curLine))
            set e.attrs "__trace__" (this.mkStr((this.traceText())))
        }
        excValue = e
        py_raise ("python exception")
    }

    ; CPython's layout: the outermost call first, then each call made from
    ; there, and the line that raised last; a run of the same line (deep
    ; recursion) is folded after three
    fn markExc:void (e:PyVal) {
        if ((has e.attrs "__line__") == false) {
            set e.attrs "__line__" (this.mkInt(curLine))
            set e.attrs "__trace__" (this.mkStr((this.traceText())))
        }
    }

    fn traceText:string () {
        def where:[string]
        def caller:string "<module>"
        for frames f:PyFrame i {
            push where ("  File \"<script>\", line " + (to_string f.callLine) + ", in " + caller)
            caller = f.name
        }
        push where ("  File \"<script>\", line " + (to_string curLine) + ", in " + caller)
        def lines:[string]
        push lines "Traceback (most recent call last):"
        def prev:string ""
        def run:int 0
        for where w:string j {
            if (w == prev) {
                run = run + 1
                if (run >= 3) {
                    continue
                }
            } {
                if (run >= 3) {
                    push lines ("  [Previous line repeated " + (to_string (run - 2)) + " more time" + (this.plural((run - 2))) + "]")
                }
                run = 0
            }
            push lines w
            prev = w
        }
        if (run >= 3) {
            push lines ("  [Previous line repeated " + (to_string (run - 2)) + " more time" + (this.plural((run - 2))) + "]")
        }
        return (join lines "\n")
    }

    ; the exception that unwound to a `try`: the Python one, or a host error
    ; turned into one
    fn takeException:PyVal (msg:string) {
        if (!null? excValue) {
            def e:PyVal (unwrap excValue)
            this.clearExc()
            return e
        }
        def low:string (to_lowercase msg)
        if (((indexOf low "call stack") >= 0) || ((indexOf low "stack overflow") >= 0) || ((indexOf low "recursion") >= 0) || ((indexOf low "goroutine stack exceeds") >= 0)) {
            def rx:PyVal (this.makeExc((this.excClass("RecursionError")) "maximum recursion depth exceeded"))
            this.markExc(rx)
            return rx
        }
        return (this.makeExc((this.excClass("RuntimeError")) ("internal error: " + msg)))
    }

    fn clearExc:void () {
        def none@(optional):PyVal
        excValue = none
    }

    fn excMatches:boolean (e:PyVal cls:PyVal) {
        if (cls.t == PyT.Tuple) {
            for cls.items c:PyVal i {
                if (this.excMatches(e c)) {
                    return true
                }
            }
            return false
        }
        if (cls.t != PyT.Class) {
            this.raise("TypeError" "catching classes that do not inherit from BaseException is not allowed")
        }
        if (null? e.cls) {
            return false
        }
        def ec:PyVal (unwrap e.cls)
        return (this.isSubclass(ec cls))
    }

    fn excMessage:string (e:PyVal) {
        def name:string "Exception"
        if (!null? e.cls) {
            def c:PyVal (unwrap e.cls)
            name = c.s
        }
        def text:string (this.toStr(e))
        if ((strlen text) == 0) {
            return name
        }
        return (name + ": " + text)
    }

    ; ---- steps and depth

    fn tick:void () {
        steps = steps + 1
        if ((maxSteps > 0) && (steps > maxSteps)) {
            this.raise("TimeoutError" ("the script ran more than " + (to_string maxSteps) + " steps"))
        }
    }

    ; ---- output

    fn writeOut:void (s:string) {
        push outParts s
        if echo {
            def cs:[int] (to_chars s)
            def start:int 0
            def n:int (array_length cs)
            def i:int 0
            while (i < n) {
                if ((itemAt cs i) == 10) {
                    print (pendingLine + (py_codes_to_str cs start i))
                    pendingLine = ""
                    start = i + 1
                }
                i = i + 1
            }
            if (start < n) {
                pendingLine = pendingLine + (py_codes_to_str cs start n)
            }
        }
    }

    fn flushEcho:void () {
        if (echo && ((strlen pendingLine) > 0)) {
            print pendingLine
            pendingLine = ""
        }
    }

    fn output:string () {
        return (join outParts "")
    }

    ; ---- truth, length, type names

    fn typeName:string (v:PyVal) {
        if (((v.t == PyT.List) || (v.t == PyT.Dict) || (v.t == PyT.Tuple)) && (has v.attrs "__class__")) {
            def tc:PyVal (unwrap (get v.attrs "__class__"))
            return tc.s
        }
        switch v.t {
            case PyT.None {
                return "NoneType"
            }
            case PyT.Bool {
                return "bool"
            }
            case PyT.Int {
                return "int"
            }
            case PyT.Float {
                return "float"
            }
            case PyT.Str {
                return "str"
            }
            case PyT.List {
                return "list"
            }
            case PyT.Tuple {
                return "tuple"
            }
            case PyT.Dict {
                return "dict"
            }
            case PyT.Set {
                if (v.mode == "frozen") {
                    return "frozenset"
                }
                return "set"
            }
            case PyT.Func {
                return "function"
            }
            case PyT.Builtin {
                if (this.isTypeBuiltin(v.s)) {
                    return "type"
                }
                return "builtin_function_or_method"
            }
            case PyT.Class {
                return "type"
            }
            case PyT.Inst {
                if (!null? v.cls) {
                    def c:PyVal (unwrap v.cls)
                    return c.s
                }
                return "object"
            }
            case PyT.Module {
                return "module"
            }
            case PyT.Bound {
                if (null? v.cls) {
                    return "builtin_function_or_method"
                }
                return "method"
            }
            case PyT.Range {
                return "range"
            }
            case PyT.File {
                return "TextIOWrapper"
            }
            case PyT.Iter {
                return v.s
            }
            case PyT.Slice {
                return "slice"
            }
            case PyT.Prop {
                return "property"
            }
            case PyT.Static {
                return "staticmethod"
            }
            case PyT.ClassM {
                return "classmethod"
            }
            case PyT.Super {
                return "super"
            }
        }
        return "object"
    }

    fn isTypeBuiltin:boolean (name:string) {
        def ts:[string] ([] _:string ("int" "float" "str" "bool" "list" "tuple" "dict" "set" "frozenset" "object" "type" "range" "slice" "enumerate" "zip" "map" "filter" "reversed" "property" "staticmethod" "classmethod" "super"))
        for ts t:string i {
            if (t == name) {
                return true
            }
        }
        return false
    }

    fn truthy:boolean (v:PyVal) {
        switch v.t {
            case PyT.None {
                return false
            }
            case PyT.Bool {
                return (v.i != 0)
            }
            case PyT.Int {
                return (v.i != 0)
            }
            case PyT.Float {
                return (v.d != 0.0)
            }
            case PyT.Str {
                return ((strlen v.s) > 0)
            }
            case PyT.List {
                return ((array_length v.items) > 0)
            }
            case PyT.Tuple {
                return ((array_length v.items) > 0)
            }
            case PyT.Dict {
                return ((array_length v.items) > 0)
            }
            case PyT.Set {
                return ((array_length v.items) > 0)
            }
            case PyT.Range {
                return ((this.rangeLen(v)) > 0)
            }
            case PyT.Inst {
                def b@(optional):PyVal (this.findMethod(v "__bool__"))
                if (!null? b) {
                    def r:PyVal (this.callMethodVal((unwrap b) v ([] _:PyVal ())))
                    return (this.truthy(r))
                }
                def l@(optional):PyVal (this.findMethod(v "__len__"))
                if (!null? l) {
                    def r2:PyVal (this.callMethodVal((unwrap l) v ([] _:PyVal ())))
                    return (r2.i != 0)
                }
                return true
            }
        }
        return true
    }

    fn rangeLen:int (r:PyVal) {
        if (r.i3 > 0) {
            if (r.i2 <= r.i) {
                return 0
            }
            return (PyFormat.floorDivInt(((r.i2 - r.i) + (r.i3 - 1)) r.i3))
        }
        if (r.i2 >= r.i) {
            return 0
        }
        def st:int (0 - r.i3)
        return (PyFormat.floorDivInt(((r.i - r.i2) + (st - 1)) st))
    }

    fn length:int (v:PyVal) {
        switch v.t {
            case PyT.Str {
                return (v.strLen())
            }
            case PyT.List {
                return (array_length v.items)
            }
            case PyT.Tuple {
                return (array_length v.items)
            }
            case PyT.Dict {
                return (array_length v.items)
            }
            case PyT.Set {
                return (array_length v.items)
            }
            case PyT.Range {
                return (this.rangeLen(v))
            }
            case PyT.Inst {
                def l@(optional):PyVal (this.findMethod(v "__len__"))
                if (!null? l) {
                    def r:PyVal (this.callMethodVal((unwrap l) v ([] _:PyVal ())))
                    if ((this.isIntLike(r)) == false) {
                        this.raise("TypeError" "__len__ must return an integer")
                    }
                    return r.i
                }
            }
        }
        this.raise("TypeError" ("object of type '" + (this.typeName(v)) + "' has no len()"))
        return 0
    }

    ; ---- str and repr

    fn toStr:string (v:PyVal) {
        switch v.t {
            case PyT.Str {
                return v.s
            }
            case PyT.Inst {
                def m@(optional):PyVal (this.findMethod(v "__str__"))
                if (!null? m) {
                    def r:PyVal (this.callMethodVal((unwrap m) v ([] _:PyVal ())))
                    if (r.t != PyT.Str) {
                        this.raise("TypeError" "__str__ returned non-string")
                    }
                    return r.s
                }
                if (this.isExcInst(v)) {
                    def args:PyVal (this.excArgs(v))
                    def n:int (array_length args.items)
                    if (n == 0) {
                        return ""
                    }
                    if (n == 1) {
                        if (this.excMatches(v (this.excClass("KeyError")))) {
                            return (this.toRepr((itemAt args.items 0)))
                        }
                        return (this.toStr((itemAt args.items 0)))
                    }
                    return (this.toRepr(args))
                }
                return (this.toRepr(v))
            }
        }
        return (this.toRepr(v))
    }

    fn isExcInst:boolean (v:PyVal) {
        if ((v.t != PyT.Inst) || (null? v.cls)) {
            return false
        }
        def c:PyVal (unwrap v.cls)
        return c.isExc
    }

    fn excArgs:PyVal (v:PyVal) {
        def a@(optional):PyVal (get v.attrs "args")
        if (null? a) {
            return (this.mkTuple(([] _:PyVal ())))
        }
        return (unwrap a)
    }

    fn hexId:string (v:PyVal) {
        def n:int ((this.idOf(v)) * 16 + 140000000000)
        return ("0x" + (PyFormat.intBase(n 16 false)))
    }

    fn joinRepr:string (items:[PyVal]) {
        def parts:[string]
        for items it:PyVal i {
            push parts (this.toRepr(it))
        }
        return (join parts ", ")
    }

    fn toRepr:string (v:PyVal) {
        switch v.t {
            case PyT.None {
                return "None"
            }
            case PyT.Bool {
                if (v.i != 0) {
                    return "True"
                }
                return "False"
            }
            case PyT.Int {
                return (to_string v.i)
            }
            case PyT.Float {
                return (PyFormat.floatRepr(v.d))
            }
            case PyT.Str {
                return (PyFormat.strRepr(v.s))
            }
        }
        reprDepth = reprDepth + 1
        if (reprDepth > 60) {
            reprDepth = reprDepth - 1
            return "..."
        }
        def r:string (this.toReprObj(v))
        reprDepth = reprDepth - 1
        return r
    }

    fn toReprObj:string (v:PyVal) {
        if (((v.t == PyT.List) || (v.t == PyT.Dict) || (v.t == PyT.Tuple)) && (has v.attrs "__class__")) {
            def cr:string (this.mods.reprOf(v))
            if ((strlen cr) > 0) {
                return cr
            }
        }
        if ((v.t == PyT.List) && (startsWith v.mode "dict_")) {
            return (v.mode + "([" + (this.joinRepr(v.items)) + "])")
        }
        switch v.t {
            case PyT.List {
                return ("[" + (this.joinRepr(v.items)) + "]")
            }
            case PyT.Tuple {
                if ((array_length v.items) == 1) {
                    return ("(" + (this.toRepr((itemAt v.items 0))) + ",)")
                }
                return ("(" + (this.joinRepr(v.items)) + ")")
            }
            case PyT.Dict {
                def parts:[string]
                for v.items k:PyVal i {
                    push parts ((this.toRepr(k)) + ": " + (this.toRepr((itemAt v.vals i))))
                }
                return ("{" + (join parts ", ") + "}")
            }
            case PyT.Set {
                if (v.mode == "frozen") {
                    if ((array_length v.items) == 0) {
                        return "frozenset()"
                    }
                    return ("frozenset({" + (this.joinRepr(v.items)) + "})")
                }
                if ((array_length v.items) == 0) {
                    return "set()"
                }
                return ("{" + (this.joinRepr(v.items)) + "}")
            }
            case PyT.Func {
                return ("<function " + v.s + " at " + (this.hexId(v)) + ">")
            }
            case PyT.Builtin {
                if (this.isTypeBuiltin(v.s)) {
                    return ("<class '" + v.s + "'>")
                }
                if (v.s == "NotImplemented") {
                    return "NotImplemented"
                }
                if (v.s == "Ellipsis") {
                    return "Ellipsis"
                }
                def bd2:int (lastIndexOf v.s ".")
                return ("<built-in function " + (substring v.s (bd2 + 1) (strlen v.s)) + ">")
            }
            case PyT.Class {
                if (v.mode == "builtin") {
                    return ("<class '" + v.s + "'>")
                }
                if (v.mode == "native") {
                    if (has v.attrs "_fields") {
                        return ("<class '__main__." + v.s + "'>")
                    }
                    return ("<class 'collections." + v.s + "'>")
                }
                return ("<class '__main__." + v.s + "'>")
            }
            case PyT.Inst {
                def m@(optional):PyVal (this.findMethod(v "__repr__"))
                if (!null? m) {
                    def r:PyVal (this.callMethodVal((unwrap m) v ([] _:PyVal ())))
                    if (r.t != PyT.Str) {
                        this.raise("TypeError" "__repr__ returned non-string")
                    }
                    return r.s
                }
                if (this.isExcInst(v)) {
                    def args:PyVal (this.excArgs(v))
                    def c:PyVal (unwrap v.cls)
                    if ((array_length args.items) == 1) {
                        return (c.s + "(" + (this.toRepr((itemAt args.items 0))) + ")")
                    }
                    return (c.s + (this.toRepr(args)))
                }
                return ("<__main__." + (this.typeName(v)) + " object at " + (this.hexId(v)) + ">")
            }
            case PyT.Module {
                return ("<module '" + v.s + "'>")
            }
            case PyT.Bound {
                if (null? v.cls) {
                    return ("<built-in method " + v.s + ">")
                }
                def f:PyVal (unwrap v.cls)
                return ("<bound method " + f.s + ">")
            }
            case PyT.Range {
                if (v.i3 == 1) {
                    return ("range(" + (to_string v.i) + ", " + (to_string v.i2) + ")")
                }
                return ("range(" + (to_string v.i) + ", " + (to_string v.i2) + ", " + (to_string v.i3) + ")")
            }
            case PyT.File {
                return ("<_io.TextIOWrapper name=" + (PyFormat.strRepr(v.s)) + " mode=" + (PyFormat.strRepr(v.mode)) + " encoding='UTF-8'>")
            }
            case PyT.Iter {
                return ("<" + v.s + " object at " + (this.hexId(v)) + ">")
            }
            case PyT.Slice {
                return ("slice(" + (this.joinRepr(v.items)) + ")")
            }
        }
        return ("<" + (this.typeName(v)) + " object>")
    }

    ; ---- hashing and equality

    fn hashKey:string (v:PyVal) {
        switch v.t {
            case PyT.None {
                return "N"
            }
            case PyT.Bool {
                return ("i" + (to_string v.i))
            }
            case PyT.Int {
                return ("i" + (to_string v.i))
            }
            case PyT.Float {
                if (((py_floor v.d) == v.d) && (v.d < 9000000000000000.0) && (v.d > -9000000000000000.0)) {
                    return ("i" + (to_string (py_trunc v.d)))
                }
                return ("f" + (PyFormat.floatRepr(v.d)))
            }
            case PyT.Str {
                return ("s" + v.s)
            }
            case PyT.Tuple {
                def parts:[string]
                for v.items it:PyVal i {
                    push parts (this.hashKey(it))
                }
                return ("t(" + (join parts (py_chr 1)) + ")")
