                        matches = (this.excMatches(caught hv))
                    } {
                        hfail = true
                        herr = (this.takeException((error_msg)))
                    }
                    if hfail {
                        pending = herr
                        break
                    }
                }
                if matches {
                    handled = true
                    def none@(optional):PyVal
                    pending = none
                    if ((strlen h.s) > 0) {
                        this.store(h.s caught sc)
                    }
                    push handling caught
                    def bfail:boolean false
                    def berr:PyVal NONE
                    try {
                        sig = (this.execBlock(h.body sc))
                    } {
                        bfail = true
                        berr = (this.takeException((error_msg)))
                    }
                    removeLast handling
                    if ((strlen h.s) > 0) {
                        py_map_del sc.vars h.s
                    }
                    if bfail {
                        if ((this.isExcInst(berr)) && ((has berr.attrs "__context__") == false) && ((this.same(berr caught)) == false)) {
                            set berr.attrs "__context__" caught
                        }
                        pending = berr
                    }
                }
            }
        } {
            if ((sig == 0) && ((array_length n.orelse) > 0)) {
                def ofail:boolean false
                def oerr:PyVal NONE
                try {
                    sig = (this.execBlock(n.orelse sc))
                } {
                    ofail = true
                    oerr = (this.takeException((error_msg)))
                }
                if ofail {
                    pending = oerr
                }
            }
        }
        if ((array_length n.final) > 0) {
            def keepRet:PyVal retVal
            def fsig:int (this.execBlock(n.final sc))
            if (fsig != 0) {
                return fsig
            }
            retVal = keepRet
        }
        if (!null? pending) {
            this.reraise((unwrap pending))
        }
        return sig
    }

    fn execRaise:void (n:PyNode sc:PyScope) {
        if (null? n.k1) {
            if ((array_length handling) == 0) {
                this.raise("RuntimeError" "No active exception to reraise")
            }
            this.reraise((last handling))
        }
        def v:PyVal (this.eval((unwrap n.k1) sc))
        def e:PyVal v
        if (v.t == PyT.Class) {
            def kn:[string]
            def kv:[PyVal]
            e = (this.instantiate(v ([] _:PyVal ()) kn kv))
        }
        if ((this.isExcInst(e)) == false) {
            this.raise("TypeError" "exceptions must derive from BaseException")
        }
        if (!null? n.k2) {
            def cause:PyVal (this.eval((unwrap n.k2) sc))
            set e.attrs "__cause__" cause
        }
        this.raiseVal(e)
    }

    fn execWith:int (n:PyNode idx:int sc:PyScope) {
        if (idx >= (array_length n.kids)) {
            return (this.execBlock(n.body sc))
        }
        def item:PyNode (itemAt n.kids idx)
        def ctx:PyVal (this.eval((unwrap item.k1) sc))
        def entered:PyVal (this.callAttr(ctx "__enter__" ([] _:PyVal ())))
        if (!null? item.k2) {
            this.assign((unwrap item.k2) entered sc)
        }
        def sig:int 0
        def failed:boolean false
        def err:PyVal NONE
        try {
            sig = (this.execWith(n (idx + 1) sc))
        } {
            failed = true
            err = (this.takeException((error_msg)))
        }
        if failed {
            def cls:PyVal NONE
            if (!null? err.cls) {
                cls = (unwrap err.cls)
            }
            def keep:PyVal (this.callAttr(ctx "__exit__" ([] _:PyVal (cls err NONE))))
            if ((this.truthy(keep)) == false) {
                this.reraise(err)
            }
            return 0
        }
        def keepRet:PyVal retVal
        this.callAttr(ctx "__exit__" ([] _:PyVal (NONE NONE NONE)))
        retVal = keepRet
        return sig
    }

    fn callAttr:PyVal (obj:PyVal name:string args:[PyVal]) {
        def m:PyVal (this.getAttr(obj name))
        def kn:[string]
        def kv:[PyVal]
        return (this.callValue(m args kn kv))
    }

    ; ---- imports

    fn importModule:PyVal (name:string) {
        def m@(optional):PyVal (get modules name)
        if (!null? m) {
            return (unwrap m)
        }
        def made@(optional):PyVal (this.mods.make(name))
        if (null? made) {
            ; a .py file in the virtual filesystem's working folder
            def path:string ((replace name "." "/") + ".py")
            def src@(optional):string (fs.read(path))
            if (null? src) {
                this.raise("ModuleNotFoundError" ("No module named '" + name + "'"))
            }
            def mod:PyVal (this.runModuleSource(name (unwrap src)))
            set modules name mod
            return mod
        }
        def mv:PyVal (unwrap made)
        set modules name mv
        return mv
    }

    fn runModuleSource:PyVal (name:string src:string) {
        def ps (new PyParser)
        def tree:PyNode (ps.parseModule(src))
        if ((strlen ps.err) > 0) {
            this.raise("SyntaxError" (ps.err + " (" + name + ".py, line " + (to_string ps.errLine) + ")"))
        }
        def mod (new PyVal(PyT.Module))
        mod.s = name
        set modules name mod
        def msc (new PyScope)
        set msc.vars "__name__" (this.mkStr(name))
        this.execBlock(tree.body msc)
        def ks:[string] (keys msc.vars)
        for ks k:string i {
            set mod.attrs k (unwrap (get msc.vars k))
        }
        return mod
    }

    fn execImport:void (n:PyNode sc:PyScope) {
        def i:int 0
        while (i < (array_length n.strs)) {
            def name:string (itemAt n.strs i)
            def alias:string (itemAt n.names i)
            def mod:PyVal (this.importModule(name))
            if ((strlen alias) > 0) {
                this.store(alias mod sc)
            } {
                ; import os.path binds os
                def dot:int (indexOf name ".")
                if (dot > 0) {
                    def top:string (substring name 0 dot)
                    this.store(top (this.importModule(top)) sc)
                } {
                    this.store(name mod sc)
                }
            }
            i = i + 1
        }
    }

    fn execFromImport:void (n:PyNode sc:PyScope) {
        if (n.s == "__future__") {
            return
        }
        def mod:PyVal (this.importModule(n.s))
        def i:int 0
        while (i < (array_length n.strs)) {
            def name:string (itemAt n.strs i)
            if (name == "*") {
                def ks:[string] (keys mod.attrs)
                for ks k:string j {
                    if ((startsWith k "_") == false) {
                        this.store(k (unwrap (get mod.attrs k)) sc)
                    }
                }
            } {
                def alias:string (itemAt n.names i)
                def v@(optional):PyVal (get mod.attrs name)
                if (null? v) {
                    ; a submodule: from os import path
                    def sub@(optional):PyVal (this.mods.make((n.s + "." + name)))
                    if (null? sub) {
                        this.raise("ImportError" ("cannot import name '" + name + "' from '" + n.s + "'"))
                    }
                    v = sub
                }
                if ((strlen alias) > 0) {
                    this.store(alias (unwrap v) sc)
                } {
                    this.store(name (unwrap v) sc)
                }
            }
            i = i + 1
        }
    }

    ; ---- running a module

    fn runTree:void (tree:PyNode) {
        this.execBlock(tree.body globals)
    }
}
