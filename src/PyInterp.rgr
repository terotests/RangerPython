        }
        return x
    }

    sfn hypot:double (a:double b:double) {
        def x:double (PyInterp.fabs(a))
        def y:double (PyInterp.fabs(b))
        if ((py_isinf x) || (py_isinf y)) {
            return (py_inf)
        }
        if (x < y) {
