            }
            if ((st.kind == PyK.If) || (st.kind == PyK.While) || (st.kind == PyK.For) || (st.kind == PyK.With) || (st.kind == PyK.Try)) {
                this.hoistDecls(st.body sc)
                this.hoistDecls(st.orelse sc)
                this.hoistDecls(st.final sc)
                for st.handlers h:PyNode k {
