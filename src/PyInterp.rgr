        def sb:int 0
        if (b == -1) {
            sb = 1
        }
        def sz:int 0
        if (op == "&") {
            if ((sa == 1) && (sb == 1)) {
                sz = 1
            }
        }
        if (op == "|") {
            if ((sa == 1) || (sb == 1)) {
                sz = 1
            }
        }
        if (op == "^") {
