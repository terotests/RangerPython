; ============================================================================
; PyValue.rgr — a Python value, and a scope of names.
;
; One tagged class for every value. `t` says what it is; the fields each tag
; uses are listed below. Strings are immutable, so a string's code points
; (what indexing, slicing and len count) are worked out once and kept.
;
;   None, Bool (i 0/1), Int (i), Float (d), Str (s)
;   List, Tuple (items)
;   Dict (items = keys, vals = values, index: hash key -> position)
;   Set (items, index)
;   Func (s name, node Def/Lambda, scope closure, defs default values)
;   Builtin (s name): a built-in function or type (int, str, len, …)
;   Class (s name, attrs namespace, bases, vals the method resolution order);
;         exceptions are classes too
;   Inst (cls, attrs)
;   Module (s name, attrs)
;   Bound (self receiver; cls the function, or none and s a built-in method)
;   Range (i start, i2 stop, i3 step)
;   File (s path, mode, pos read position, closed)
;   Iter (items, pos): what iter(), map(), zip(), a generator … give
;   Slice (items: start, stop, step)
;   Prop (wrapped getter, setter), Static, ClassM (wrapped function)
;   Super (cls: the class to look after, self)
;   Gen (gen): a generator, run a step at a time
;   Complex (d real, d2 imaginary)
;   Func and Class keep their defining class in cls (for super())
; ============================================================================

Import "PyOps.rgr"
Import "PyAst.rgr"

Enum PyT:int (
    None
    Bool
    Int
    Float
    Str
    List
    Tuple
    Dict
    Set
    Func
    Builtin
    Class
    Inst
    Module
    Bound
    Range
    File
    Iter
    Slice
    Prop
    Static
    ClassM
    Super
    Gen
    Complex
)

class PyVal {
    def t:PyT PyT.None
    def i:int 0
    def i2:int 0
    def i3:int 0
    def d:double 0.0
    ; Complex: the imaginary part (the real one in d)
    def d2:double 0.0
    def s:string ""
    def items:[PyVal]
    def vals:[PyVal]
    def index:[string:int]
    def attrs:[string:PyVal]
    def akeys:[string]
    def defs:[string:PyVal]
    def bases:[PyVal]
    def cls@(optional):PyVal
    def self@(optional):PyVal
    def wrapped@(optional):PyVal
    def setter@(optional):PyVal
    def node@(optional):PyNode
    def scope@(optional):PyScope
    def id:int 0
    def pos:int 0
    def mode:string ""
    def closed:boolean false
    ; Class: one of the built-in exception classes, or derived from one
    def isExc:boolean false
    ; Str: the code points, once asked for
    def cps:[int]
    def cpsKnown:boolean false
    def gen@(optional):PyGen
    ; a lazy chain: the iterator being read
    def cur@(optional):PyVal
    ; Class: the built-in type it derives from (int, list, …), "native" for
    ; a runtime class (Counter, deque, …) kept in wrapped
    def bt:string ""
    ; Inst: its __dict__ once asked for, kept in step with attrs; the dict
    ; knows its owner
    ; Class: whether instances are limited to __slots__ (0 not worked out
    ; yet, 1 free, 2 limited to slotNames)
    def slotsKnown:int 0
    def slotNames:[string:boolean]
    def dictv@(optional):PyVal
    def owner@(optional):PyVal

    Constructor (tag:PyT) {
        t = tag
    }

    ; attrs in the order they were first set (Go's maps have none)
    fn putAttr:void (k:string v:PyVal) {
        if ((has attrs k) == false) {
            push akeys k
        }
        set attrs k v
        if (!null? dictv) {
            this.mirrorPut(k v)
        }
    }

    fn delAttrKey:void (k:string) {
        py_map_del attrs k
        def kept:[string]
        for akeys a:string i {
            if (a != k) {
                push kept a
            }
        }
        akeys = kept
        if (!null? dictv) {
            this.mirrorDel(k)
        }
    }

    fn mirrorPut:void (k:string v:PyVal) {
        def d:PyVal (unwrap dictv)
        def hk:string ("s" + k)
        def at@(optional):int (get d.index hk)
        if (null? at) {
            set d.index hk (array_length d.items)
            def ks (new PyVal(PyT.Str))
            ks.s = k
            push d.items ks
            push d.vals v
            return
        }
        set_at d.vals (unwrap at) v
    }

    fn mirrorDel:void (k:string) {
        def d:PyVal (unwrap dictv)
        def hk:string ("s" + k)
        def at@(optional):int (get d.index hk)
        if (null? at) {
            return
        }
        def p:int (unwrap at)
        remove_index d.items p
        remove_index d.vals p
        py_map_del d.index hk
        def n:int (array_length d.items)
        while (p < n) {
            def it:PyVal (itemAt d.items p)
            if (it.t == PyT.Str) {
                set d.index ("s" + it.s) p
            }
            p = p + 1
        }
    }

    ; an owned dict changed by a dict method: the owner's attrs follow
    fn ownerSync:void () {
        def o:PyVal (unwrap owner)
        def na:[string:PyVal]
        def nk:[string]
        def n:int (array_length items)
        def i:int 0
        while (i < n) {
            def it:PyVal (itemAt items i)
            if (it.t == PyT.Str) {
                if ((has na it.s) == false) {
                    push nk it.s
                }
                set na it.s (itemAt vals i)
            }
            i = i + 1
        }
        o.attrs = na
        o.akeys = nk
    }

    fn attrKeys:[string] () {
        def out:[string]
        def seen:[string:boolean]
        for akeys a:string i {
            if ((has attrs a) && ((has seen a) == false)) {
                push out a
                set seen a true
            }
        }
        if ((array_length out) != (array_length (keys attrs))) {
            ; set straight through a scope that shares this map
            def rest:[string] (keys attrs)
            for rest r:string j {
                if ((has seen r) == false) {
                    push out r
                    push akeys r
                }
            }
        }
        return out
    }

    fn codes:[int] () {
        if (cpsKnown == false) {
            cps = (to_chars s)
            cpsKnown = true
        }
        return cps
    }

    fn strLen:int () {
        def c:[int] (this.codes())
        return (array_length c)
    }
}

class PyScope {
    def vars:[string:PyVal]
    ; the enclosing function's scope (closures); none at module level
    def parent@(optional):PyScope
    ; the module scope; none when this is the module scope
    def globals@(optional):PyScope
    ; names declared global (1) or nonlocal (2) in this scope
    def decl:[string:int]
    def isClass:boolean false
    ; a class body's names in the order they were first set (the vars map
    ; has no order on every target)
    def order:[string]

    fn put:void (name:string v:PyVal) {
        if (isClass && ((has vars name) == false)) {
            push order name
        }
        set vars name v
    }

    fn orderedKeys:[string] () {
        if (isClass == false) {
            return (keys vars)
        }
        def out:[string]
        def seen:[string:boolean]
        for order k:string i {
            if ((has vars k) && ((has seen k) == false)) {
                set seen k true
                push out k
            }
        }
        def vk:[string] (keys vars)
        for vk k2:string j {
            if ((has seen k2) == false) {
                push out k2
            }
        }
        return out
    }
}

; ----------------------------------------------------------------------------
; Generators. A generator runs its body until a yield, then unwinds the host
; stack to the call that resumed it. Each block, loop, if, try and with that
; runs inside the body keeps a slot in `live` saying where it is; resuming
; walks back down the same slots and continues from there. The statement
; that yielded runs again, and its yields give, in order, what was sent to
; them (res), so the next yield in it is the one that suspends.
; ----------------------------------------------------------------------------

; what one yield in a statement gave back
class PyGenRes {
    ; 0 a value, 1 an exception to raise, 2 a `yield from` still delegating
    def kind:int 0
    def v:PyVal (new PyVal(PyT.None))
    ; a delegating yield from: what to pass on next (sendKind 1 throws it)
    def send:PyVal (new PyVal(PyT.None))
    def sendKind:int 0
}

class PyGenSlot {
    ; block: statement; while/for/try: phase; if: branch
    def i:int 0
    ; for: position; try: the handler
    def j:int 0
    ; try: the signal waiting for finally
    def sig:int 0
    ; for: the iterator; try: the exception handled; with: the manager
    def v:PyVal (new PyVal(PyT.None))
    ; try: the exception waiting for finally, and the return value kept
    def w@(optional):PyVal
    def keep:PyVal (new PyVal(PyT.None))
    def res:[PyGenRes]
    def used:int 0
    def resumed:boolean false
}

class PyGen {
    def func@(optional):PyVal
    def node@(optional):PyNode
    def scope@(optional):PyScope
    def selfv@(optional):PyVal
    def name:string ""
    def live:[PyGenSlot]
    def depth:int 0
    def started:boolean false
    def done:boolean false
    def running:boolean false
    ; the value yielded, or returned when done
    def out:PyVal (new PyVal(PyT.None))
    def line:int 0
}
