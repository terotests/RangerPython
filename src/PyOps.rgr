    py_atan2 _:double (a:double b:double) {
        templates {
            rust ( "f64::atan2(" (e 1) ", " (e 2) ")" )
            es6 ( "Math.atan2(" (e 1) ", " (e 2) ")" )
            go ( "math.Atan2(" (e 1) ", " (e 2) ")" (imp "math") )
            python ( "math.atan2(" (e 1) ", " (e 2) ")" (imp "math") )
        }
    }
    py_sqrt _:double (a:double) {
        templates {
            rust ( "f64::sqrt(" (e 1) ")" )
            es6 ( "Math.sqrt(" (e 1) ")" )
            go ( "math.Sqrt(" (e 1) ")" (imp "math") )
            python ( "py_rt_sqrt(" (e 1) ")" (imp "math")
(create_polyfill "
def py_rt_sqrt(a):
    if a >= 0:
        return math.sqrt(a)
    return math.nan
") )
        }
    }
    py_floor _:double (a:double) {
        templates {
            rust ( "f64::floor(" (e 1) ")" )
            es6 ( "Math.floor(" (e 1) ")" )
            go ( "math.Floor(" (e 1) ")" (imp "math") )
            python ( "py_rt_floor(" (e 1) ")" (imp "math")
(create_polyfill "
def py_rt_floor(a):
    if a != a or a in (math.inf, -math.inf):
        return a
    return float(math.floor(a))
") )
        }
    }
    py_ceil _:double (a:double) {
        templates {
            rust ( "f64::ceil(" (e 1) ")" )
            es6 ( "Math.ceil(" (e 1) ")" )
            go ( "math.Ceil(" (e 1) ")" (imp "math") )
            python ( "py_rt_ceil(" (e 1) ")" (imp "math")
(create_polyfill "
def py_rt_ceil(a):
    if a != a or a in (math.inf, -math.inf):
        return a
    return float(math.ceil(a))
") )
        }
    }
    py_isnan _:boolean (a:double) {
        templates {
            rust ( "f64::is_nan(" (e 1) ")" )
            es6 ( "Number.isNaN(" (e 1) ")" )
            go ( "math.IsNaN(" (e 1) ")" (imp "math") )
            python ( "math.isnan(" (e 1) ")" (imp "math") )
        }
    }
    py_isinf _:boolean (a:double) {
        templates {
            rust ( "f64::is_infinite(" (e 1) ")" )
            es6 ( "(Math.abs(" (e 1) ") === Infinity)" )
            go ( "math.IsInf(" (e 1) ", 0)" (imp "math") )
            python ( "math.isinf(" (e 1) ")" (imp "math") )
        }
    }
    py_inf _:double () {
        templates {
            rust ( "f64::INFINITY" )
            es6 ( "Infinity" )
            go ( "math.Inf(1)" (imp "math") )
            python ( "math.inf" (imp "math") )
        }
    }
    py_nan _:double () {
        templates {
            rust ( "f64::NAN" )
            es6 ( "NaN" )
            go ( "math.NaN()" (imp "math") )
            python ( "math.nan" (imp "math") )
        }
    }
    ; int -> double, the same on every target
    py_i2d _:double (a:int) {
        templates {
            rust ( "((" (e 1) ") as f64)" )
            es6 ( "(" (e 1) ")" )
            go ( "float64(" (e 1) ")" )
            python ( "float(" (e 1) ")" )
        }
    }
    ; double -> int toward zero (Python's int(x)); the caller checks the range
    py_trunc _:int (a:double) {
        templates {
            rust ( "((" (e 1) ") as i64)" )
            es6 ( "Math.trunc(" (e 1) ")" )
            go ( "int64(" (e 1) ")" )
            python ( "int(" (e 1) ")" )
        }
    }
    ; one code point as text
    py_chr _:string (code:int) {
        templates {
            rust ( "std::char::from_u32((" (e 1) ") as u32).unwrap_or('\\u{FFFD}').to_string()" )
            es6 ( "String.fromCodePoint(" (e 1) ")" )
            go ( "string(rune(" (e 1) "))" )
            python ( "chr(" (e 1) ")" )
        }
    }
    ; code points [start, end) as text
    py_codes_to_str _:string (cs:[int] start:int end:int) {
        templates {
            rust ( "(" (e 1) ")[((" (e 2) ") as usize)..((" (e 3) ") as usize)].iter().map(|c| std::char::from_u32(*c as u32).unwrap_or('\\u{FFFD}')).collect::<String>()" )
            es6 ( "py_rt_codes(" (e 1) ", " (e 2) ", " (e 3) ")"
(create_polyfill "
function py_rt_codes(cs, s, e) {
  let out = \"\";
  for (let i = s; i < e; i += 4096) {
    out += String.fromCodePoint.apply(null, cs.slice(i, Math.min(e, i + 4096)));
  }
  return out;
}
") )
            go ( "py_rt_codes(" (e 1) ", " (e 2) ", " (e 3) ")" (imp "strings")
(create_polyfill "
func py_rt_codes(cs []int64, s int64, e int64) string {
	var b strings.Builder
	for i := s; i < e; i++ {
		b.WriteRune(rune(cs[i]))
	}
	return b.String()
}
") )
            python ( "\"\".join(map(chr, " (e 1) "[" (e 2) ":" (e 3) "]))" )
        }
    }
    ; the shortest text that reads back as the same double, in whatever
    ; notation the target writes; PyFormat.floatRepr rewrites it as Python does
    py_float_digits _:string (a:double) {
        templates {
            rust ( "format!(\"{:e}\", " (e 1) ")" )
            es6 ( "String(" (e 1) ")" )
            go ( "strconv.FormatFloat(" (e 1) ", 'e', -1, 64)" (imp "strconv") )
            python ( "repr(" (e 1) ")" )
        }
    }
    ; parse a float literal (already checked to be one); NaN if not
    py_parse_float _:double (s:string) {
        templates {
            rust ( "(" (e 1) ").trim().parse::<f64>().unwrap_or(f64::NAN)" )
            es6 ( "Number(" (e 1) ")" )
            go ( "py_rt_parse_float(" (e 1) ")" (imp "strconv") (imp "math")
(create_polyfill "
func py_rt_parse_float(s string) float64 {
	v, err := strconv.ParseFloat(s, 64)
	if err != nil {
		if ne, ok := err.(*strconv.NumError); ok && ne.Err == strconv.ErrRange {
			return v
		}
		return math.NaN()
	}
	return v
}
") )
            python ( "py_rt_parse_float(" (e 1) ")"
(create_polyfill "
def py_rt_parse_float(s):
    try:
        return float(s)
    except ValueError:
        return float('nan')
") )
        }
    }
    ; milliseconds since the epoch
    py_now_ms _:double () {
        templates {
            rust ( "(std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos() as f64 / 1e6)" )
            es6 ( "Date.now()" )
            go ( "float64(time.Now().UnixNano()) / 1e6" (imp "time") )
            python ( "(time.time() * 1000.0)" (imp "time") )
        }
    }
    ; unsigned 32-bit bit operations (random's Mersenne Twister)
    py_xor32 _:int (a:int b:int) {
        templates {
            rust ( "((((" (e 1) ") as u32) ^ ((" (e 2) ") as u32)) as i64)" )
            es6 ( "((" (e 1) " ^ " (e 2) ") >>> 0)" )
            go ( "int64(uint32(" (e 1) ") ^ uint32(" (e 2) "))" )
            python ( "((" (e 1) " ^ " (e 2) ") & 0xffffffff)" )
        }
    }
    py_and32 _:int (a:int b:int) {
        templates {
            rust ( "((((" (e 1) ") as u32) & ((" (e 2) ") as u32)) as i64)" )
            es6 ( "((" (e 1) " & " (e 2) ") >>> 0)" )
            go ( "int64(uint32(" (e 1) ") & uint32(" (e 2) "))" )
            python ( "((" (e 1) " & " (e 2) ") & 0xffffffff)" )
        }
    }
    py_or32 _:int (a:int b:int) {
        templates {
            rust ( "((((" (e 1) ") as u32) | ((" (e 2) ") as u32)) as i64)" )
            es6 ( "((" (e 1) " | " (e 2) ") >>> 0)" )
            go ( "int64(uint32(" (e 1) ") | uint32(" (e 2) "))" )
            python ( "((" (e 1) " | " (e 2) ") & 0xffffffff)" )
        }
    }
    py_shr32 _:int (a:int n:int) {
        templates {
            rust ( "((((" (e 1) ") as u32) >> ((" (e 2) ") as u32)) as i64)" )
            es6 ( "(" (e 1) " >>> " (e 2) ")" )
            go ( "int64(uint32(" (e 1) ") >> uint(" (e 2) "))" )
            python ( "((" (e 1) " & 0xffffffff) >> " (e 2) ")" )
        }
    }
    py_shl32 _:int (a:int n:int) {
        templates {
            rust ( "((((" (e 1) ") as u32).wrapping_shl((" (e 2) ") as u32)) as i64)" )
            es6 ( "((" (e 1) " << " (e 2) ") >>> 0)" )
            go ( "int64(uint32(" (e 1) ") << uint(" (e 2) "))" )
            python ( "((" (e 1) " << " (e 2) ") & 0xffffffff)" )
        }
    }
    ; drop a key from a map (Ranger has no map delete)
    py_map_del _:void (m@(mutates):[K:T] key:K) {
        templates {
            rust ( (e 1) ".rg_remove(&*" (e 2) ");"
(create_polyfill "
trait RgRemove<K> {
    fn rg_remove<Q: ?Sized + std::hash::Hash + Eq>(&mut self, k: &Q) where K: std::borrow::Borrow<Q>;
}
impl<K: std::hash::Hash + Eq, V> RgRemove<K> for RgOrderedMap<K, V> {
    fn rg_remove<Q: ?Sized + std::hash::Hash + Eq>(&mut self, k: &Q) where K: std::borrow::Borrow<Q> {
        if self.slot(k) == -1 { return; }
        self.entries.retain(|e| e.0.borrow() != k);
        self.rehash();
    }
}
") )
            es6 ( "delete " (e 1) "[" (e 2) "]" )
            go ( "delete(" (e 1) ", " (e 2) ")" )
            python ( (e 1) ".pop(" (e 2) ", None)" )
        }
    }
    ; Rust has no exceptions: the Rust build (scripts/build.mjs --rust)
    ; rewrites each `try { A } { B }` as py_rust_try with B under an `if`,
    ; and `error_msg` in B as py_rust_err. A raise is a panic, caught here.
    py_rust_try _:void (failed@(mutates):boolean body:block) {
        templates {
            rust ( (e 1) " = rg_catch(std::panic::AssertUnwindSafe(|| {" (block 2) "}));"
(create_polyfill "
thread_local! { static RG_ERR: std::cell::RefCell<String> = std::cell::RefCell::new(String::new()); }
fn rg_catch<F: FnOnce()>(f: std::panic::AssertUnwindSafe<F>) -> bool {
    match std::panic::catch_unwind(f) {
        Ok(_) => false,
        Err(e) => {
            let msg = if let Some(s) = e.downcast_ref::<String>() { s.clone() } else if let Some(s) = e.downcast_ref::<&str>() { s.to_string() } else { String::from(\"panic\") };
            RG_ERR.with(|r| *r.borrow_mut() = msg);
            true
        }
    }
}
fn rg_last_err() -> String { RG_ERR.with(|r| r.borrow().clone()) }
") )
            * ( "" )
        }
    }
    py_rust_err _:string () {
        templates {
            rust ( "rg_last_err()" )
            * ( "\"\"" )
        }
    }
    ; host setup before a run: Python-built runtimes need a deeper stack
    py_host_setup _:void () {
        templates {
            rust ( "std::panic::set_hook(Box::new(|_| {}));" )
            es6 ( "" )
            go ( "" )
            python ( "sys.setrecursionlimit(200000)" (imp "sys") )
        }
    }
}
