                isp.zero = sp.zero
                isp.alt = sp.alt
                if ((t == "x") || (t == "X") || (t == "o")) {
                    isp.type = t
                }
                def digitsOut:string (PyFormat.formatInt(iv2.i isp))
                if (sp.prec > 0) {
                    ; %.3d pads the digits with zeros
                    def body:string (PyFormat.intBase(iv2.i 10 false))
                    if ((t == "x") || (t == "X")) {
                        body = (PyFormat.intBase(iv2.i 16 (t == "X")))
                    }
                    if (t == "o") {
                        body = (PyFormat.intBase(iv2.i 8 false))
                    }
                    while ((strlen body) < sp.prec) {
                        body = "0" + body
                    }
                    def psp (new PySpec)
                    psp.width = sp.width
                    psp.align = sp.align
                    if (psp.align == "=") {
                        psp.align = ">"
                    }
                    digitsOut = (PyFormat.pad((PyFormat.signText((iv2.i < 0) sp)) body psp true))
                }
                push out digitsOut
                continue
            }
            if ((t == "f") || (t == "F") || (t == "e") || (t == "E") || (t == "g") || (t == "G")) {
                def fsp (new PySpec)
                fsp.width = sp.width
                fsp.align = sp.align
                fsp.fill = sp.fill
                fsp.sign = sp.sign
                fsp.zero = sp.zero
                fsp.alt = sp.alt
                fsp.prec = sp.prec
                fsp.type = t
                def fo:string (PyFormat.formatFloat((this.toNum(v)) fsp))
                push out fo
                continue
            }
            ip.raise("ValueError" ("unsupported format character '" + t + "' (0x" + (PyFormat.intBase(tc 16 false)) + ")"))
        }
        if ((array_length lit) > 0) {
            push out (py_codes_to_str lit 0 (array_length lit))
        }
        if ((usedMapping == false) && (ai < (array_length args)) && (mapping == false)) {
            ip.raise("TypeError" "not all arguments converted during string formatting")
        }
        return (join out "")
    }
}
