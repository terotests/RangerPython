; ============================================================================
; PyBuiltins.rgr — the built-in functions and types (print, len, range, int,
; sorted, isinstance, open, …), the built-in exception classes, and
; printf-style formatting (str % args).
; ============================================================================

Import "PyOps.rgr"
Import "PyValue.rgr"
Import "PyFormat.rgr"
Import "PyInterp.rgr"

class PyBuiltins {
    def ip:PyInterp
    def MISSING:PyVal (new PyVal(PyT.None))

    Constructor (interp:PyInterp) {
        ip = interp
    }

    fn put:void (name:string) {
        def b (new PyVal(PyT.Builtin))
        b.s = name
        set ip.builtins name b
    }

    fn excClassMake:PyVal (name:string base:PyVal) {
        def c (new PyVal(PyT.Class))
        c.s = name
        c.isExc = true
        c.mode = "builtin"
        if (base.t == PyT.Class) {
            push c.bases base
        }
        ip.computeMro(c)
        set ip.builtins name c
        return c
    }

    fn install:void () {
        def names:[string] ([] _:string ("print" "len" "range" "enumerate" "zip" "map" "filter" "sorted" "reversed" "sum" "min" "max" "abs" "round" "int" "float" "complex" "str" "bool" "list" "tuple" "dict" "set" "frozenset" "isinstance" "issubclass" "type" "repr" "ascii" "chr" "ord" "hex" "oct" "bin" "divmod" "pow" "any" "all" "open" "format" "hash" "id" "iter" "next" "getattr" "setattr" "hasattr" "delattr" "callable" "input" "vars" "globals" "locals" "dir" "property" "staticmethod" "classmethod" "super" "object" "slice" "exit" "quit" "__object_init__" "__build_class__" "__import__" "eval" "exec" "compile"))
        for names n:string i {
            this.put(n)
        }
        this.put("NotImplemented")
        def ni:PyVal ip.NOTIMPL
        set ip.builtins "NotImplemented" ni
        this.put("Ellipsis")
        set ip.builtins "__debug__" ip.TRUE
        def base:PyVal (this.excClassMake("BaseException" ip.NONE))
        def exc:PyVal (this.excClassMake("Exception" base))
        this.excClassMake("SystemExit" base)
        this.excClassMake("KeyboardInterrupt" base)
        this.excClassMake("GeneratorExit" base)
        def arith:PyVal (this.excClassMake("ArithmeticError" exc))
        this.excClassMake("ZeroDivisionError" arith)
        this.excClassMake("OverflowError" arith)
        this.excClassMake("FloatingPointError" arith)
        def look:PyVal (this.excClassMake("LookupError" exc))
        this.excClassMake("IndexError" look)
        this.excClassMake("KeyError" look)
        def val:PyVal (this.excClassMake("ValueError" exc))
        def uni:PyVal (this.excClassMake("UnicodeError" val))
        this.excClassMake("UnicodeDecodeError" uni)
        this.excClassMake("UnicodeEncodeError" uni)
        this.excClassMake("TypeError" exc)
        def nm:PyVal (this.excClassMake("NameError" exc))
        this.excClassMake("UnboundLocalError" nm)
        this.excClassMake("AttributeError" exc)
        def rt:PyVal (this.excClassMake("RuntimeError" exc))
        this.excClassMake("RecursionError" rt)
        this.excClassMake("NotImplementedError" rt)
        this.excClassMake("StopIteration" exc)
        this.excClassMake("StopAsyncIteration" exc)
        this.excClassMake("AssertionError" exc)
        def imp:PyVal (this.excClassMake("ImportError" exc))
        this.excClassMake("ModuleNotFoundError" imp)
        def os:PyVal (this.excClassMake("OSError" exc))
        set ip.builtins "IOError" os
        set ip.builtins "EnvironmentError" os
        this.excClassMake("FileNotFoundError" os)
        this.excClassMake("FileExistsError" os)
        this.excClassMake("IsADirectoryError" os)
        this.excClassMake("NotADirectoryError" os)
        this.excClassMake("PermissionError" os)
        this.excClassMake("TimeoutError" os)
        this.excClassMake("SyntaxError" exc)
        this.excClassMake("EOFError" exc)
        this.excClassMake("MemoryError" exc)
        this.excClassMake("BufferError" exc)
        def warn:PyVal (this.excClassMake("Warning" exc))
        this.excClassMake("UserWarning" warn)
        this.excClassMake("DeprecationWarning" warn)
        this.excClassMake("RuntimeWarning" warn)
        this.excClassMake("FutureWarning" warn)
    }

    ; ---- argument helpers

    fn kw@(optional):PyVal (kn:[string] kv:[PyVal] name:string) {
        def none@(optional):PyVal
        for kn k:string i {
            if (k == name) {
                def optr103@(optional):PyVal (itemAt kv i)
                return optr103
            }
        }
        return none
    }

    fn arg:PyVal (args:[PyVal] i:int kn:[string] kv:[PyVal] name:string) {
        if (i < (array_length args)) {
            return (itemAt args i)
        }
        def k@(optional):PyVal (this.kw(kn kv name))
        if (!null? k) {
            return (unwrap k)
        }
        return ip.NONE
    }

    fn hasArg:boolean (args:[PyVal] i:int kn:[string] kv:[PyVal] name:string) {
        if (i < (array_length args)) {
            return true
        }
        def k@(optional):PyVal (this.kw(kn kv name))
        return (!null? k)
    }

    fn need:void (fname:string args:[PyVal] lo:int hi:int) {
        def n:int (array_length args)
        if ((n < lo) || ((hi >= 0) && (n > hi))) {
            if (lo == hi) {
                ip.raise("TypeError" (fname + "() takes exactly " + (to_string lo) + " argument" + (ip.plural(lo)) + " (" + (to_string n) + " given)"))
            }
            if (n < lo) {
                ip.raise("TypeError" (fname + "() expected at least " + (to_string lo) + " argument" + (ip.plural(lo)) + ", got " + (to_string n)))
            }
            ip.raise("TypeError" (fname + "() expected at most " + (to_string hi) + " argument" + (ip.plural(hi)) + ", got " + (to_string n)))
        }
    }

    fn noKw:void (fname:string kn:[string]) {
        if ((array_length kn) > 0) {
            ip.raise("TypeError" (fname + "() takes no keyword arguments"))
        }
    }

    fn toInt:int (v:PyVal what:string) {
        if (ip.isIntLike(v)) {
            return v.i
        }
        def ix@(optional):PyVal (ip.findMethod(v "__index__"))
        if (!null? ix) {
            def r:PyVal (ip.callMethodVal((unwrap ix) v ([] _:PyVal ())))
            return r.i
        }
        ip.raise("TypeError" ("'" + (ip.typeName(v)) + "' object cannot be interpreted as an integer"))
        return 0
    }

    fn toNum:double (v:PyVal) {
        if (ip.isNum(v)) {
            return (ip.toDouble(v))
        }
        def fl@(optional):PyVal (ip.findMethod(v "__float__"))
        if (!null? fl) {
            def r:PyVal (ip.callMethodVal((unwrap fl) v ([] _:PyVal ())))
            return (ip.toDouble(r))
        }
        ip.raise("TypeError" ("must be real number, not " + (ip.typeName(v))))
        return 0.0
    }

    ; complex(), complex(x), complex(re, im), complex("1+2j")
    fn makeComplex:PyVal (args:[PyVal] kn:[string] kv:[PyVal]) {
        def rv:PyVal (this.arg(args 0 kn kv "real"))
        def iv:PyVal (this.arg(args 1 kn kv "imag"))
        def hasIm:boolean (((array_length args) > 1) || ((this.kwIndex(kn "imag")) >= 0))
        if (rv.t == PyT.Str) {
            if hasIm {
                ip.raise("TypeError" "complex() can't take second arg if first is a string")
            }
            return (this.parseComplexText(rv.s))
        }
        if (hasIm && (iv.t == PyT.Str)) {
            ip.raise("TypeError" "complex() second arg can't be a string")
        }
        def a:PyVal (this.complexOf(rv "first"))
        if (hasIm == false) {
            return a
        }
        def b:PyVal (this.complexOf(iv "second"))
        ; re + im * 1j, as CPython adds the parts
        def re:double a.d
        def im:double b.d
        if (iv.t == PyT.Complex) {
            re = re - b.d2
        }
        if (rv.t == PyT.Complex) {
            im = im + a.d2
        }
        return (ip.mkComplex(re im))
    }

    fn kwIndex:int (kn:[string] name:string) {
        for kn k:string i {
            if (k == name) {
                return i
            }
        }
        return -1
    }

    fn complexOf:PyVal (v:PyVal which:string) {
        if (v.t == PyT.Complex) {
            return v
        }
        if (v.t == PyT.None) {
            return (ip.mkComplex(0.0 0.0))
        }
        if (ip.isNum(v)) {
            return (ip.mkComplex((ip.toDouble(v)) 0.0))
        }
        def cm@(optional):PyVal (ip.findMethod(v "__complex__"))
        if (!null? cm) {
            def r:PyVal (ip.callMethodVal((unwrap cm) v ([] _:PyVal ())))
            if (r.t != PyT.Complex) {
                ip.raise("TypeError" ("__complex__ returned non-complex (type " + (ip.typeName(r)) + ")"))
            }
            return r
        }
        def fm@(optional):PyVal (ip.findMethod(v "__float__"))
        if (!null? fm) {
            return (ip.mkComplex((this.toNum(v)) 0.0))
        }
        def im@(optional):PyVal (ip.findMethod(v "__index__"))
        if (!null? im) {
            def r2:PyVal (ip.callMethodVal((unwrap im) v ([] _:PyVal ())))
            return (ip.mkComplex((ip.toDouble(r2)) 0.0))
        }
        ip.raise("TypeError" ("complex() " + which + " argument must be a string or a number, not '" + (ip.typeName(v)) + "'"))
        return v
    }

    fn parseComplexText:PyVal (text:string) {
        def s:string (trim text)
        def bad:string ("complex() arg is a malformed string")
        if ((startsWith s "(") && (endsWith s ")")) {
            s = (trim (substring s 1 ((strlen s) - 1)))
        }
        def n:int (strlen s)
        if (n == 0) {
            ip.raise("ValueError" bad)
        }
        def last:string (to_lowercase (substring s (n - 1) n))
        if (last != "j") {
            if ((indexOf s " ") >= 0) {
                ip.raise("ValueError" bad)
            }
            return (ip.mkComplex((this.complexPart(s bad)) 0.0))
        }
        def body:string (substring s 0 (n - 1))
        ; the sign that starts the imaginary part: not the first character,
        ; not after an exponent's e
        def cs:[int] (to_chars body)
        def split:int -1
        def k:int ((array_length cs) - 1)
        while (k > 0) {
            def c:int (itemAt cs k)
            if ((c == 43) || (c == 45)) {
                def pc:int (itemAt cs (k - 1))
                if ((pc != 101) && (pc != 69)) {
                    split = k
                    break
                }
            }
            k = k - 1
        }
        def reText:string ""
        def imText:string body
        if (split > 0) {
            reText = (substring body 0 split)
            imText = (substring body split (strlen body))
        }
        if (((indexOf reText " ") >= 0) || ((indexOf imText " ") >= 0)) {
            ip.raise("ValueError" bad)
        }
        def im:double 1.0
        if ((imText == "+") || (imText == "")) {
            im = 1.0
        } {
            if (imText == "-") {
                im = -1.0
            } {
                im = (this.complexPart(imText bad))
            }
        }
        def re:double 0.0
        if ((strlen reText) > 0) {
            re = (this.complexPart(reText bad))
        }
        return (ip.mkComplex(re im))
    }

    fn complexPart:double (t:string bad:string) {
        def r:double 0.0
        def failed:boolean false
        try {
            r = (this.parseFloatText(t))
        } {
            failed = true
            ip.takeException((error_msg))
        }
        if failed {
            ip.raise("ValueError" bad)
        }
        return r
    }

    fn call0:PyVal (f:PyVal args:[PyVal]) {
        def kn:[string]
        def kv:[PyVal]
        return (ip.callValue(f args kn kv))
    }

    ; ---- sorting (stable merge sort, Python's order)

    fn sortVals:[PyVal] (vals:[PyVal] keyf:PyVal reverse:boolean) {
        def n:int (array_length vals)
        def keys:[PyVal]
        if (keyf.t == PyT.None) {
            keys = vals
        } {
            for vals v:PyVal i {
                push keys (this.call0(keyf ([] _:PyVal (v))))
            }
        }
        def idx:[int]
        def i:int 0
        while (i < n) {
            push idx i
            i = i + 1
        }
        def sorted:[int] (this.mergeSort(idx keys reverse))
        def out:[PyVal]
        for sorted k:int j {
            push out (itemAt vals k)
        }
        return out
    }

    fn mergeSort:[int] (idx:[int] keys:[PyVal] reverse:boolean) {
        def n:int (array_length idx)
        if (n <= 1) {
            return idx
        }
        def mid:int (idiv n 2)
        def left:[int]
        def right:[int]
        def i:int 0
        while (i < n) {
            if (i < mid) {
                push left (itemAt idx i)
            } {
                push right (itemAt idx i)
            }
            i = i + 1
        }
        def l:[int] (this.mergeSort(left keys reverse))
        def r:[int] (this.mergeSort(right keys reverse))
        def out:[int]
        def a:int 0
        def b:int 0
        def nl:int (array_length l)
        def nr:int (array_length r)
        while ((a < nl) && (b < nr)) {
            def ka:PyVal (itemAt keys (itemAt l a))
            def kb:PyVal (itemAt keys (itemAt r b))
            def takeRight:boolean false
            if reverse {
                takeRight = (ip.less(ka kb))
            } {
                takeRight = (ip.less(kb ka))
            }
            if takeRight {
                push out (itemAt r b)
                b = b + 1
            } {
                push out (itemAt l a)
                a = a + 1
            }
        }
        while (a < nl) {
            push out (itemAt l a)
            a = a + 1
        }
        while (b < nr) {
            push out (itemAt r b)
            b = b + 1
        }
        return out
    }

    ; ---- conversions

    fn parseIntText:PyVal (text:string base0:int) {
        def s:string (trim text)
        def cs:[int] (to_chars s)
        def n:int (array_length cs)
        def i:int 0
        def neg:boolean false
        if ((i < n) && (((itemAt cs i) == 43) || ((itemAt cs i) == 45))) {
            neg = ((itemAt cs i) == 45)
            i = i + 1
        }
        def base:int base0
        if ((i + 1) < n) {
            def c0:int (itemAt cs i)
            def c1:int (itemAt cs (i + 1))
            if (c0 == 48) {
                if (((c1 == 120) || (c1 == 88)) && ((base == 16) || (base == 0))) {
                    base = 16
                    i = i + 2
                } {
                    if (((c1 == 111) || (c1 == 79)) && ((base == 8) || (base == 0))) {
                        base = 8
                        i = i + 2
                    } {
                        if (((c1 == 98) || (c1 == 66)) && ((base == 2) || (base == 0))) {
                            base = 2
                            i = i + 2
                        }
                    }
                }
            }
        }
        if (base == 0) {
            base = 10
        }
        def v:int 0
        def any:boolean false
        def lastUnder:boolean true
        while (i < n) {
            def c:int (itemAt cs i)
            if (c == 95) {
                if lastUnder {
                    any = false
                    break
                }
                lastUnder = true
                i = i + 1
                continue
            }
            def d:int (PyLexer.digitValue(c))
            if ((c >= 103) && (c <= 122)) {
                d = (c - 87)
            }
            if ((c >= 71) && (c <= 90)) {
                d = (c - 55)
            }
            if ((d < 0) || (d >= base)) {
                any = false
                break
            }
            v = (v * base) + d
            any = true
            lastUnder = false
            i = i + 1
        }
        if ((any == false) || lastUnder) {
            ip.raise("ValueError" ("invalid literal for int() with base " + (to_string base0) + ": " + (PyFormat.strRepr(text))))
        }
        if neg {
            v = (0 - v)
        }
        return (ip.mkInt(v))
    }

    fn parseFloatText:double (text:string) {
        def s:string (to_lowercase (trim text))
        def t:string (replace s "_" "")
        if ((t == "inf") || (t == "+inf") || (t == "infinity") || (t == "+infinity")) {
            return (py_inf)
        }
        if ((t == "-inf") || (t == "-infinity")) {
            return (0.0 - (py_inf))
        }
        if ((t == "nan") || (t == "+nan") || (t == "-nan")) {
            return (py_nan)
        }
        ; [sign] digits [. digits] [e [sign] digits]
        def cs:[int] (to_chars t)
        def n:int (array_length cs)
        def i:int 0
        if ((i < n) && (((itemAt cs i) == 43) || ((itemAt cs i) == 45))) {
            i = i + 1
        }
        def digits:int 0
        while ((i < n) && (PyLexer.isDigit((itemAt cs i)))) {
            i = i + 1
            digits = digits + 1
        }
        if ((i < n) && ((itemAt cs i) == 46)) {
            i = i + 1
            while ((i < n) && (PyLexer.isDigit((itemAt cs i)))) {
                i = i + 1
                digits = digits + 1
            }
        }
        def ok:boolean (digits > 0)
        if (ok && (i < n) && ((itemAt cs i) == 101)) {
            i = i + 1
            if ((i < n) && (((itemAt cs i) == 43) || ((itemAt cs i) == 45))) {
                i = i + 1
            }
            def ed:int 0
            while ((i < n) && (PyLexer.isDigit((itemAt cs i)))) {
                i = i + 1
                ed = ed + 1
            }
            if (ed == 0) {
                ok = false
            }
        }
        if ((ok == false) || (i != n) || ((strlen (replace s "__" "")) != (strlen s))) {
            ip.raise("ValueError" ("could not convert string to float: " + (PyFormat.strRepr(text))))
        }
        return (py_parse_float t)
    }

    fn toIntValue:PyVal (v:PyVal) {
        if (ip.isIntLike(v)) {
            return (ip.mkInt(v.i))
        }
        if (v.t == PyT.Float) {
            if (py_isnan v.d) {
                ip.raise("ValueError" "cannot convert float NaN to integer")
            }
            if (py_isinf v.d) {
                ip.raise("OverflowError" "cannot convert float infinity to integer")
            }
            return (ip.mkInt((py_trunc v.d)))
        }
        if (v.t == PyT.Str) {
            return (this.parseIntText(v.s 10))
        }
        def m@(optional):PyVal (ip.findMethod(v "__int__"))
        if (!null? m) {
            return (ip.callMethodVal((unwrap m) v ([] _:PyVal ())))
        }
        def m2@(optional):PyVal (ip.findMethod(v "__index__"))
        if (!null? m2) {
            return (ip.callMethodVal((unwrap m2) v ([] _:PyVal ())))
        }
        ip.raise("TypeError" ("int() argument must be a string, a bytes-like object or a real number, not '" + (ip.typeName(v)) + "'"))
        return ip.NONE
    }

    fn roundValue:PyVal (x:PyVal nd:PyVal) {
        if (ip.isIntLike(x)) {
            if (nd.t == PyT.None) {
                return (ip.mkInt(x.i))
            }
            def k:int (this.toInt(nd "round"))
            if (k >= 0) {
                return (ip.mkInt(x.i))
            }
            def q:int (ip.intPow(10 (0 - k))).i
            def a:int x.i
            def fl:int (PyFormat.floorDivInt(a q))
            def rem:int (a - (fl * q))
            def twice:int (rem * 2)
            if ((twice > q) || ((twice == q) && ((PyFormat.floorModInt(fl 2)) == 1))) {
                fl = fl + 1
            }
            return (ip.mkInt((fl * q)))
        }
        if (x.t == PyT.Inst) {
            def m@(optional):PyVal (ip.findMethod(x "__round__"))
            if (!null? m) {
                if (nd.t == PyT.None) {
                    return (ip.callMethodVal((unwrap m) x ([] _:PyVal ())))
                }
                return (ip.callMethodVal((unwrap m) x ([] _:PyVal (nd))))
            }
        }
        def d:double (this.toNum(x))
        if (nd.t == PyT.None) {
            if (py_isnan d) {
                ip.raise("ValueError" "cannot convert float NaN to integer")
            }
            if (py_isinf d) {
                ip.raise("OverflowError" "cannot convert float infinity to integer")
            }
            def neg:boolean (d < 0.0)
            def a2:double d
            if neg {
                a2 = (0.0 - d)
            }
            def r:double (PyFormat.scaledRound(a2 0))
            if (r < 0.0) {
                r = a2
            }
            if neg {
                r = (r * -1.0)
            }
            return (ip.mkInt((py_trunc r)))
        }
        def k2:int (this.toInt(nd "round"))
        if ((py_isnan d) || (py_isinf d)) {
            return (ip.mkFloat(d))
        }
        if (k2 > 300) {
            return (ip.mkFloat(d))
        }
        def neg2:boolean ((d < 0.0) || (PyFormat.isNegZero(d)))
        def a3:double d
        if (d < 0.0) {
            a3 = (0.0 - d)
        }
        def r2:double 0.0
        if (k2 >= 0) {
            def txt:string (PyFormat.fixedAbs(a3 k2))
            r2 = (py_parse_float txt)
        } {
            def sc:double (PyFormat.scaledRound(a3 k2))
            if (sc < 0.0) {
                r2 = a3
            } {
                r2 = (sc * (PyFormat.pow10((0 - k2))))
            }
        }
        if neg2 {
            r2 = (r2 * -1.0)
        }
        return (ip.mkFloat(r2))
    }

    fn sumValues:PyVal (vals:[PyVal] start:PyVal) {
        def allFloat:boolean true
        def anyFloat:boolean (start.t == PyT.Float)
        if (((ip.isNum(start)) == false)) {
            allFloat = false
        }
        for vals v:PyVal i {
            if ((ip.isNum(v)) == false) {
                allFloat = false
            }
            if (v.t == PyT.Float) {
                anyFloat = true
            }
        }
        if (allFloat && anyFloat) {
            ; Neumaier's compensated sum, as CPython 3.12+ does for floats
            def s:double (ip.toDouble(start))
            def comp:double 0.0
            for vals v2:PyVal j {
                def x:double (ip.toDouble(v2))
                def t:double (s + x)
                def as:double s
                if (as < 0.0) {
                    as = (0.0 - as)
                }
                def ax:double x
                if (ax < 0.0) {
                    ax = (0.0 - ax)
                }
                if (as >= ax) {
                    comp = comp + ((s - t) + x)
                } {
                    comp = comp + ((x - t) + s)
                }
                s = t
            }
            return (ip.mkFloat((s + comp)))
        }
        if (start.t == PyT.Str) {
            ip.raise("TypeError" "sum() can't sum strings [use ''.join(seq) instead]")
        }
        def acc:PyVal start
        for vals v3:PyVal k {
            acc = (ip.binop("+" acc v3))
        }
        return acc
    }

    fn minMax:PyVal (fname:string args:[PyVal] kn:[string] kv:[PyVal] wantMax:boolean) {
        def vals:[PyVal]
        if ((array_length args) == 1) {
            vals = (ip.iterValues((itemAt args 0)))
        } {
            vals = args
        }
        def keyf:PyVal ip.NONE
        def kf@(optional):PyVal (this.kw(kn kv "key"))
        if (!null? kf) {
            keyf = (unwrap kf)
        }
        if ((array_length vals) == 0) {
            def dflt@(optional):PyVal (this.kw(kn kv "default"))
            if (!null? dflt) {
